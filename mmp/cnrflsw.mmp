$( <MM> <PROOF_ASST> THEOREM=cnrflsw  LOC_AFTER=?

h1::cnrflsw.a  |- ( ph -> A e. CC )
h2::cnrflsw.b  |- ( ph -> B e. CC )
h3::cnrflsw.z  |- ( ph -> Z e. CC )
h4::cnrflsw.n  |- ( ph -> B =/= A )
h5::cnrflsw.d  |- D = ( ( B - A ) / ( * ` ( B - A ) ) )
h6::cnrflsw.e  |- E = ( ( A - B ) / ( * ` ( A - B ) ) )

cU:2,1:subcld  |- ( ph -> ( B - A ) e. CC )
nU:2,1,4:subne0d  |- ( ph -> ( B - A ) =/= 0 )
cCU:cU:cjcld  |- ( ph -> ( * ` ( B - A ) ) e. CC )
nCU:cU,nU:cjne0d  |- ( ph -> ( * ` ( B - A ) ) =/= 0 )
dD:5:a1i  |- ( ph -> D = ( ( B - A ) / ( * ` ( B - A ) ) ) )
dE:6:a1i  |- ( ph -> E = ( ( A - B ) / ( * ` ( A - B ) ) ) )
cQ:cU,cCU,nCU:divcld  |- ( ph -> ( ( B - A ) / ( * ` ( B - A ) ) ) e. CC )
cD:dD,cQ:eqeltrd  |- ( ph -> D e. CC )

$( the two reflection coefficients agree: E = D $)
s1a:2,1:negsubdi2d  |- ( ph -> -u ( B - A ) = ( A - B ) )
s1:s1a:eqcomd  |- ( ph -> ( A - B ) = -u ( B - A ) )
s2:s1:fveq2d  |- ( ph -> ( * ` ( A - B ) ) = ( * ` -u ( B - A ) ) )
s3:cU:cjnegd  |- ( ph -> ( * ` -u ( B - A ) ) = -u ( * ` ( B - A ) ) )
s4:s2,s3:eqtrd  |- ( ph -> ( * ` ( A - B ) ) = -u ( * ` ( B - A ) ) )
s5:s1,s4:oveq12d  |- ( ph -> ( ( A - B ) / ( * ` ( A - B ) ) ) = ( -u ( B - A ) / -u ( * ` ( B - A ) ) ) )
s6:cU,cCU,nCU:div2negd  |- ( ph -> ( -u ( B - A ) / -u ( * ` ( B - A ) ) ) = ( ( B - A ) / ( * ` ( B - A ) ) ) )
s7:dE,s5,s6:3eqtrd  |- ( ph -> E = ( ( B - A ) / ( * ` ( B - A ) ) ) )
dDc:dD:eqcomd  |- ( ph -> ( ( B - A ) / ( * ` ( B - A ) ) ) = D )
eED:s7,dDc:eqtrd  |- ( ph -> E = D )

$( closures for the two conjugated differences $)
cZB:3,2:subcld  |- ( ph -> ( Z - B ) e. CC )
cCZB:cZB:cjcld  |- ( ph -> ( * ` ( Z - B ) ) e. CC )
cZA:3,1:subcld  |- ( ph -> ( Z - A ) e. CC )
cCZA:cZA:cjcld  |- ( ph -> ( * ` ( Z - A ) ) e. CC )
cW:cD,cCZB:mulcld  |- ( ph -> ( D x. ( * ` ( Z - B ) ) ) e. CC )

$( ( Z - A ) splits through B $)
k1:3,2,1:npncand  |- ( ph -> ( ( Z - B ) + ( B - A ) ) = ( Z - A ) )
k2:k1:eqcomd  |- ( ph -> ( Z - A ) = ( ( Z - B ) + ( B - A ) ) )
k3:k2:fveq2d  |- ( ph -> ( * ` ( Z - A ) ) = ( * ` ( ( Z - B ) + ( B - A ) ) ) )
k4:cZB,cU:cjaddd  |- ( ph -> ( * ` ( ( Z - B ) + ( B - A ) ) ) = ( ( * ` ( Z - B ) ) + ( * ` ( B - A ) ) ) )
k5:k3,k4:eqtrd  |- ( ph -> ( * ` ( Z - A ) ) = ( ( * ` ( Z - B ) ) + ( * ` ( B - A ) ) ) )

$( D x. ( * ` ( B - A ) ) = ( B - A ) $)
m1:cU,cCU,nCU:divcan1d  |- ( ph -> ( ( ( B - A ) / ( * ` ( B - A ) ) ) x. ( * ` ( B - A ) ) ) = ( B - A ) )
m2:dD:oveq1d  |- ( ph -> ( D x. ( * ` ( B - A ) ) ) = ( ( ( B - A ) / ( * ` ( B - A ) ) ) x. ( * ` ( B - A ) ) ) )
m3:m2,m1:eqtrd  |- ( ph -> ( D x. ( * ` ( B - A ) ) ) = ( B - A ) )

$( expand the right-hand side $)
r1:k5:oveq2d  |- ( ph -> ( D x. ( * ` ( Z - A ) ) ) = ( D x. ( ( * ` ( Z - B ) ) + ( * ` ( B - A ) ) ) ) )
r2:cD,cCZB,cCU:adddid  |- ( ph -> ( D x. ( ( * ` ( Z - B ) ) + ( * ` ( B - A ) ) ) ) = ( ( D x. ( * ` ( Z - B ) ) ) + ( D x. ( * ` ( B - A ) ) ) ) )
r3:m3:oveq2d  |- ( ph -> ( ( D x. ( * ` ( Z - B ) ) ) + ( D x. ( * ` ( B - A ) ) ) ) = ( ( D x. ( * ` ( Z - B ) ) ) + ( B - A ) ) )
r4:r1,r2,r3:3eqtrd  |- ( ph -> ( D x. ( * ` ( Z - A ) ) ) = ( ( D x. ( * ` ( Z - B ) ) ) + ( B - A ) ) )
r5:r4:oveq2d  |- ( ph -> ( A + ( D x. ( * ` ( Z - A ) ) ) ) = ( A + ( ( D x. ( * ` ( Z - B ) ) ) + ( B - A ) ) ) )

$( and rearrange it to the left-hand side $)
g1:1,cW,cU:addassd  |- ( ph -> ( ( A + ( D x. ( * ` ( Z - B ) ) ) ) + ( B - A ) ) = ( A + ( ( D x. ( * ` ( Z - B ) ) ) + ( B - A ) ) ) )
g2:g1:eqcomd  |- ( ph -> ( A + ( ( D x. ( * ` ( Z - B ) ) ) + ( B - A ) ) ) = ( ( A + ( D x. ( * ` ( Z - B ) ) ) ) + ( B - A ) ) )
g3:1,cW,cU:add32d  |- ( ph -> ( ( A + ( D x. ( * ` ( Z - B ) ) ) ) + ( B - A ) ) = ( ( A + ( B - A ) ) + ( D x. ( * ` ( Z - B ) ) ) ) )
g4:1,2:pncan3d  |- ( ph -> ( A + ( B - A ) ) = B )
g5:g4:oveq1d  |- ( ph -> ( ( A + ( B - A ) ) + ( D x. ( * ` ( Z - B ) ) ) ) = ( B + ( D x. ( * ` ( Z - B ) ) ) ) )
g6:r5,g2,g3:3eqtrd  |- ( ph -> ( A + ( D x. ( * ` ( Z - A ) ) ) ) = ( ( A + ( B - A ) ) + ( D x. ( * ` ( Z - B ) ) ) ) )
g7:g6,g5:eqtrd  |- ( ph -> ( A + ( D x. ( * ` ( Z - A ) ) ) ) = ( B + ( D x. ( * ` ( Z - B ) ) ) ) )

$( restore E on the left $)
e1:eED:oveq1d  |- ( ph -> ( E x. ( * ` ( Z - B ) ) ) = ( D x. ( * ` ( Z - B ) ) ) )
e2:e1:oveq2d  |- ( ph -> ( B + ( E x. ( * ` ( Z - B ) ) ) ) = ( B + ( D x. ( * ` ( Z - B ) ) ) ) )
g8:g7:eqcomd  |- ( ph -> ( B + ( D x. ( * ` ( Z - B ) ) ) ) = ( A + ( D x. ( * ` ( Z - A ) ) ) ) )
qed:e2,g8:eqtrd  |- ( ph -> ( B + ( E x. ( * ` ( Z - B ) ) ) ) = ( A + ( D x. ( * ` ( Z - A ) ) ) ) )

$)

ceC:cBC,cJBC,nJBC:divcld  |- ( ph -> ( ( B - C ) / ( * ` ( B - C ) ) ) e. CC )
cJAB:cAB:cjcld  |- ( ph -> ( * ` ( A - B ) ) e. CC )
nJAB:cAB,nAB0:cjne0d  |- ( ph -> ( * ` ( A - B ) ) =/= 0 )
ceB:cAB,cJAB,nJAB:divcld  |- ( ph -> ( ( A - B ) / ( * ` ( A - B ) ) ) e. CC )

$( the first reflection of W , across the line C A , written from C $)
cWC:8,7:subcld  |- ( ph -> ( W - C ) e. CC )
cJWC:cWC:cjcld  |- ( ph -> ( * ` ( W - C ) ) e. CC )

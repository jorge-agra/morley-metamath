$( <MM> <PROOF_ASST> THEOREM=morlemid  LOC_AFTER=?
$( Let ` X ` , ` Y ` , ` Z ` be one third of the angles of the triangle with
   vertices ` A ` , ` B ` , ` C ` . The rotations about ` C ` , ` B ` and ` A `
   by six times these angles, applied in that order, compose to the identity:
   by ~ cnrfl2 each is the composite of two reflections in sides of the
   triangle, and the reflections cancel in pairs. $)

$d A x
$d A y
$d B x
$d B y
$d C x
$d C y
$d x y

h1::morlemid.f  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::morlemid.x  |- X = ( ( ( B - A ) F ( C - A ) ) / 3 )
h3::morlemid.y  |- Y = ( ( ( C - B ) F ( A - B ) ) / 3 )
h4::morlemid.z  |- Z = ( ( ( A - C ) F ( B - C ) ) / 3 )
h5::morlemid.a  |- ( ph -> A e. CC )
h6::morlemid.b  |- ( ph -> B e. CC )
h7::morlemid.c  |- ( ph -> C e. CC )
h8::morlemid.w  |- ( ph -> W e. CC )
h9::morlemid.ab  |- ( ph -> A =/= B )
h10::morlemid.bc  |- ( ph -> B =/= C )
h11::morlemid.ca  |- ( ph -> C =/= A )

nBA:9:necomd  |- ( ph -> B =/= A )
nCB:10:necomd  |- ( ph -> C =/= B )
nAC:11:necomd  |- ( ph -> A =/= C )

$( the six reflection coefficients, as identities $)
dA::eqid  |- ( ( B - A ) / ( * ` ( B - A ) ) ) = ( ( B - A ) / ( * ` ( B - A ) ) )
eA::eqid  |- ( ( C - A ) / ( * ` ( C - A ) ) ) = ( ( C - A ) / ( * ` ( C - A ) ) )
dB::eqid  |- ( ( C - B ) / ( * ` ( C - B ) ) ) = ( ( C - B ) / ( * ` ( C - B ) ) )
eB::eqid  |- ( ( A - B ) / ( * ` ( A - B ) ) ) = ( ( A - B ) / ( * ` ( A - B ) ) )
dC::eqid  |- ( ( A - C ) / ( * ` ( A - C ) ) ) = ( ( A - C ) / ( * ` ( A - C ) ) )
eC::eqid  |- ( ( B - C ) / ( * ` ( B - C ) ) ) = ( ( B - C ) / ( * ` ( B - C ) ) )

$( closures of the six differences $)
cBA:6,5:subcld  |- ( ph -> ( B - A ) e. CC )
nBA0:6,5,nBA:subne0d  |- ( ph -> ( B - A ) =/= 0 )
cCA:7,5:subcld  |- ( ph -> ( C - A ) e. CC )
nCA0:7,5,11:subne0d  |- ( ph -> ( C - A ) =/= 0 )
cCB:7,6:subcld  |- ( ph -> ( C - B ) e. CC )
nCB0:7,6,nCB:subne0d  |- ( ph -> ( C - B ) =/= 0 )
cAB:5,6:subcld  |- ( ph -> ( A - B ) e. CC )
nAB0:5,6,9:subne0d  |- ( ph -> ( A - B ) =/= 0 )
cAC:5,7:subcld  |- ( ph -> ( A - C ) e. CC )
nAC0:5,7,nAC:subne0d  |- ( ph -> ( A - C ) =/= 0 )
cBC:6,7:subcld  |- ( ph -> ( B - C ) e. CC )
nBC0:6,7,10:subne0d  |- ( ph -> ( B - C ) =/= 0 )

$( closures of the coefficients this proof composes $)
cJAC:cAC:cjcld  |- ( ph -> ( * ` ( A - C ) ) e. CC )
nJAC:cAC,nAC0:cjne0d  |- ( ph -> ( * ` ( A - C ) ) =/= 0 )
ccC:cAC,cJAC,nJAC:divcld  |- ( ph -> ( ( A - C ) / ( * ` ( A - C ) ) ) e. CC )
cJBC:cBC:cjcld  |- ( ph -> ( * ` ( B - C ) ) e. CC )

$d x y

h1::sinang.1  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )

d1::simpll  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> A e. CC )
d2::simplr  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> A =/= 0 )
d3::simprl  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> B e. CC )
d4::simprr  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> B =/= 0 )
d5:1,d1,d2,d3,d4:angvald  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( A F B ) = ( Im ` ( log ` ( B / A ) ) ) )
d6:d5:fveq2d  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( sin ` ( A F B ) ) = ( sin ` ( Im ` ( log ` ( B / A ) ) ) ) )
d7:d3,d1,d2:divcld  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B / A ) e. CC )
d8:d3,d1,d4,d2:divne0d  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B / A ) =/= 0 )
d9::sinarg  |- ( ( ( B / A ) e. CC /\ ( B / A ) =/= 0 ) -> ( sin ` ( Im ` ( log ` ( B / A ) ) ) ) = ( Im ` ( ( B / A ) / ( abs ` ( B / A ) ) ) ) )
d10:d7,d8,d9:syl2anc  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( sin ` ( Im ` ( log ` ( B / A ) ) ) ) = ( Im ` ( ( B / A ) / ( abs ` ( B / A ) ) ) ) )
qed:d6,d10:eqtrd  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( sin ` ( A F B ) ) = ( Im ` ( ( B / A ) / ( abs ` ( B / A ) ) ) ) )

$)

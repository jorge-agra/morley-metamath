$( <MM> <PROOF_ASST> THEOREM=morlemrad  LOC_AFTER=?

$d A x
$d A y
$d B x
$d B y
$d C x
$d C y
$d x y

h1::morlemrad.f  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::morlemrad.a  |- ( ph -> A e. CC )
h3::morlemrad.b  |- ( ph -> B e. CC )
h4::morlemrad.c  |- ( ph -> C e. CC )
h5::morlemrad.ab  |- ( ph -> A =/= B )
h6::morlemrad.bc  |- ( ph -> B =/= C )
h7::morlemrad.ca  |- ( ph -> C =/= A )
h8::morlemrad.x  |- X = ( ( ( B - A ) F ( C - A ) ) / 3 )
h9::morlemrad.y  |- Y = ( ( ( C - B ) F ( A - B ) ) / 3 )
h10::morlemrad.o  |- ( ph -> ( ( B - A ) F ( C - A ) ) e. ( 0 (,) _pi ) )
h11::morlemrad.s  |- ( ph -> S e. RR )
h12::morlemrad.1  |- ( ph -> ( abs ` ( B - C ) ) = ( 2 x. ( S x. ( sin ` ( 3 x. X ) ) ) ) )

$( numeric closures $)
c3ri::3re  |- 3 e. RR
c3r:c3ri:a1i  |- ( ph -> 3 e. RR )
c3ci::3cn  |- 3 e. CC
c3c:c3ci:a1i  |- ( ph -> 3 e. CC )
c3ni::3ne0  |- 3 =/= 0
c3n:c3ni:a1i  |- ( ph -> 3 =/= 0 )
c2ci::2cn  |- 2 e. CC
c2c:c2ci:a1i  |- ( ph -> 2 e. CC )
sc:11:recnd  |- ( ph -> S e. CC )

$( the angles $)
q1:1,2,3,4,5,6,7,10:ang180pos  |- ( ph -> ( ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) /\ ( ( A - C ) F ( B - C ) ) e. ( 0 (,) _pi ) /\ ( ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) + ( ( B - A ) F ( C - A ) ) ) = _pi ) )
gbi:q1:simp1d  |- ( ph -> ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) )
elior::elioore  |- ( ( ( B - A ) F ( C - A ) ) e. ( 0 (,) _pi ) -> ( ( B - A ) F ( C - A ) ) e. RR )
eliob::elioore  |- ( ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) -> ( ( C - B ) F ( A - B ) ) e. RR )
gar:10,elior:syl  |- ( ph -> ( ( B - A ) F ( C - A ) ) e. RR )
gbr:gbi,eliob:syl  |- ( ph -> ( ( C - B ) F ( A - B ) ) e. RR )
garc:gar:recnd  |- ( ph -> ( ( B - A ) F ( C - A ) ) e. CC )
gbrc:gbr:recnd  |- ( ph -> ( ( C - B ) F ( A - B ) ) e. CC )
xh:8:a1i  |- ( ph -> X = ( ( ( B - A ) F ( C - A ) ) / 3 ) )
yh:9:a1i  |- ( ph -> Y = ( ( ( C - B ) F ( A - B ) ) / 3 ) )
x3a:xh:oveq2d  |- ( ph -> ( 3 x. X ) = ( 3 x. ( ( ( B - A ) F ( C - A ) ) / 3 ) ) )
x3b:garc,c3c,c3n:divcan2d  |- ( ph -> ( 3 x. ( ( ( B - A ) F ( C - A ) ) / 3 ) ) = ( ( B - A ) F ( C - A ) ) )
x3:x3a,x3b:eqtrd  |- ( ph -> ( 3 x. X ) = ( ( B - A ) F ( C - A ) ) )
y3a:yh:oveq2d  |- ( ph -> ( 3 x. Y ) = ( 3 x. ( ( ( C - B ) F ( A - B ) ) / 3 ) ) )
y3b:gbrc,c3c,c3n:divcan2d  |- ( ph -> ( 3 x. ( ( ( C - B ) F ( A - B ) ) / 3 ) ) = ( ( C - B ) F ( A - B ) ) )
y3:y3a,y3b:eqtrd  |- ( ph -> ( 3 x. Y ) = ( ( C - B ) F ( A - B ) ) )
x3r:x3,gar:eqeltrd  |- ( ph -> ( 3 x. X ) e. RR )
y3r:y3,gbr:eqeltrd  |- ( ph -> ( 3 x. Y ) e. RR )
x3c:x3r:recnd  |- ( ph -> ( 3 x. X ) e. CC )
y3c:y3r:recnd  |- ( ph -> ( 3 x. Y ) e. CC )

$( the sine of the angle at A is positive $)
x3io:x3,10:eqeltrd  |- ( ph -> ( 3 x. X ) e. ( 0 (,) _pi ) )
sx1a::sinq12gt0  |- ( ( 3 x. X ) e. ( 0 (,) _pi ) -> 0 < ( sin ` ( 3 x. X ) ) )
sx1:x3io,sx1a:syl  |- ( ph -> 0 < ( sin ` ( 3 x. X ) ) )
sxra::resincl  |- ( ( 3 x. X ) e. RR -> ( sin ` ( 3 x. X ) ) e. RR )
sxr:x3r,sxra:syl  |- ( ph -> ( sin ` ( 3 x. X ) ) e. RR )
sxc:sxr:recnd  |- ( ph -> ( sin ` ( 3 x. X ) ) e. CC )
sxn:sx1:gt0ne0d  |- ( ph -> ( sin ` ( 3 x. X ) ) =/= 0 )
syc:y3c:sincld  |- ( ph -> ( sin ` ( 3 x. Y ) ) e. CC )

$( the law of sines in A B C $)
ec1::eqid  |- ( abs ` ( B - C ) ) = ( abs ` ( B - C ) )
ec2::eqid  |- ( abs ` ( A - C ) ) = ( abs ` ( A - C ) )
ec3::eqid  |- ( ( B - A ) F ( C - A ) ) = ( ( B - A ) F ( C - A ) )
ec4::eqid  |- ( ( C - B ) F ( A - B ) ) = ( ( C - B ) F ( A - B ) )
l1s:1,ec1,ec2,ec3,ec4:lawsin  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( abs ` ( B - C ) ) x. ( sin ` ( ( C - B ) F ( A - B ) ) ) ) = ( ( abs ` ( A - C ) ) x. ( sin ` ( ( B - A ) F ( C - A ) ) ) ) )
ac:7:necomd  |- ( ph -> A =/= C )
a1a:2,3,4:3jca  |- ( ph -> ( A e. CC /\ B e. CC /\ C e. CC ) )
a1b:5,ac,6:3jca  |- ( ph -> ( A =/= B /\ A =/= C /\ B =/= C ) )
a1c:a1a,a1b:jca  |- ( ph -> ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) )
l1:a1c,l1s:syl  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` ( ( C - B ) F ( A - B ) ) ) ) = ( ( abs ` ( A - C ) ) x. ( sin ` ( ( B - A ) F ( C - A ) ) ) ) )

$( rewrite the two angles as 3 Y and 3 X $)
m1:y3:fveq2d  |- ( ph -> ( sin ` ( 3 x. Y ) ) = ( sin ` ( ( C - B ) F ( A - B ) ) ) )
m2:x3:fveq2d  |- ( ph -> ( sin ` ( 3 x. X ) ) = ( sin ` ( ( B - A ) F ( C - A ) ) ) )
m3:m1:oveq2d  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` ( 3 x. Y ) ) ) = ( ( abs ` ( B - C ) ) x. ( sin ` ( ( C - B ) F ( A - B ) ) ) ) )
m4:m2:oveq2d  |- ( ph -> ( ( abs ` ( A - C ) ) x. ( sin ` ( 3 x. X ) ) ) = ( ( abs ` ( A - C ) ) x. ( sin ` ( ( B - A ) F ( C - A ) ) ) ) )
m5:m3,l1:eqtrd  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` ( 3 x. Y ) ) ) = ( ( abs ` ( A - C ) ) x. ( sin ` ( ( B - A ) F ( C - A ) ) ) ) )
m6:m5,m4:eqtr4d  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` ( 3 x. Y ) ) ) = ( ( abs ` ( A - C ) ) x. ( sin ` ( 3 x. X ) ) ) )

$( substitute the circumradius form of B C and rearrange $)
n1:12:oveq1d  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` ( 3 x. Y ) ) ) = ( ( 2 x. ( S x. ( sin ` ( 3 x. X ) ) ) ) x. ( sin ` ( 3 x. Y ) ) ) )
ssx:sc,sxc:mulcld  |- ( ph -> ( S x. ( sin ` ( 3 x. X ) ) ) e. CC )
ssy:sc,syc:mulcld  |- ( ph -> ( S x. ( sin ` ( 3 x. Y ) ) ) e. CC )
n2:c2c,ssx,syc:mulassd  |- ( ph -> ( ( 2 x. ( S x. ( sin ` ( 3 x. X ) ) ) ) x. ( sin ` ( 3 x. Y ) ) ) = ( 2 x. ( ( S x. ( sin ` ( 3 x. X ) ) ) x. ( sin ` ( 3 x. Y ) ) ) ) )
n3:sc,sxc,syc:mul32d  |- ( ph -> ( ( S x. ( sin ` ( 3 x. X ) ) ) x. ( sin ` ( 3 x. Y ) ) ) = ( ( S x. ( sin ` ( 3 x. Y ) ) ) x. ( sin ` ( 3 x. X ) ) ) )
n4:n3:oveq2d  |- ( ph -> ( 2 x. ( ( S x. ( sin ` ( 3 x. X ) ) ) x. ( sin ` ( 3 x. Y ) ) ) ) = ( 2 x. ( ( S x. ( sin ` ( 3 x. Y ) ) ) x. ( sin ` ( 3 x. X ) ) ) ) )
n5:c2c,ssy,sxc:mulassd  |- ( ph -> ( ( 2 x. ( S x. ( sin ` ( 3 x. Y ) ) ) ) x. ( sin ` ( 3 x. X ) ) ) = ( 2 x. ( ( S x. ( sin ` ( 3 x. Y ) ) ) x. ( sin ` ( 3 x. X ) ) ) ) )
n6:n2,n4:eqtrd  |- ( ph -> ( ( 2 x. ( S x. ( sin ` ( 3 x. X ) ) ) ) x. ( sin ` ( 3 x. Y ) ) ) = ( 2 x. ( ( S x. ( sin ` ( 3 x. Y ) ) ) x. ( sin ` ( 3 x. X ) ) ) ) )
n7:n6,n5:eqtr4d  |- ( ph -> ( ( 2 x. ( S x. ( sin ` ( 3 x. X ) ) ) ) x. ( sin ` ( 3 x. Y ) ) ) = ( ( 2 x. ( S x. ( sin ` ( 3 x. Y ) ) ) ) x. ( sin ` ( 3 x. X ) ) ) )
n8:n1,n7:eqtrd  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` ( 3 x. Y ) ) ) = ( ( 2 x. ( S x. ( sin ` ( 3 x. Y ) ) ) ) x. ( sin ` ( 3 x. X ) ) ) )
n9:m6,n8:eqtr3d  |- ( ph -> ( ( abs ` ( A - C ) ) x. ( sin ` ( 3 x. X ) ) ) = ( ( 2 x. ( S x. ( sin ` ( 3 x. Y ) ) ) ) x. ( sin ` ( 3 x. X ) ) ) )

$( cancel the common sine $)
acs:2,4:subcld  |- ( ph -> ( A - C ) e. CC )
acr:acs:abscld  |- ( ph -> ( abs ` ( A - C ) ) e. RR )
acc:acr:recnd  |- ( ph -> ( abs ` ( A - C ) ) e. CC )
kc:c2c,ssy:mulcld  |- ( ph -> ( 2 x. ( S x. ( sin ` ( 3 x. Y ) ) ) ) e. CC )
n10:acc,kc,sxc,sxn,n9:mulcan2ad  |- ( ph -> ( abs ` ( A - C ) ) = ( 2 x. ( S x. ( sin ` ( 3 x. Y ) ) ) ) )
n11:2,4:abssubd  |- ( ph -> ( abs ` ( A - C ) ) = ( abs ` ( C - A ) ) )

qed:n11,n10:eqtr3d  |- ( ph -> ( abs ` ( C - A ) ) = ( 2 x. ( S x. ( sin ` ( 3 x. Y ) ) ) ) )

$)

$( <MM> <PROOF_ASST> THEOREM=morlemkb  LOC_AFTER=?

h1::morlemkb.e  |- ( ph -> E e. CC )
h2::morlemkb.d  |- ( ph -> D e. CC )
h3::morlemkb.g  |- ( ph -> G e. CC )
h4::morlemkb.j  |- ( ph -> J = ( ( E x. D ) x. G ) )
h5::morlemkb.c  |- ( ph -> ( J ^ 3 ) = 1 )
h6::morlemkb.n  |- ( ph -> J =/= 1 )

$( closures $)
c1:1:1cnd  |- ( ph -> 1 e. CC )
cED:1,2:mulcld  |- ( ph -> ( E x. D ) e. CC )
cDG:2,3:mulcld  |- ( ph -> ( D x. G ) e. CC )
cGE:3,1:mulcld  |- ( ph -> ( G x. E ) e. CC )
cJa:cED,3:mulcld  |- ( ph -> ( ( E x. D ) x. G ) e. CC )
cJ:4,cJa:eqeltrd  |- ( ph -> J e. CC )
cJ2:cJ:sqcld  |- ( ph -> ( J ^ 2 ) e. CC )
cE2:1:sqcld  |- ( ph -> ( E ^ 2 ) e. CC )
cm:cE2,2:mulcld  |- ( ph -> ( ( E ^ 2 ) x. D ) e. CC )
cd1:c1,cDG:subcld  |- ( ph -> ( 1 - ( D x. G ) ) e. CC )
cd2:c1,cGE:subcld  |- ( ph -> ( 1 - ( G x. E ) ) e. CC )
cd3:c1,cED:subcld  |- ( ph -> ( 1 - ( E x. D ) ) e. CC )
cJ2E:cJ2,1:mulcld  |- ( ph -> ( ( J ^ 2 ) x. E ) e. CC )
cmd2:cm,cd2:mulcld  |- ( ph -> ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) e. CC )
n0a::3nn0  |- 3 e. NN0
n0:n0a:a1i  |- ( ph -> 3 e. NN0 )
cE3:1,n0:expcld  |- ( ph -> ( E ^ 3 ) e. CC )
cD3:2,n0:expcld  |- ( ph -> ( D ^ 3 ) e. CC )

$( the products of the composite coefficient $)
a1:4:eqcomd  |- ( ph -> ( ( E x. D ) x. G ) = J )
a2:1,2,3:mulassd  |- ( ph -> ( ( E x. D ) x. G ) = ( E x. ( D x. G ) ) )
a3:a2:eqcomd  |- ( ph -> ( E x. ( D x. G ) ) = ( ( E x. D ) x. G ) )
pE:a3,a1:eqtrd  |- ( ph -> ( E x. ( D x. G ) ) = J )
a5:2,3,1:mulassd  |- ( ph -> ( ( D x. G ) x. E ) = ( D x. ( G x. E ) ) )
a6:cDG,1:mulcomd  |- ( ph -> ( ( D x. G ) x. E ) = ( E x. ( D x. G ) ) )
a7:a5,a6:eqtr3d  |- ( ph -> ( D x. ( G x. E ) ) = ( E x. ( D x. G ) ) )
pD:a7,pE:eqtrd  |- ( ph -> ( D x. ( G x. E ) ) = J )

$( ( J ^ 2 ) x. J is 1 $)
n2a::2nn0  |- 2 e. NN0
n2:n2a:a1i  |- ( ph -> 2 e. NN0 )
e1:cJ,n2:expp1d  |- ( ph -> ( J ^ ( 2 + 1 ) ) = ( ( J ^ 2 ) x. J ) )
e2a::2p1e3  |- ( 2 + 1 ) = 3
e2b:e2a:oveq2i  |- ( J ^ ( 2 + 1 ) ) = ( J ^ 3 )
e2:e2b:a1i  |- ( ph -> ( J ^ ( 2 + 1 ) ) = ( J ^ 3 ) )
e3:e2,e1:eqtr3d  |- ( ph -> ( J ^ 3 ) = ( ( J ^ 2 ) x. J ) )
e4:e3:eqcomd  |- ( ph -> ( ( J ^ 2 ) x. J ) = ( J ^ 3 ) )
e5:e4,5:eqtrd  |- ( ph -> ( ( J ^ 2 ) x. J ) = 1 )
f1:cJ2,1,cDG:mulassd  |- ( ph -> ( ( ( J ^ 2 ) x. E ) x. ( D x. G ) ) = ( ( J ^ 2 ) x. ( E x. ( D x. G ) ) ) )
f2:pE:oveq2d  |- ( ph -> ( ( J ^ 2 ) x. ( E x. ( D x. G ) ) ) = ( ( J ^ 2 ) x. J ) )
pJ2E:f1,f2,e5:3eqtrd  |- ( ph -> ( ( ( J ^ 2 ) x. E ) x. ( D x. G ) ) = 1 )

$( THE COLLECTION IDENTITY for the B coefficient $)
l1:cd1,cJ2E:mulcomd  |- ( ph -> ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) = ( ( ( J ^ 2 ) x. E ) x. ( 1 - ( D x. G ) ) ) )
l2:cJ2E,cDG,pJ2E:morlemone  |- ( ph -> ( ( ( J ^ 2 ) x. E ) x. ( 1 - ( D x. G ) ) ) = ( ( ( J ^ 2 ) x. E ) - 1 ) )
l3:l1,l2:eqtrd  |- ( ph -> ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) = ( ( ( J ^ 2 ) x. E ) - 1 ) )
l4:l3:oveq2d  |- ( ph -> ( ( 1 - ( E x. D ) ) + ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) ) = ( ( 1 - ( E x. D ) ) + ( ( ( J ^ 2 ) x. E ) - 1 ) ) )
cA1:c1,cED:subcld  |- ( ph -> ( 1 - ( E x. D ) ) e. CC )
cA2:cJ2E,c1:subcld  |- ( ph -> ( ( ( J ^ 2 ) x. E ) - 1 ) e. CC )
l5:cA1,cA2:addcomd  |- ( ph -> ( ( 1 - ( E x. D ) ) + ( ( ( J ^ 2 ) x. E ) - 1 ) ) = ( ( ( ( J ^ 2 ) x. E ) - 1 ) + ( 1 - ( E x. D ) ) ) )
l6:cJ2E,c1,cED:npncand  |- ( ph -> ( ( ( ( J ^ 2 ) x. E ) - 1 ) + ( 1 - ( E x. D ) ) ) = ( ( ( J ^ 2 ) x. E ) - ( E x. D ) ) )
l7:1,cJ2,2:subdid  |- ( ph -> ( E x. ( ( J ^ 2 ) - D ) ) = ( ( E x. ( J ^ 2 ) ) - ( E x. D ) ) )
l8:cJ2,1:mulcomd  |- ( ph -> ( ( J ^ 2 ) x. E ) = ( E x. ( J ^ 2 ) ) )
l9:l8:oveq1d  |- ( ph -> ( ( ( J ^ 2 ) x. E ) - ( E x. D ) ) = ( ( E x. ( J ^ 2 ) ) - ( E x. D ) ) )
l10:l4,l5,l6:3eqtrd  |- ( ph -> ( ( 1 - ( E x. D ) ) + ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) ) = ( ( ( J ^ 2 ) x. E ) - ( E x. D ) ) )
l11:l10,l9:eqtrd  |- ( ph -> ( ( 1 - ( E x. D ) ) + ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) ) = ( ( E x. ( J ^ 2 ) ) - ( E x. D ) ) )
LL:l11,l7:eqtr4d  |- ( ph -> ( ( 1 - ( E x. D ) ) + ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) ) = ( E x. ( ( J ^ 2 ) - D ) ) )

$( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. E is ( E ^ 3 ) x. ( D - J ) $)
cDd2:2,cd2:mulcld  |- ( ph -> ( D x. ( 1 - ( G x. E ) ) ) e. CC )
q1:cE2,2,cd2:mulassd  |- ( ph -> ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) = ( ( E ^ 2 ) x. ( D x. ( 1 - ( G x. E ) ) ) ) )
q2:q1:oveq1d  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. E ) = ( ( ( E ^ 2 ) x. ( D x. ( 1 - ( G x. E ) ) ) ) x. E ) )
q3:cE2,cDd2,1:mul32d  |- ( ph -> ( ( ( E ^ 2 ) x. ( D x. ( 1 - ( G x. E ) ) ) ) x. E ) = ( ( ( E ^ 2 ) x. E ) x. ( D x. ( 1 - ( G x. E ) ) ) ) )
q4:1,n2:expp1d  |- ( ph -> ( E ^ ( 2 + 1 ) ) = ( ( E ^ 2 ) x. E ) )
q5a:e2a:oveq2i  |- ( E ^ ( 2 + 1 ) ) = ( E ^ 3 )
q5:q5a:a1i  |- ( ph -> ( E ^ ( 2 + 1 ) ) = ( E ^ 3 ) )
q6:q5,q4:eqtr3d  |- ( ph -> ( E ^ 3 ) = ( ( E ^ 2 ) x. E ) )
q7:q6:eqcomd  |- ( ph -> ( ( E ^ 2 ) x. E ) = ( E ^ 3 ) )
q8:2,cGE,pD:morlemone  |- ( ph -> ( D x. ( 1 - ( G x. E ) ) ) = ( D - J ) )
q9:q7,q8:oveq12d  |- ( ph -> ( ( ( E ^ 2 ) x. E ) x. ( D x. ( 1 - ( G x. E ) ) ) ) = ( ( E ^ 3 ) x. ( D - J ) ) )
q10:q2,q3,q9:3eqtrd  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. E ) = ( ( E ^ 3 ) x. ( D - J ) ) )

$( assemble $)
cJ2mD:cJ2,2:subcld  |- ( ph -> ( ( J ^ 2 ) - D ) e. CC )
cDmJ:2,cJ:subcld  |- ( ph -> ( D - J ) e. CC )
r1:LL:oveq2d  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. ( ( 1 - ( E x. D ) ) + ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) ) ) = ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. ( E x. ( ( J ^ 2 ) - D ) ) ) )
r2:cmd2,1,cJ2mD:mulassd  |- ( ph -> ( ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. E ) x. ( ( J ^ 2 ) - D ) ) = ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. ( E x. ( ( J ^ 2 ) - D ) ) ) )
r3:q10:oveq1d  |- ( ph -> ( ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. E ) x. ( ( J ^ 2 ) - D ) ) = ( ( ( E ^ 3 ) x. ( D - J ) ) x. ( ( J ^ 2 ) - D ) ) )
r4:r2,r3:eqtr3d  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. ( E x. ( ( J ^ 2 ) - D ) ) ) = ( ( ( E ^ 3 ) x. ( D - J ) ) x. ( ( J ^ 2 ) - D ) ) )
r5:cE3,cDmJ,cJ2mD:mulassd  |- ( ph -> ( ( ( E ^ 3 ) x. ( D - J ) ) x. ( ( J ^ 2 ) - D ) ) = ( ( E ^ 3 ) x. ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) ) )
r6:r1,r4,r5:3eqtrd  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. ( ( 1 - ( E x. D ) ) + ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) ) ) = ( ( E ^ 3 ) x. ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) ) )
r7:r6:oveq1d  |- ( ph -> ( ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. ( ( 1 - ( E x. D ) ) + ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) ) ) x. ( 1 - D ) ) = ( ( ( E ^ 3 ) x. ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) ) x. ( 1 - D ) ) )
cprod:cDmJ,cJ2mD:mulcld  |- ( ph -> ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) e. CC )
c1D:c1,2:subcld  |- ( ph -> ( 1 - D ) e. CC )
r8:cE3,cprod,c1D:mulassd  |- ( ph -> ( ( ( E ^ 3 ) x. ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) ) x. ( 1 - D ) ) = ( ( E ^ 3 ) x. ( ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) x. ( 1 - D ) ) ) )
r9:cprod,c1D:mulcomd  |- ( ph -> ( ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) x. ( 1 - D ) ) = ( ( 1 - D ) x. ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) ) )
r10:cJ,5,6,2:morlemcyc  |- ( ph -> ( ( 1 - D ) x. ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) ) = ( ( D ^ 3 ) - 1 ) )
r11:r9,r10:eqtrd  |- ( ph -> ( ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) x. ( 1 - D ) ) = ( ( D ^ 3 ) - 1 ) )
r12:r11:oveq2d  |- ( ph -> ( ( E ^ 3 ) x. ( ( ( D - J ) x. ( ( J ^ 2 ) - D ) ) x. ( 1 - D ) ) ) = ( ( E ^ 3 ) x. ( ( D ^ 3 ) - 1 ) ) )
qed:r7,r8,r12:3eqtrd  |- ( ph -> ( ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( G x. E ) ) ) x. ( ( 1 - ( E x. D ) ) + ( ( 1 - ( D x. G ) ) x. ( ( J ^ 2 ) x. E ) ) ) ) x. ( 1 - D ) ) = ( ( E ^ 3 ) x. ( ( D ^ 3 ) - 1 ) ) )

$)

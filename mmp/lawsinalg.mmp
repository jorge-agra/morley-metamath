$( <MM> <PROOF_ASST> THEOREM=lawsinalg  LOC_AFTER=?

dA::simp1  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> A e. CC )
dB2::simp2  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( B e. CC /\ B =/= 0 ) )
dB:dB2:simpld  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> B e. CC )
dB0:dB2:simprd  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> B =/= 0 )
dC3::simp3  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( C e. CC /\ C =/= 0 ) )
dC:dC3:simpld  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> C e. CC )
dC0:dC3:simprd  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> C =/= 0 )

cq:dA,dB,dB0:divcld  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( A / B ) e. CC )

s1:dA,dB,dC,dB0,dC0:divdiv1d  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( ( A / B ) / C ) = ( A / ( B x. C ) ) )
s1e:s1:eqcomd  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( A / ( B x. C ) ) = ( ( A / B ) / C ) )
s2:s1e:oveq2d  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( B x. ( A / ( B x. C ) ) ) = ( B x. ( ( A / B ) / C ) ) )
s3:dB,cq,dC,dC0:divassd  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( ( B x. ( A / B ) ) / C ) = ( B x. ( ( A / B ) / C ) ) )
s3e:s3:eqcomd  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( B x. ( ( A / B ) / C ) ) = ( ( B x. ( A / B ) ) / C ) )
s4:dA,dB,dB0:divcan2d  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( B x. ( A / B ) ) = A )
s5:s4:oveq1d  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( ( B x. ( A / B ) ) / C ) = ( A / C ) )
qed:s2,s3e,s5:3eqtrd  |- ( ( A e. CC /\ ( B e. CC /\ B =/= 0 ) /\ ( C e. CC /\ C =/= 0 ) ) -> ( B x. ( A / ( B x. C ) ) ) = ( A / C ) )
$)

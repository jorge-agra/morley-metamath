$( <MM> <PROOF_ASST> THEOREM=morlemclr  LOC_AFTER=?
$( Clearing the denominator of a fixed-point equation. If the similarity about
   ` B ` with factor ` D ` , followed by the similarity about ` A ` with factor
   ` E ` , fixes ` R ` , then ` ( R x. ( 1 - ( E x. D ) ) ) ` is a combination
   of ` A ` and ` B ` . No division is needed. $)

h1::morlemclr.a  |- ( ph -> A e. CC )
h2::morlemclr.b  |- ( ph -> B e. CC )
h3::morlemclr.r  |- ( ph -> R e. CC )
h4::morlemclr.e  |- ( ph -> E e. CC )
h5::morlemclr.d  |- ( ph -> D e. CC )
h6::morlemclr.1  |- ( ph -> ( A + ( E x. ( ( B + ( D x. ( R - B ) ) ) - A ) ) ) = R )

c1:1:1cnd  |- ( ph -> 1 e. CC )
c1D:c1,5:subcld  |- ( ph -> ( 1 - D ) e. CC )
c1E:c1,4:subcld  |- ( ph -> ( 1 - E ) e. CC )
cDB:c1D,2:mulcld  |- ( ph -> ( ( 1 - D ) x. B ) e. CC )
cDR:5,3:mulcld  |- ( ph -> ( D x. R ) e. CC )
cV:cDB,cDR:addcld  |- ( ph -> ( ( ( 1 - D ) x. B ) + ( D x. R ) ) e. CC )
cEA:c1E,1:mulcld  |- ( ph -> ( ( 1 - E ) x. A ) e. CC )
cEB:4,cDB:mulcld  |- ( ph -> ( E x. ( ( 1 - D ) x. B ) ) e. CC )
cED:4,5:mulcld  |- ( ph -> ( E x. D ) e. CC )
cEDR:cED,3:mulcld  |- ( ph -> ( ( E x. D ) x. R ) e. CC )
cS:cEA,cEB:addcld  |- ( ph -> ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) e. CC )

$( normalise the inner affine map $)
i1d:3,2:subcld  |- ( ph -> ( R - B ) e. CC )
i1m:5,i1d:mulcld  |- ( ph -> ( D x. ( R - B ) ) e. CC )
i1a:2,i1m:addcld  |- ( ph -> ( B + ( D x. ( R - B ) ) ) e. CC )
i1c:2,i1m:addcomd  |- ( ph -> ( B + ( D x. ( R - B ) ) ) = ( ( D x. ( R - B ) ) + B ) )
i1e:i1a,2,3,5:affineequiv4  |- ( ph -> ( ( B + ( D x. ( R - B ) ) ) = ( ( ( 1 - D ) x. B ) + ( D x. R ) ) <-> ( B + ( D x. ( R - B ) ) ) = ( ( D x. ( R - B ) ) + B ) ) )
i1:i1c,i1e:mpbird  |- ( ph -> ( B + ( D x. ( R - B ) ) ) = ( ( ( 1 - D ) x. B ) + ( D x. R ) ) )
i2:i1:oveq1d  |- ( ph -> ( ( B + ( D x. ( R - B ) ) ) - A ) = ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) )
i3:i2:oveq2d  |- ( ph -> ( E x. ( ( B + ( D x. ( R - B ) ) ) - A ) ) = ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) )
i4:i3:oveq2d  |- ( ph -> ( A + ( E x. ( ( B + ( D x. ( R - B ) ) ) - A ) ) ) = ( A + ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) ) )
i5:i4,6:eqtr3d  |- ( ph -> ( A + ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) ) = R )

$( and the outer one $)
j1d:cV,1:subcld  |- ( ph -> ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) e. CC )
j1m:4,j1d:mulcld  |- ( ph -> ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) e. CC )
j1a:1,j1m:addcld  |- ( ph -> ( A + ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) ) e. CC )
j1c:1,j1m:addcomd  |- ( ph -> ( A + ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) ) = ( ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) + A ) )
j1e:j1a,1,cV,4:affineequiv4  |- ( ph -> ( ( A + ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) ) = ( ( ( 1 - E ) x. A ) + ( E x. ( ( ( 1 - D ) x. B ) + ( D x. R ) ) ) ) <-> ( A + ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) ) = ( ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) + A ) ) )
j1:j1c,j1e:mpbird  |- ( ph -> ( A + ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) ) = ( ( ( 1 - E ) x. A ) + ( E x. ( ( ( 1 - D ) x. B ) + ( D x. R ) ) ) ) )
j2:4,cDB,cDR:adddid  |- ( ph -> ( E x. ( ( ( 1 - D ) x. B ) + ( D x. R ) ) ) = ( ( E x. ( ( 1 - D ) x. B ) ) + ( E x. ( D x. R ) ) ) )
j3:4,5,3:mulassd  |- ( ph -> ( ( E x. D ) x. R ) = ( E x. ( D x. R ) ) )
j4:j3:eqcomd  |- ( ph -> ( E x. ( D x. R ) ) = ( ( E x. D ) x. R ) )
j5:j4:oveq2d  |- ( ph -> ( ( E x. ( ( 1 - D ) x. B ) ) + ( E x. ( D x. R ) ) ) = ( ( E x. ( ( 1 - D ) x. B ) ) + ( ( E x. D ) x. R ) ) )
j6:j2,j5:eqtrd  |- ( ph -> ( E x. ( ( ( 1 - D ) x. B ) + ( D x. R ) ) ) = ( ( E x. ( ( 1 - D ) x. B ) ) + ( ( E x. D ) x. R ) ) )
j7:j6:oveq2d  |- ( ph -> ( ( ( 1 - E ) x. A ) + ( E x. ( ( ( 1 - D ) x. B ) + ( D x. R ) ) ) ) = ( ( ( 1 - E ) x. A ) + ( ( E x. ( ( 1 - D ) x. B ) ) + ( ( E x. D ) x. R ) ) ) )
j8:cEA,cEB,cEDR:addassd  |- ( ph -> ( ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) + ( ( E x. D ) x. R ) ) = ( ( ( 1 - E ) x. A ) + ( ( E x. ( ( 1 - D ) x. B ) ) + ( ( E x. D ) x. R ) ) ) )
j9:j7,j8:eqtr4d  |- ( ph -> ( ( ( 1 - E ) x. A ) + ( E x. ( ( ( 1 - D ) x. B ) + ( D x. R ) ) ) ) = ( ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) + ( ( E x. D ) x. R ) ) )
j10:j1,j9:eqtrd  |- ( ph -> ( A + ( E x. ( ( ( ( 1 - D ) x. B ) + ( D x. R ) ) - A ) ) ) = ( ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) + ( ( E x. D ) x. R ) ) )
j11:i5,j10:eqtr3d  |- ( ph -> R = ( ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) + ( ( E x. D ) x. R ) ) )

$( move the R term to the left $)
k1:cS,cEDR:addcomd  |- ( ph -> ( ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) + ( ( E x. D ) x. R ) ) = ( ( ( E x. D ) x. R ) + ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) ) )
k2:j11,k1:eqtrd  |- ( ph -> R = ( ( ( E x. D ) x. R ) + ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) ) )
k3:k2:eqcomd  |- ( ph -> ( ( ( E x. D ) x. R ) + ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) ) = R )
k4:3,cEDR,cS:subaddd  |- ( ph -> ( ( R - ( ( E x. D ) x. R ) ) = ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) <-> ( ( ( E x. D ) x. R ) + ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) ) = R ) )
k5:k3,k4:mpbird  |- ( ph -> ( R - ( ( E x. D ) x. R ) ) = ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) )

$( and read the left side as R x. ( 1 - ( E x. D ) ) $)
l1:3,c1,cED:subdid  |- ( ph -> ( R x. ( 1 - ( E x. D ) ) ) = ( ( R x. 1 ) - ( R x. ( E x. D ) ) ) )
l2:3:mulridd  |- ( ph -> ( R x. 1 ) = R )
l3:3,cED:mulcomd  |- ( ph -> ( R x. ( E x. D ) ) = ( ( E x. D ) x. R ) )
l4:l2,l3:oveq12d  |- ( ph -> ( ( R x. 1 ) - ( R x. ( E x. D ) ) ) = ( R - ( ( E x. D ) x. R ) ) )
l5:l1,l4:eqtrd  |- ( ph -> ( R x. ( 1 - ( E x. D ) ) ) = ( R - ( ( E x. D ) x. R ) ) )
qed:l5,k5:eqtrd  |- ( ph -> ( R x. ( 1 - ( E x. D ) ) ) = ( ( ( 1 - E ) x. A ) + ( E x. ( ( 1 - D ) x. B ) ) ) )

$)

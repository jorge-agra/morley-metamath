$( <MM> <PROOF_ASST> THEOREM=morlemeqd  LOC_AFTER=?

h1::morlemeqd.u  |- ( ph -> U e. CC )
h2::morlemeqd.v  |- ( ph -> V e. CC )
h3::morlemeqd.w  |- ( ph -> W e. CC )
h4::morlemeqd.j  |- ( ph -> J e. CC )
h5::morlemeqd.1  |- ( ph -> ( J ^ 3 ) = 1 )
h6::morlemeqd.2  |- ( ph -> ( ( ( J ^ 2 ) + J ) + 1 ) = 0 )
h7::morlemeqd.3  |- ( ph -> ( ( U + ( J x. V ) ) + ( ( J ^ 2 ) x. W ) ) = 0 )

$( closures $)
k1:4,2:mulcld  |- ( ph -> ( J x. V ) e. CC )
k2:4:sqcld  |- ( ph -> ( J ^ 2 ) e. CC )
k5:4,1:mulcld  |- ( ph -> ( J x. U ) e. CC )
k6:k2,2:mulcld  |- ( ph -> ( ( J ^ 2 ) x. V ) e. CC )
k7:3,k5:addcld  |- ( ph -> ( W + ( J x. U ) ) e. CC )
k8:k1,2:addcld  |- ( ph -> ( ( J x. V ) + V ) e. CC )
k9:k2,4:addcld  |- ( ph -> ( ( J ^ 2 ) + J ) e. CC )
k10:1,2:subcld  |- ( ph -> ( U - V ) e. CC )
k11:4,k10:mulcld  |- ( ph -> ( J x. ( U - V ) ) e. CC )

$( the shifted relation, regrouped around ( J ^ 2 ) x. V $)
r1:1,2,3,4,5,7:morlemeqrot  |- ( ph -> ( ( W + ( J x. U ) ) + ( ( J ^ 2 ) x. V ) ) = 0 )
a1:k7,k6:addcomd  |- ( ph -> ( ( W + ( J x. U ) ) + ( ( J ^ 2 ) x. V ) ) = ( ( ( J ^ 2 ) x. V ) + ( W + ( J x. U ) ) ) )
a2:a1,r1:eqtr3d  |- ( ph -> ( ( ( J ^ 2 ) x. V ) + ( W + ( J x. U ) ) ) = 0 )

$( the vanishing sum, multiplied by V $)
b1:6:oveq1d  |- ( ph -> ( ( ( ( J ^ 2 ) + J ) + 1 ) x. V ) = ( 0 x. V ) )
b2:2:mul02d  |- ( ph -> ( 0 x. V ) = 0 )
b3:b1,b2:eqtrd  |- ( ph -> ( ( ( ( J ^ 2 ) + J ) + 1 ) x. V ) = 0 )
c1:1:1cnd  |- ( ph -> 1 e. CC )
b4:k9,c1,2:adddird  |- ( ph -> ( ( ( ( J ^ 2 ) + J ) + 1 ) x. V ) = ( ( ( ( J ^ 2 ) + J ) x. V ) + ( 1 x. V ) ) )
b5:k2,4,2:adddird  |- ( ph -> ( ( ( J ^ 2 ) + J ) x. V ) = ( ( ( J ^ 2 ) x. V ) + ( J x. V ) ) )
b6:2:mullidd  |- ( ph -> ( 1 x. V ) = V )
b7:b5,b6:oveq12d  |- ( ph -> ( ( ( ( J ^ 2 ) + J ) x. V ) + ( 1 x. V ) ) = ( ( ( ( J ^ 2 ) x. V ) + ( J x. V ) ) + V ) )
b8:b4,b7:eqtrd  |- ( ph -> ( ( ( ( J ^ 2 ) + J ) + 1 ) x. V ) = ( ( ( ( J ^ 2 ) x. V ) + ( J x. V ) ) + V ) )
b9:k6,k1,2:addassd  |- ( ph -> ( ( ( ( J ^ 2 ) x. V ) + ( J x. V ) ) + V ) = ( ( ( J ^ 2 ) x. V ) + ( ( J x. V ) + V ) ) )
b10:b8,b9:eqtrd  |- ( ph -> ( ( ( ( J ^ 2 ) + J ) + 1 ) x. V ) = ( ( ( J ^ 2 ) x. V ) + ( ( J x. V ) + V ) ) )
b11:b10,b3:eqtr3d  |- ( ph -> ( ( ( J ^ 2 ) x. V ) + ( ( J x. V ) + V ) ) = 0 )

$( cancel ( J ^ 2 ) x. V $)
c2:a2,b11:eqtr4d  |- ( ph -> ( ( ( J ^ 2 ) x. V ) + ( W + ( J x. U ) ) ) = ( ( ( J ^ 2 ) x. V ) + ( ( J x. V ) + V ) ) )
c3:k6,k7,k8:addcand  |- ( ph -> ( ( ( ( J ^ 2 ) x. V ) + ( W + ( J x. U ) ) ) = ( ( ( J ^ 2 ) x. V ) + ( ( J x. V ) + V ) ) <-> ( W + ( J x. U ) ) = ( ( J x. V ) + V ) ) )
c4:c2,c3:mpbid  |- ( ph -> ( W + ( J x. U ) ) = ( ( J x. V ) + V ) )

$( and read the difference off $)
d1:4,1,2:subdid  |- ( ph -> ( J x. ( U - V ) ) = ( ( J x. U ) - ( J x. V ) ) )
e1:3,k5,k1:addsubassd  |- ( ph -> ( ( W + ( J x. U ) ) - ( J x. V ) ) = ( W + ( ( J x. U ) - ( J x. V ) ) ) )
e2:c4:oveq1d  |- ( ph -> ( ( W + ( J x. U ) ) - ( J x. V ) ) = ( ( ( J x. V ) + V ) - ( J x. V ) ) )
e3:k1,2:pncan2d  |- ( ph -> ( ( ( J x. V ) + V ) - ( J x. V ) ) = V )
e4:e2,e3:eqtrd  |- ( ph -> ( ( W + ( J x. U ) ) - ( J x. V ) ) = V )
e5:e1,e4:eqtr3d  |- ( ph -> ( W + ( ( J x. U ) - ( J x. V ) ) ) = V )
e6:d1:oveq2d  |- ( ph -> ( W + ( J x. ( U - V ) ) ) = ( W + ( ( J x. U ) - ( J x. V ) ) ) )
e7:e6,e5:eqtrd  |- ( ph -> ( W + ( J x. ( U - V ) ) ) = V )
f1:2,3,k11:subaddd  |- ( ph -> ( ( V - W ) = ( J x. ( U - V ) ) <-> ( W + ( J x. ( U - V ) ) ) = V ) )
qed:e7,f1:mpbird  |- ( ph -> ( V - W ) = ( J x. ( U - V ) ) )

$)

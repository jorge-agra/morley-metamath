$( <MM> <PROOF_ASST> THEOREM=cubm1d  LOC_AFTER=?
$( The factorization of ` ( ( S ^ 3 ) - 1 ) ` over its root ` 1 ` . (Deduction
   form.) $)

h1::cubm1d.s  |- ( ph -> S e. CC )

$( closures $)
c1:1:1cnd  |- ( ph -> 1 e. CC )
s2:1:sqcld  |- ( ph -> ( S ^ 2 ) e. CC )
w1:s2,1:addcld  |- ( ph -> ( ( S ^ 2 ) + S ) e. CC )
w2:w1,c1:addcld  |- ( ph -> ( ( ( S ^ 2 ) + S ) + 1 ) e. CC )

$( S ^ 3 as ( S ^ 2 ) x. S $)
n2a::2nn0  |- 2 e. NN0
n2:n2a:a1i  |- ( ph -> 2 e. NN0 )
q1:1,n2:expp1d  |- ( ph -> ( S ^ ( 2 + 1 ) ) = ( ( S ^ 2 ) x. S ) )
q2a::2p1e3  |- ( 2 + 1 ) = 3
q2b:q2a:oveq2i  |- ( S ^ ( 2 + 1 ) ) = ( S ^ 3 )
q2:q2b:a1i  |- ( ph -> ( S ^ ( 2 + 1 ) ) = ( S ^ 3 ) )
q3:q2,q1:eqtr3d  |- ( ph -> ( S ^ 3 ) = ( ( S ^ 2 ) x. S ) )
s3a:s2,1:mulcld  |- ( ph -> ( ( S ^ 2 ) x. S ) e. CC )
s3:q3,s3a:eqeltrd  |- ( ph -> ( S ^ 3 ) e. CC )

$( distribute $)
p1:1,c1,w2:subdird  |- ( ph -> ( ( S - 1 ) x. ( ( ( S ^ 2 ) + S ) + 1 ) ) = ( ( S x. ( ( ( S ^ 2 ) + S ) + 1 ) ) - ( 1 x. ( ( ( S ^ 2 ) + S ) + 1 ) ) ) )
p2:w2:mullidd  |- ( ph -> ( 1 x. ( ( ( S ^ 2 ) + S ) + 1 ) ) = ( ( ( S ^ 2 ) + S ) + 1 ) )
p3:1,w1,c1:adddid  |- ( ph -> ( S x. ( ( ( S ^ 2 ) + S ) + 1 ) ) = ( ( S x. ( ( S ^ 2 ) + S ) ) + ( S x. 1 ) ) )
p4:1:mulridd  |- ( ph -> ( S x. 1 ) = S )
p5:1,s2,1:adddid  |- ( ph -> ( S x. ( ( S ^ 2 ) + S ) ) = ( ( S x. ( S ^ 2 ) ) + ( S x. S ) ) )
p6a:1,s2:mulcomd  |- ( ph -> ( S x. ( S ^ 2 ) ) = ( ( S ^ 2 ) x. S ) )
p6:p6a,q3:eqtr4d  |- ( ph -> ( S x. ( S ^ 2 ) ) = ( S ^ 3 ) )
p7a:1:sqvald  |- ( ph -> ( S ^ 2 ) = ( S x. S ) )
p7:p7a:eqcomd  |- ( ph -> ( S x. S ) = ( S ^ 2 ) )
p8:p6,p7:oveq12d  |- ( ph -> ( ( S x. ( S ^ 2 ) ) + ( S x. S ) ) = ( ( S ^ 3 ) + ( S ^ 2 ) ) )
p9:p5,p8:eqtrd  |- ( ph -> ( S x. ( ( S ^ 2 ) + S ) ) = ( ( S ^ 3 ) + ( S ^ 2 ) ) )
p10:p9,p4:oveq12d  |- ( ph -> ( ( S x. ( ( S ^ 2 ) + S ) ) + ( S x. 1 ) ) = ( ( ( S ^ 3 ) + ( S ^ 2 ) ) + S ) )
p11:p3,p10:eqtrd  |- ( ph -> ( S x. ( ( ( S ^ 2 ) + S ) + 1 ) ) = ( ( ( S ^ 3 ) + ( S ^ 2 ) ) + S ) )
p12:p11,p2:oveq12d  |- ( ph -> ( ( S x. ( ( ( S ^ 2 ) + S ) + 1 ) ) - ( 1 x. ( ( ( S ^ 2 ) + S ) + 1 ) ) ) = ( ( ( ( S ^ 3 ) + ( S ^ 2 ) ) + S ) - ( ( ( S ^ 2 ) + S ) + 1 ) ) )
p13:p1,p12:eqtrd  |- ( ph -> ( ( S - 1 ) x. ( ( ( S ^ 2 ) + S ) + 1 ) ) = ( ( ( ( S ^ 3 ) + ( S ^ 2 ) ) + S ) - ( ( ( S ^ 2 ) + S ) + 1 ) ) )

$( and cancel the middle $)
r1:s3,s2,1:addassd  |- ( ph -> ( ( ( S ^ 3 ) + ( S ^ 2 ) ) + S ) = ( ( S ^ 3 ) + ( ( S ^ 2 ) + S ) ) )
r2:w1,c1:addcomd  |- ( ph -> ( ( ( S ^ 2 ) + S ) + 1 ) = ( 1 + ( ( S ^ 2 ) + S ) ) )
r3:r1,r2:oveq12d  |- ( ph -> ( ( ( ( S ^ 3 ) + ( S ^ 2 ) ) + S ) - ( ( ( S ^ 2 ) + S ) + 1 ) ) = ( ( ( S ^ 3 ) + ( ( S ^ 2 ) + S ) ) - ( 1 + ( ( S ^ 2 ) + S ) ) ) )
r4:s3,w1,c1,w1:addsub4d  |- ( ph -> ( ( ( S ^ 3 ) + ( ( S ^ 2 ) + S ) ) - ( 1 + ( ( S ^ 2 ) + S ) ) ) = ( ( ( S ^ 3 ) - 1 ) + ( ( ( S ^ 2 ) + S ) - ( ( S ^ 2 ) + S ) ) ) )
r5:w1:subidd  |- ( ph -> ( ( ( S ^ 2 ) + S ) - ( ( S ^ 2 ) + S ) ) = 0 )
r6:r5:oveq2d  |- ( ph -> ( ( ( S ^ 3 ) - 1 ) + ( ( ( S ^ 2 ) + S ) - ( ( S ^ 2 ) + S ) ) ) = ( ( ( S ^ 3 ) - 1 ) + 0 ) )
r7a:s3,c1:subcld  |- ( ph -> ( ( S ^ 3 ) - 1 ) e. CC )
r7:r7a:addridd  |- ( ph -> ( ( ( S ^ 3 ) - 1 ) + 0 ) = ( ( S ^ 3 ) - 1 ) )
r8:r3,r4,r6:3eqtrd  |- ( ph -> ( ( ( ( S ^ 3 ) + ( S ^ 2 ) ) + S ) - ( ( ( S ^ 2 ) + S ) + 1 ) ) = ( ( ( S ^ 3 ) - 1 ) + 0 ) )
r9:r8,r7:eqtrd  |- ( ph -> ( ( ( ( S ^ 3 ) + ( S ^ 2 ) ) + S ) - ( ( ( S ^ 2 ) + S ) + 1 ) ) = ( ( S ^ 3 ) - 1 ) )

qed:p13,r9:eqtrd  |- ( ph -> ( ( S - 1 ) x. ( ( ( S ^ 2 ) + S ) + 1 ) ) = ( ( S ^ 3 ) - 1 ) )

$)

$( <MM> <PROOF_ASST> THEOREM=morlemaff  LOC_AFTER=?

h1::morlemaff.x  |- ( ph -> X e. CC )
h2::morlemaff.u  |- ( ph -> U e. CC )
h3::morlemaff.y  |- ( ph -> Y e. CC )

c1:1:1cnd  |- ( ph -> 1 e. CC )
cUY:2,3:mulcld  |- ( ph -> ( U x. Y ) e. CC )
cUX:2,1:mulcld  |- ( ph -> ( U x. X ) e. CC )

a1:2,3,1:subdid  |- ( ph -> ( U x. ( Y - X ) ) = ( ( U x. Y ) - ( U x. X ) ) )
a2:a1:oveq2d  |- ( ph -> ( X + ( U x. ( Y - X ) ) ) = ( X + ( ( U x. Y ) - ( U x. X ) ) ) )
a3:1,cUY,cUX:addsubassd  |- ( ph -> ( ( X + ( U x. Y ) ) - ( U x. X ) ) = ( X + ( ( U x. Y ) - ( U x. X ) ) ) )
a4:1,cUY,cUX:addsubd  |- ( ph -> ( ( X + ( U x. Y ) ) - ( U x. X ) ) = ( ( X - ( U x. X ) ) + ( U x. Y ) ) )
a5:a3,a4:eqtr3d  |- ( ph -> ( X + ( ( U x. Y ) - ( U x. X ) ) ) = ( ( X - ( U x. X ) ) + ( U x. Y ) ) )
a6:c1,2,1:subdird  |- ( ph -> ( ( 1 - U ) x. X ) = ( ( 1 x. X ) - ( U x. X ) ) )
a7:1:mullidd  |- ( ph -> ( 1 x. X ) = X )
a8:a7:oveq1d  |- ( ph -> ( ( 1 x. X ) - ( U x. X ) ) = ( X - ( U x. X ) ) )
a9:a6,a8:eqtrd  |- ( ph -> ( ( 1 - U ) x. X ) = ( X - ( U x. X ) ) )
a10:a9:oveq1d  |- ( ph -> ( ( ( 1 - U ) x. X ) + ( U x. Y ) ) = ( ( X - ( U x. X ) ) + ( U x. Y ) ) )
a11:a5,a10:eqtr4d  |- ( ph -> ( X + ( ( U x. Y ) - ( U x. X ) ) ) = ( ( ( 1 - U ) x. X ) + ( U x. Y ) ) )
qed:a2,a11:eqtrd  |- ( ph -> ( X + ( U x. ( Y - X ) ) ) = ( ( ( 1 - U ) x. X ) + ( U x. Y ) ) )

$)

$( <MM> <PROOF_ASST> THEOREM=cnaff3  LOC_AFTER=?

h1::cnaff3.a  |- ( ph -> A e. CC )
h2::cnaff3.b  |- ( ph -> B e. CC )
h3::cnaff3.z  |- ( ph -> Z e. CC )

cOne::1cnd  |- ( ph -> 1 e. CC )
cAA:1,1:mulcld  |- ( ph -> ( A x. A ) e. CC )
cAB:1,2:mulcld  |- ( ph -> ( A x. B ) e. CC )
cABB:cAB,2:addcld  |- ( ph -> ( ( A x. B ) + B ) e. CC )
cV:1,cAB:mulcld  |- ( ph -> ( A x. ( A x. B ) ) e. CC )
cA2:1:sqcld  |- ( ph -> ( A ^ 2 ) e. CC )

$( the two applications of cnaffco $)
t1:1,1,2,2,3:cnaffco  |- ( ph -> ( ( A x. ( ( A x. Z ) + B ) ) + B ) = ( ( ( A x. A ) x. Z ) + ( ( A x. B ) + B ) ) )
t2:t1:oveq2d  |- ( ph -> ( A x. ( ( A x. ( ( A x. Z ) + B ) ) + B ) ) = ( A x. ( ( ( A x. A ) x. Z ) + ( ( A x. B ) + B ) ) ) )
t3:t2:oveq1d  |- ( ph -> ( ( A x. ( ( A x. ( ( A x. Z ) + B ) ) + B ) ) + B ) = ( ( A x. ( ( ( A x. A ) x. Z ) + ( ( A x. B ) + B ) ) ) + B ) )
t4:1,cAA,cABB,2,3:cnaffco  |- ( ph -> ( ( A x. ( ( ( A x. A ) x. Z ) + ( ( A x. B ) + B ) ) ) + B ) = ( ( ( A x. ( A x. A ) ) x. Z ) + ( ( A x. ( ( A x. B ) + B ) ) + B ) ) )
t5:t3,t4:eqtrd  |- ( ph -> ( ( A x. ( ( A x. ( ( A x. Z ) + B ) ) + B ) ) + B ) = ( ( ( A x. ( A x. A ) ) x. Z ) + ( ( A x. ( ( A x. B ) + B ) ) + B ) ) )

$( the coefficient is a cube $)
c1a0::2p1e3  |- ( 2 + 1 ) = 3
c1a1:c1a0:oveq2i  |- ( A ^ ( 2 + 1 ) ) = ( A ^ 3 )
c1a2:c1a1:eqcomi  |- ( A ^ 3 ) = ( A ^ ( 2 + 1 ) )
c1a3:c1a2:a1i  |- ( ph -> ( A ^ 3 ) = ( A ^ ( 2 + 1 ) ) )
c1b0::2nn0  |- 2 e. NN0
c1b1:c1b0:a1i  |- ( ph -> 2 e. NN0 )
c1b:1,c1b1:expp1d  |- ( ph -> ( A ^ ( 2 + 1 ) ) = ( ( A ^ 2 ) x. A ) )
c1c:1:sqvald  |- ( ph -> ( A ^ 2 ) = ( A x. A ) )
c1d:c1c:oveq1d  |- ( ph -> ( ( A ^ 2 ) x. A ) = ( ( A x. A ) x. A ) )
c1e:1,1,1:mulassd  |- ( ph -> ( ( A x. A ) x. A ) = ( A x. ( A x. A ) ) )
c1x:c1a3,c1b,c1d:3eqtrd  |- ( ph -> ( A ^ 3 ) = ( ( A x. A ) x. A ) )
c1:c1x,c1e:eqtrd  |- ( ph -> ( A ^ 3 ) = ( A x. ( A x. A ) ) )
c1r:c1:eqcomd  |- ( ph -> ( A x. ( A x. A ) ) = ( A ^ 3 ) )
t6:c1r:oveq1d  |- ( ph -> ( ( A x. ( A x. A ) ) x. Z ) = ( ( A ^ 3 ) x. Z ) )

$( the constant term $)
k1:1,cAB,2:adddid  |- ( ph -> ( A x. ( ( A x. B ) + B ) ) = ( ( A x. ( A x. B ) ) + ( A x. B ) ) )
k2:k1:oveq1d  |- ( ph -> ( ( A x. ( ( A x. B ) + B ) ) + B ) = ( ( ( A x. ( A x. B ) ) + ( A x. B ) ) + B ) )

r2:2,cOne,1:adddid  |- ( ph -> ( B x. ( 1 + A ) ) = ( ( B x. 1 ) + ( B x. A ) ) )
r3a:2:mulridd  |- ( ph -> ( B x. 1 ) = B )
r3:r3a:oveq1d  |- ( ph -> ( ( B x. 1 ) + ( B x. A ) ) = ( B + ( B x. A ) ) )
r4a:2,1:mulcomd  |- ( ph -> ( B x. A ) = ( A x. B ) )
r4:r4a:oveq2d  |- ( ph -> ( B + ( B x. A ) ) = ( B + ( A x. B ) ) )
r5:r2,r3,r4:3eqtrd  |- ( ph -> ( B x. ( 1 + A ) ) = ( B + ( A x. B ) ) )

r6a:c1c:oveq2d  |- ( ph -> ( B x. ( A ^ 2 ) ) = ( B x. ( A x. A ) ) )
r6b:2,cAA:mulcomd  |- ( ph -> ( B x. ( A x. A ) ) = ( ( A x. A ) x. B ) )
r6c:1,1,2:mulassd  |- ( ph -> ( ( A x. A ) x. B ) = ( A x. ( A x. B ) ) )
r6:r6a,r6b,r6c:3eqtrd  |- ( ph -> ( B x. ( A ^ 2 ) ) = ( A x. ( A x. B ) ) )

cS:cOne,1:addcld  |- ( ph -> ( 1 + A ) e. CC )
r1:2,cS,cA2:adddid  |- ( ph -> ( B x. ( ( 1 + A ) + ( A ^ 2 ) ) ) = ( ( B x. ( 1 + A ) ) + ( B x. ( A ^ 2 ) ) ) )
r7a:r5,r6:oveq12d  |- ( ph -> ( ( B x. ( 1 + A ) ) + ( B x. ( A ^ 2 ) ) ) = ( ( B + ( A x. B ) ) + ( A x. ( A x. B ) ) ) )
r7:r1,r7a:eqtrd  |- ( ph -> ( B x. ( ( 1 + A ) + ( A ^ 2 ) ) ) = ( ( B + ( A x. B ) ) + ( A x. ( A x. B ) ) ) )

m1:cV,cAB,2:add32d  |- ( ph -> ( ( ( A x. ( A x. B ) ) + ( A x. B ) ) + B ) = ( ( ( A x. ( A x. B ) ) + B ) + ( A x. B ) ) )
m2a:cV,2:addcomd  |- ( ph -> ( ( A x. ( A x. B ) ) + B ) = ( B + ( A x. ( A x. B ) ) ) )
m2:m2a:oveq1d  |- ( ph -> ( ( ( A x. ( A x. B ) ) + B ) + ( A x. B ) ) = ( ( B + ( A x. ( A x. B ) ) ) + ( A x. B ) ) )
m3:2,cV,cAB:add32d  |- ( ph -> ( ( B + ( A x. ( A x. B ) ) ) + ( A x. B ) ) = ( ( B + ( A x. B ) ) + ( A x. ( A x. B ) ) ) )
m:m1,m2,m3:3eqtrd  |- ( ph -> ( ( ( A x. ( A x. B ) ) + ( A x. B ) ) + B ) = ( ( B + ( A x. B ) ) + ( A x. ( A x. B ) ) ) )

r7e:r7:eqcomd  |- ( ph -> ( ( B + ( A x. B ) ) + ( A x. ( A x. B ) ) ) = ( B x. ( ( 1 + A ) + ( A ^ 2 ) ) ) )
kfin:k2,m,r7e:3eqtrd  |- ( ph -> ( ( A x. ( ( A x. B ) + B ) ) + B ) = ( B x. ( ( 1 + A ) + ( A ^ 2 ) ) ) )

f1:t6,kfin:oveq12d  |- ( ph -> ( ( ( A x. ( A x. A ) ) x. Z ) + ( ( A x. ( ( A x. B ) + B ) ) + B ) ) = ( ( ( A ^ 3 ) x. Z ) + ( B x. ( ( 1 + A ) + ( A ^ 2 ) ) ) ) )
qed:t5,f1:eqtrd  |- ( ph -> ( ( A x. ( ( A x. ( ( A x. Z ) + B ) ) + B ) ) + B ) = ( ( ( A ^ 3 ) x. Z ) + ( B x. ( ( 1 + A ) + ( A ^ 2 ) ) ) ) )

$)

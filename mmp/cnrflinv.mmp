$( <MM> <PROOF_ASST> THEOREM=cnrflinv  LOC_AFTER=?
$( The reflection of the complex plane across the line through distinct points
   ` A ` and ` W ` maps ` Z ` to ` ( A + ( E x. ( * `` ( Z - A ) ) ) ) ` ,
   where ` E ` is the number ` ( ( W - A ) / ( * `` ( W - A ) ) ) ` of absolute
   value ` 1 ` . This theorem shows that the reflection is an involution:
   applying it twice returns ` Z ` . $)

h1::cnrflinv.a  |- ( ph -> A e. CC )
h2::cnrflinv.w  |- ( ph -> W e. CC )
h3::cnrflinv.z  |- ( ph -> Z e. CC )
h4::cnrflinv.n  |- ( ph -> W =/= A )
h5::cnrflinv.e  |- E = ( ( W - A ) / ( * ` ( W - A ) ) )

cU:2,1:subcld  |- ( ph -> ( W - A ) e. CC )
nU:2,1,4:subne0d  |- ( ph -> ( W - A ) =/= 0 )
cCU:cU:cjcld  |- ( ph -> ( * ` ( W - A ) ) e. CC )
nCU:cU,nU:cjne0d  |- ( ph -> ( * ` ( W - A ) ) =/= 0 )
dE0:5:a1i  |- ( ph -> E = ( ( W - A ) / ( * ` ( W - A ) ) ) )
cQ:cU,cCU,nCU:divcld  |- ( ph -> ( ( W - A ) / ( * ` ( W - A ) ) ) e. CC )
cE:dE0,cQ:eqeltrd  |- ( ph -> E e. CC )
cCE:cE:cjcld  |- ( ph -> ( * ` E ) e. CC )
cZA:3,1:subcld  |- ( ph -> ( Z - A ) e. CC )
cCZA:cZA:cjcld  |- ( ph -> ( * ` ( Z - A ) ) e. CC )
cX:cE,cCZA:mulcld  |- ( ph -> ( E x. ( * ` ( Z - A ) ) ) e. CC )

$( E x. ( * ` E ) = 1 $)
e1:cU,cCU,nCU:cjdivd  |- ( ph -> ( * ` ( ( W - A ) / ( * ` ( W - A ) ) ) ) = ( ( * ` ( W - A ) ) / ( * ` ( * ` ( W - A ) ) ) ) )
e2:cU:cjcjd  |- ( ph -> ( * ` ( * ` ( W - A ) ) ) = ( W - A ) )
e3:e2:oveq2d  |- ( ph -> ( ( * ` ( W - A ) ) / ( * ` ( * ` ( W - A ) ) ) ) = ( ( * ` ( W - A ) ) / ( W - A ) ) )
e4:e1,e3:eqtrd  |- ( ph -> ( * ` ( ( W - A ) / ( * ` ( W - A ) ) ) ) = ( ( * ` ( W - A ) ) / ( W - A ) ) )
e5:dE0:fveq2d  |- ( ph -> ( * ` E ) = ( * ` ( ( W - A ) / ( * ` ( W - A ) ) ) ) )
e6:e5,e4:eqtrd  |- ( ph -> ( * ` E ) = ( ( * ` ( W - A ) ) / ( W - A ) ) )
e7:dE0,e6:oveq12d  |- ( ph -> ( E x. ( * ` E ) ) = ( ( ( W - A ) / ( * ` ( W - A ) ) ) x. ( ( * ` ( W - A ) ) / ( W - A ) ) ) )
e8:cU,cCU,cCU,cU,nCU,nU:divmuldivd  |- ( ph -> ( ( ( W - A ) / ( * ` ( W - A ) ) ) x. ( ( * ` ( W - A ) ) / ( W - A ) ) ) = ( ( ( W - A ) x. ( * ` ( W - A ) ) ) / ( ( * ` ( W - A ) ) x. ( W - A ) ) ) )
e9:cCU,cU:mulcomd  |- ( ph -> ( ( * ` ( W - A ) ) x. ( W - A ) ) = ( ( W - A ) x. ( * ` ( W - A ) ) ) )
e10:e9:oveq2d  |- ( ph -> ( ( ( W - A ) x. ( * ` ( W - A ) ) ) / ( ( * ` ( W - A ) ) x. ( W - A ) ) ) = ( ( ( W - A ) x. ( * ` ( W - A ) ) ) / ( ( W - A ) x. ( * ` ( W - A ) ) ) ) )
cP:cU,cCU:mulcld  |- ( ph -> ( ( W - A ) x. ( * ` ( W - A ) ) ) e. CC )
nP:cU,cCU,nU,nCU:mulne0d  |- ( ph -> ( ( W - A ) x. ( * ` ( W - A ) ) ) =/= 0 )
e11:cP,nP:dividd  |- ( ph -> ( ( ( W - A ) x. ( * ` ( W - A ) ) ) / ( ( W - A ) x. ( * ` ( W - A ) ) ) ) = 1 )
e11b:e7,e8,e10:3eqtrd  |- ( ph -> ( E x. ( * ` E ) ) = ( ( ( W - A ) x. ( * ` ( W - A ) ) ) / ( ( W - A ) x. ( * ` ( W - A ) ) ) ) )
e12:e11b,e11:eqtrd  |- ( ph -> ( E x. ( * ` E ) ) = 1 )

$( unwinding the double reflection $)
i1:1,cX:pncan2d  |- ( ph -> ( ( A + ( E x. ( * ` ( Z - A ) ) ) ) - A ) = ( E x. ( * ` ( Z - A ) ) ) )
i2:i1:fveq2d  |- ( ph -> ( * ` ( ( A + ( E x. ( * ` ( Z - A ) ) ) ) - A ) ) = ( * ` ( E x. ( * ` ( Z - A ) ) ) ) )
i3:cE,cCZA:cjmuld  |- ( ph -> ( * ` ( E x. ( * ` ( Z - A ) ) ) ) = ( ( * ` E ) x. ( * ` ( * ` ( Z - A ) ) ) ) )
i4:cZA:cjcjd  |- ( ph -> ( * ` ( * ` ( Z - A ) ) ) = ( Z - A ) )
i5:i4:oveq2d  |- ( ph -> ( ( * ` E ) x. ( * ` ( * ` ( Z - A ) ) ) ) = ( ( * ` E ) x. ( Z - A ) ) )
i6:i2,i3,i5:3eqtrd  |- ( ph -> ( * ` ( ( A + ( E x. ( * ` ( Z - A ) ) ) ) - A ) ) = ( ( * ` E ) x. ( Z - A ) ) )
i7:i6:oveq2d  |- ( ph -> ( E x. ( * ` ( ( A + ( E x. ( * ` ( Z - A ) ) ) ) - A ) ) ) = ( E x. ( ( * ` E ) x. ( Z - A ) ) ) )
i8:cE,cCE,cZA:mulassd  |- ( ph -> ( ( E x. ( * ` E ) ) x. ( Z - A ) ) = ( E x. ( ( * ` E ) x. ( Z - A ) ) ) )
i9:i8:eqcomd  |- ( ph -> ( E x. ( ( * ` E ) x. ( Z - A ) ) ) = ( ( E x. ( * ` E ) ) x. ( Z - A ) ) )
i10:e12:oveq1d  |- ( ph -> ( ( E x. ( * ` E ) ) x. ( Z - A ) ) = ( 1 x. ( Z - A ) ) )
i11:cZA:mullidd  |- ( ph -> ( 1 x. ( Z - A ) ) = ( Z - A ) )
i11b:i7,i9,i10:3eqtrd  |- ( ph -> ( E x. ( * ` ( ( A + ( E x. ( * ` ( Z - A ) ) ) ) - A ) ) ) = ( 1 x. ( Z - A ) ) )
i12:i11b,i11:eqtrd  |- ( ph -> ( E x. ( * ` ( ( A + ( E x. ( * ` ( Z - A ) ) ) ) - A ) ) ) = ( Z - A ) )
i13:i12:oveq2d  |- ( ph -> ( A + ( E x. ( * ` ( ( A + ( E x. ( * ` ( Z - A ) ) ) ) - A ) ) ) ) = ( A + ( Z - A ) ) )
i14:1,3:pncan3d  |- ( ph -> ( A + ( Z - A ) ) = Z )
qed:i13,i14:eqtrd  |- ( ph -> ( A + ( E x. ( * ` ( ( A + ( E x. ( * ` ( Z - A ) ) ) ) - A ) ) ) ) = Z )

$)

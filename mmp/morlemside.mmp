$( <MM> <PROOF_ASST> THEOREM=morlemside  LOC_AFTER=?

$d A x
$d A y
$d B x
$d B y
$d C x
$d C y
$d P x
$d P y
$d x y

h1::morlemside.f  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::morlemside.a  |- ( ph -> A e. CC )
h3::morlemside.b  |- ( ph -> B e. CC )
h4::morlemside.c  |- ( ph -> C e. CC )
h5::morlemside.p  |- ( ph -> P e. CC )
h6::morlemside.ab  |- ( ph -> A =/= B )
h7::morlemside.bc  |- ( ph -> B =/= C )
h8::morlemside.ca  |- ( ph -> C =/= A )
h9::morlemside.pb  |- ( ph -> P =/= B )
h10::morlemside.pc  |- ( ph -> P =/= C )
h11::morlemside.x  |- X = ( ( ( B - A ) F ( C - A ) ) / 3 )
h12::morlemside.y  |- Y = ( ( ( C - B ) F ( A - B ) ) / 3 )
h13::morlemside.z  |- Z = ( ( ( A - C ) F ( B - C ) ) / 3 )
h14::morlemside.o  |- ( ph -> ( ( B - A ) F ( C - A ) ) e. ( 0 (,) _pi ) )
h15::morlemside.1  |- ( ph -> ( ( C - B ) F ( P - B ) ) = Y )
h16::morlemside.2  |- ( ph -> ( ( P - C ) F ( B - C ) ) = Z )
h17::morlemside.s  |- ( ph -> S e. RR )
h18::morlemside.3  |- ( ph -> ( abs ` ( B - C ) ) = ( 2 x. ( S x. ( sin ` ( 3 x. X ) ) ) ) )

$( numeric closures $)
c3ri::3re  |- 3 e. RR
c3r:c3ri:a1i  |- ( ph -> 3 e. RR )
c3ci::3cn  |- 3 e. CC
c3c:c3ci:a1i  |- ( ph -> 3 e. CC )
c3ni::3ne0  |- 3 =/= 0
c3n:c3ni:a1i  |- ( ph -> 3 =/= 0 )
piri::pire  |- _pi e. RR
zerox::0xr  |- 0 e. RR*
zx:zerox:a1i  |- ( ph -> 0 e. RR* )
pixi::pnfxr  |- +oo e. RR*
elior::elioore  |- ( ( ( B - A ) F ( C - A ) ) e. ( 0 (,) _pi ) -> ( ( B - A ) F ( C - A ) ) e. RR )
eliob::elioore  |- ( ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) -> ( ( C - B ) F ( A - B ) ) e. RR )
elioc::elioore  |- ( ( ( A - C ) F ( B - C ) ) e. ( 0 (,) _pi ) -> ( ( A - C ) F ( B - C ) ) e. RR )
eliop::elioore  |- ( ( ( B - P ) F ( C - P ) ) e. ( 0 (,) _pi ) -> ( ( B - P ) F ( C - P ) ) e. RR )
pir:piri:a1i  |- ( ph -> _pi e. RR )
pici::picn  |- _pi e. CC
pic:pici:a1i  |- ( ph -> _pi e. CC )

$( the three angles of A B C , and their thirds $)
q1:1,2,3,4,6,7,8,14:ang180pos  |- ( ph -> ( ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) /\ ( ( A - C ) F ( B - C ) ) e. ( 0 (,) _pi ) /\ ( ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) + ( ( B - A ) F ( C - A ) ) ) = _pi ) )
gbi:q1:simp1d  |- ( ph -> ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) )
gci:q1:simp2d  |- ( ph -> ( ( A - C ) F ( B - C ) ) e. ( 0 (,) _pi ) )
gsum:q1:simp3d  |- ( ph -> ( ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) + ( ( B - A ) F ( C - A ) ) ) = _pi )
gar:14,elior:syl  |- ( ph -> ( ( B - A ) F ( C - A ) ) e. RR )
gbr:gbi,eliob:syl  |- ( ph -> ( ( C - B ) F ( A - B ) ) e. RR )
gcr:gci,elioc:syl  |- ( ph -> ( ( A - C ) F ( B - C ) ) e. RR )
garc:gar:recnd  |- ( ph -> ( ( B - A ) F ( C - A ) ) e. CC )
gbrc:gbr:recnd  |- ( ph -> ( ( C - B ) F ( A - B ) ) e. CC )
gcrc:gcr:recnd  |- ( ph -> ( ( A - C ) F ( B - C ) ) e. CC )
xr0:gar,c3r,c3n:redivcld  |- ( ph -> ( ( ( B - A ) F ( C - A ) ) / 3 ) e. RR )
xh:11:a1i  |- ( ph -> X = ( ( ( B - A ) F ( C - A ) ) / 3 ) )
xr:xh,xr0:eqeltrd  |- ( ph -> X e. RR )
yr0:gbr,c3r,c3n:redivcld  |- ( ph -> ( ( ( C - B ) F ( A - B ) ) / 3 ) e. RR )
yh:12:a1i  |- ( ph -> Y = ( ( ( C - B ) F ( A - B ) ) / 3 ) )
yr:yh,yr0:eqeltrd  |- ( ph -> Y e. RR )
zr0:gcr,c3r,c3n:redivcld  |- ( ph -> ( ( ( A - C ) F ( B - C ) ) / 3 ) e. RR )
zh:13:a1i  |- ( ph -> Z = ( ( ( A - C ) F ( B - C ) ) / 3 ) )
zr:zh,zr0:eqeltrd  |- ( ph -> Z e. RR )
xc:xr:recnd  |- ( ph -> X e. CC )
yc:yr:recnd  |- ( ph -> Y e. CC )
zc:zr:recnd  |- ( ph -> Z e. CC )

$( three times each third is the angle again $)
x3a:xh:oveq2d  |- ( ph -> ( 3 x. X ) = ( 3 x. ( ( ( B - A ) F ( C - A ) ) / 3 ) ) )
x3b:garc,c3c,c3n:divcan2d  |- ( ph -> ( 3 x. ( ( ( B - A ) F ( C - A ) ) / 3 ) ) = ( ( B - A ) F ( C - A ) ) )
x3:x3a,x3b:eqtrd  |- ( ph -> ( 3 x. X ) = ( ( B - A ) F ( C - A ) ) )
y3a:yh:oveq2d  |- ( ph -> ( 3 x. Y ) = ( 3 x. ( ( ( C - B ) F ( A - B ) ) / 3 ) ) )
y3b:gbrc,c3c,c3n:divcan2d  |- ( ph -> ( 3 x. ( ( ( C - B ) F ( A - B ) ) / 3 ) ) = ( ( C - B ) F ( A - B ) ) )
y3:y3a,y3b:eqtrd  |- ( ph -> ( 3 x. Y ) = ( ( C - B ) F ( A - B ) ) )
z3a:zh:oveq2d  |- ( ph -> ( 3 x. Z ) = ( 3 x. ( ( ( A - C ) F ( B - C ) ) / 3 ) ) )
z3b:gcrc,c3c,c3n:divcan2d  |- ( ph -> ( 3 x. ( ( ( A - C ) F ( B - C ) ) / 3 ) ) = ( ( A - C ) F ( B - C ) ) )
z3:z3a,z3b:eqtrd  |- ( ph -> ( 3 x. Z ) = ( ( A - C ) F ( B - C ) ) )

$( X , Y and Z are positive $)
pixr:pir:rexrd  |- ( ph -> _pi e. RR* )
gla::ioogtlb  |- ( ( 0 e. RR* /\ _pi e. RR* /\ ( ( B - A ) F ( C - A ) ) e. ( 0 (,) _pi ) ) -> 0 < ( ( B - A ) F ( C - A ) ) )
xg0a:zx,pixr,14,gla:syl3anc  |- ( ph -> 0 < ( ( B - A ) F ( C - A ) ) )
glb::ioogtlb  |- ( ( 0 e. RR* /\ _pi e. RR* /\ ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) ) -> 0 < ( ( C - B ) F ( A - B ) ) )
ygg:zx,pixr,gbi,glb:syl3anc  |- ( ph -> 0 < ( ( C - B ) F ( A - B ) ) )
glc::ioogtlb  |- ( ( 0 e. RR* /\ _pi e. RR* /\ ( ( A - C ) F ( B - C ) ) e. ( 0 (,) _pi ) ) -> 0 < ( ( A - C ) F ( B - C ) ) )
zgg:zx,pixr,gci,glc:syl3anc  |- ( ph -> 0 < ( ( A - C ) F ( B - C ) ) )
xd3:gar,c3r,xg0a,c3g:divgt0d  |- ( ph -> 0 < ( ( ( B - A ) F ( C - A ) ) / 3 ) )
c3gi::3pos  |- 0 < 3
c3g:c3gi:a1i  |- ( ph -> 0 < 3 )
xpos:xd3,xh:breqtrrd  |- ( ph -> 0 < X )
yd3:gbr,c3r,ygg,c3g:divgt0d  |- ( ph -> 0 < ( ( ( C - B ) F ( A - B ) ) / 3 ) )
ypos:yd3,yh:breqtrrd  |- ( ph -> 0 < Y )
zd3:gcr,c3r,zgg,c3g:divgt0d  |- ( ph -> 0 < ( ( ( A - C ) F ( B - C ) ) / 3 ) )
zpos:zd3,zh:breqtrrd  |- ( ph -> 0 < Z )

$( Y + Z = ( _pi / 3 ) - X $)
w1:y3,z3:oveq12d  |- ( ph -> ( ( 3 x. Y ) + ( 3 x. Z ) ) = ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) )
w2:c3c,yc,zc:adddid  |- ( ph -> ( 3 x. ( Y + Z ) ) = ( ( 3 x. Y ) + ( 3 x. Z ) ) )
w3:w2,w1:eqtrd  |- ( ph -> ( 3 x. ( Y + Z ) ) = ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) )
w4:w3,x3:oveq12d  |- ( ph -> ( ( 3 x. ( Y + Z ) ) + ( 3 x. X ) ) = ( ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) + ( ( B - A ) F ( C - A ) ) ) )
yzc:yc,zc:addcld  |- ( ph -> ( Y + Z ) e. CC )
w5:c3c,yzc,xc:adddid  |- ( ph -> ( 3 x. ( ( Y + Z ) + X ) ) = ( ( 3 x. ( Y + Z ) ) + ( 3 x. X ) ) )
w6:w5,w4,gsum:3eqtrd  |- ( ph -> ( 3 x. ( ( Y + Z ) + X ) ) = _pi )
yzxc:yzc,xc:addcld  |- ( ph -> ( ( Y + Z ) + X ) e. CC )
w7:yzxc,c3c,c3n:divcan3d  |- ( ph -> ( ( 3 x. ( ( Y + Z ) + X ) ) / 3 ) = ( ( Y + Z ) + X ) )
w8:w6:oveq1d  |- ( ph -> ( ( 3 x. ( ( Y + Z ) + X ) ) / 3 ) = ( _pi / 3 ) )
w9:w7,w8:eqtr3d  |- ( ph -> ( ( Y + Z ) + X ) = ( _pi / 3 ) )
w9a:yzc,xc:addcomd  |- ( ph -> ( ( Y + Z ) + X ) = ( X + ( Y + Z ) ) )
w9b:w9,w9a:eqtr3d  |- ( ph -> ( _pi / 3 ) = ( X + ( Y + Z ) ) )
w11a:xc,yzc,w9b:mvrladdd  |- ( ph -> ( ( _pi / 3 ) - X ) = ( Y + Z ) )
w11:w11a:eqcomd  |- ( ph -> ( Y + Z ) = ( ( _pi / 3 ) - X ) )

$( Y is in ( 0 , _pi ) , so the P triangle is positively oriented $)
p3r:pir,c3r,c3n:redivcld  |- ( ph -> ( _pi / 3 ) e. RR )
yzr:yr,zr:readdcld  |- ( ph -> ( Y + Z ) e. RR )
yzg0:yr,zr,ypos,zpos:addgt0d  |- ( ph -> 0 < ( Y + Z ) )
la1::ltaddpos  |- ( ( X e. RR /\ ( Y + Z ) e. RR ) -> ( 0 < X <-> ( Y + Z ) < ( ( Y + Z ) + X ) ) )
la2:xr,yzr,la1:syl2anc  |- ( ph -> ( 0 < X <-> ( Y + Z ) < ( ( Y + Z ) + X ) ) )
la3:xpos,la2:mpbid  |- ( ph -> ( Y + Z ) < ( ( Y + Z ) + X ) )
yzlt3:la3,w9:breqtrd  |- ( ph -> ( Y + Z ) < ( _pi / 3 ) )
rp1::1rp  |- 1 e. RR+
rp1d:rp1:a1i  |- ( ph -> 1 e. RR+ )
rp3::3rp  |- 3 e. RR+
rp3d:rp3:a1i  |- ( ph -> 3 e. RR+ )
rppi:pir,pig:elrpd  |- ( ph -> _pi e. RR+ )
pigi::pipos  |- 0 < _pi
pig:pigi:a1i  |- ( ph -> 0 < _pi )
lt13a::1lt3  |- 1 < 3
lt13:lt13a:a1i  |- ( ph -> 1 < 3 )
p3lta:rp1d,rp3d,rppi:ltdiv2d  |- ( ph -> ( 1 < 3 <-> ( _pi / 3 ) < ( _pi / 1 ) ) )
p3ltb:lt13,p3lta:mpbid  |- ( ph -> ( _pi / 3 ) < ( _pi / 1 ) )
p3ltc:pic:div1d  |- ( ph -> ( _pi / 1 ) = _pi )
p3lt:p3ltb,p3ltc:breqtrd  |- ( ph -> ( _pi / 3 ) < _pi )
yzlt:yzr,p3r,pir,yzlt3,p3lt:lttrd  |- ( ph -> ( Y + Z ) < _pi )
lb1::ltaddpos  |- ( ( Z e. RR /\ Y e. RR ) -> ( 0 < Z <-> Y < ( Y + Z ) ) )
lb2:zr,yr,lb1:syl2anc  |- ( ph -> ( 0 < Z <-> Y < ( Y + Z ) ) )
lb3:zpos,lb2:mpbid  |- ( ph -> Y < ( Y + Z ) )
ylt:yr,yzr,pir,lb3,yzlt:lttrd  |- ( ph -> Y < _pi )
ym1::elioo2  |- ( ( 0 e. RR* /\ _pi e. RR* ) -> ( Y e. ( 0 (,) _pi ) <-> ( Y e. RR /\ 0 < Y /\ Y < _pi ) ) )
ym2:zx,pixr,ym1:syl2anc  |- ( ph -> ( Y e. ( 0 (,) _pi ) <-> ( Y e. RR /\ 0 < Y /\ Y < _pi ) ) )
ym3:yr,ypos,ylt:3jca  |- ( ph -> ( Y e. RR /\ 0 < Y /\ Y < _pi ) )
ymem:ym3,ym2:mpbird  |- ( ph -> Y e. ( 0 (,) _pi ) )
yiv:15,ymem:eqeltrd  |- ( ph -> ( ( C - B ) F ( P - B ) ) e. ( 0 (,) _pi ) )

$( the triangle B C P $)
cp:10:necomd  |- ( ph -> C =/= P )
q2:1,3,4,5,7,cp,9,yiv:ang180pos  |- ( ph -> ( ( ( P - C ) F ( B - C ) ) e. ( 0 (,) _pi ) /\ ( ( B - P ) F ( C - P ) ) e. ( 0 (,) _pi ) /\ ( ( ( ( P - C ) F ( B - C ) ) + ( ( B - P ) F ( C - P ) ) ) + ( ( C - B ) F ( P - B ) ) ) = _pi ) )
apio:q2:simp2d  |- ( ph -> ( ( B - P ) F ( C - P ) ) e. ( 0 (,) _pi ) )
apr:apio,eliop:syl  |- ( ph -> ( ( B - P ) F ( C - P ) ) e. RR )
apc:apr:recnd  |- ( ph -> ( ( B - P ) F ( C - P ) ) e. CC )
psum:q2:simp3d  |- ( ph -> ( ( ( ( P - C ) F ( B - C ) ) + ( ( B - P ) F ( C - P ) ) ) + ( ( C - B ) F ( P - B ) ) ) = _pi )

$( so the angle at P is _pi - ( Y + Z ) $)
u1:16,15:oveq12d  |- ( ph -> ( ( ( P - C ) F ( B - C ) ) + ( ( C - B ) F ( P - B ) ) ) = ( Z + Y ) )
u2:16:oveq1d  |- ( ph -> ( ( ( P - C ) F ( B - C ) ) + ( ( B - P ) F ( C - P ) ) ) = ( Z + ( ( B - P ) F ( C - P ) ) ) )
u3:u2,15:oveq12d  |- ( ph -> ( ( ( ( P - C ) F ( B - C ) ) + ( ( B - P ) F ( C - P ) ) ) + ( ( C - B ) F ( P - B ) ) ) = ( ( Z + ( ( B - P ) F ( C - P ) ) ) + Y ) )
u4:u3,psum:eqtr3d  |- ( ph -> ( ( Z + ( ( B - P ) F ( C - P ) ) ) + Y ) = _pi )
zapc:zc,apc:addcld  |- ( ph -> ( Z + ( ( B - P ) F ( C - P ) ) ) e. CC )
u5:zapc,yc:addcomd  |- ( ph -> ( ( Z + ( ( B - P ) F ( C - P ) ) ) + Y ) = ( Y + ( Z + ( ( B - P ) F ( C - P ) ) ) ) )
u6:yc,zc,apc:addassd  |- ( ph -> ( ( Y + Z ) + ( ( B - P ) F ( C - P ) ) ) = ( Y + ( Z + ( ( B - P ) F ( C - P ) ) ) ) )
u7:u5,u6:eqtr4d  |- ( ph -> ( ( Z + ( ( B - P ) F ( C - P ) ) ) + Y ) = ( ( Y + Z ) + ( ( B - P ) F ( C - P ) ) ) )
u7b:u4,u7:eqtr3d  |- ( ph -> _pi = ( ( Y + Z ) + ( ( B - P ) F ( C - P ) ) ) )
u7c:yzc,apc,u7b:mvrladdd  |- ( ph -> ( _pi - ( Y + Z ) ) = ( ( B - P ) F ( C - P ) ) )
u8:u7c:eqcomd  |- ( ph -> ( ( B - P ) F ( C - P ) ) = ( _pi - ( Y + Z ) ) )

$( and its sine is the sine of ( _pi / 3 ) - X $)
v1:u8:fveq2d  |- ( ph -> ( sin ` ( ( B - P ) F ( C - P ) ) ) = ( sin ` ( _pi - ( Y + Z ) ) ) )
v2a::sinpim  |- ( ( Y + Z ) e. CC -> ( sin ` ( _pi - ( Y + Z ) ) ) = ( sin ` ( Y + Z ) ) )
v2:yzc,v2a:syl  |- ( ph -> ( sin ` ( _pi - ( Y + Z ) ) ) = ( sin ` ( Y + Z ) ) )
v3:v1,v2:eqtrd  |- ( ph -> ( sin ` ( ( B - P ) F ( C - P ) ) ) = ( sin ` ( Y + Z ) ) )
v4:w11:fveq2d  |- ( ph -> ( sin ` ( Y + Z ) ) = ( sin ` ( ( _pi / 3 ) - X ) ) )
v5:v3,v4:eqtrd  |- ( ph -> ( sin ` ( ( B - P ) F ( C - P ) ) ) = ( sin ` ( ( _pi / 3 ) - X ) ) )

$( that sine is positive, hence nonzero $)
yzm1::elioo2  |- ( ( 0 e. RR* /\ _pi e. RR* ) -> ( ( Y + Z ) e. ( 0 (,) _pi ) <-> ( ( Y + Z ) e. RR /\ 0 < ( Y + Z ) /\ ( Y + Z ) < _pi ) ) )
yzm2:zx,pixr,yzm1:syl2anc  |- ( ph -> ( ( Y + Z ) e. ( 0 (,) _pi ) <-> ( ( Y + Z ) e. RR /\ 0 < ( Y + Z ) /\ ( Y + Z ) < _pi ) ) )
yzm3:yzr,yzg0,yzlt:3jca  |- ( ph -> ( ( Y + Z ) e. RR /\ 0 < ( Y + Z ) /\ ( Y + Z ) < _pi ) )
yzmem:yzm3,yzm2:mpbird  |- ( ph -> ( Y + Z ) e. ( 0 (,) _pi ) )
sp1a::sinq12gt0  |- ( ( Y + Z ) e. ( 0 (,) _pi ) -> 0 < ( sin ` ( Y + Z ) ) )
sp1:yzmem,sp1a:syl  |- ( ph -> 0 < ( sin ` ( Y + Z ) ) )
sp2:sp1,v4:breqtrd  |- ( ph -> 0 < ( sin ` ( ( _pi / 3 ) - X ) ) )
pmxr:p3r,xr:resubcld  |- ( ph -> ( ( _pi / 3 ) - X ) e. RR )
spra::resincl  |- ( ( ( _pi / 3 ) - X ) e. RR -> ( sin ` ( ( _pi / 3 ) - X ) ) e. RR )
spr:pmxr,spra:syl  |- ( ph -> ( sin ` ( ( _pi / 3 ) - X ) ) e. RR )
spc:spr:recnd  |- ( ph -> ( sin ` ( ( _pi / 3 ) - X ) ) e. CC )
spn:sp2:gt0ne0d  |- ( ph -> ( sin ` ( ( _pi / 3 ) - X ) ) =/= 0 )

$( the two law-of-sines instances $)
ec1::eqid  |- ( abs ` ( B - C ) ) = ( abs ` ( B - C ) )
ec2::eqid  |- ( abs ` ( P - C ) ) = ( abs ` ( P - C ) )
ec3::eqid  |- ( ( B - P ) F ( C - P ) ) = ( ( B - P ) F ( C - P ) )
ec4::eqid  |- ( ( C - B ) F ( P - B ) ) = ( ( C - B ) F ( P - B ) )
ec5::eqid  |- ( abs ` ( P - B ) ) = ( abs ` ( P - B ) )
ec6::eqid  |- ( abs ` ( C - B ) ) = ( abs ` ( C - B ) )
ec7::eqid  |- ( ( P - C ) F ( B - C ) ) = ( ( P - C ) F ( B - C ) )
l1s:1,ec1,ec2,ec3,ec4:lawsin  |- ( ( ( P e. CC /\ B e. CC /\ C e. CC ) /\ ( P =/= B /\ P =/= C /\ B =/= C ) ) -> ( ( abs ` ( B - C ) ) x. ( sin ` ( ( C - B ) F ( P - B ) ) ) ) = ( ( abs ` ( P - C ) ) x. ( sin ` ( ( B - P ) F ( C - P ) ) ) ) )
a1a:5,3,4:3jca  |- ( ph -> ( P e. CC /\ B e. CC /\ C e. CC ) )
a1b:9,10,7:3jca  |- ( ph -> ( P =/= B /\ P =/= C /\ B =/= C ) )
a1c:a1a,a1b:jca  |- ( ph -> ( ( P e. CC /\ B e. CC /\ C e. CC ) /\ ( P =/= B /\ P =/= C /\ B =/= C ) ) )
l1:a1c,l1s:syl  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` ( ( C - B ) F ( P - B ) ) ) ) = ( ( abs ` ( P - C ) ) x. ( sin ` ( ( B - P ) F ( C - P ) ) ) ) )
l2s:1,ec5,ec6,ec7,ec3:lawsin  |- ( ( ( C e. CC /\ P e. CC /\ B e. CC ) /\ ( C =/= P /\ C =/= B /\ P =/= B ) ) -> ( ( abs ` ( P - B ) ) x. ( sin ` ( ( B - P ) F ( C - P ) ) ) ) = ( ( abs ` ( C - B ) ) x. ( sin ` ( ( P - C ) F ( B - C ) ) ) ) )
cb:7:necomd  |- ( ph -> C =/= B )
a2a:4,5,3:3jca  |- ( ph -> ( C e. CC /\ P e. CC /\ B e. CC ) )
a2b:cp,cb,9:3jca  |- ( ph -> ( C =/= P /\ C =/= B /\ P =/= B ) )
a2c:a2a,a2b:jca  |- ( ph -> ( ( C e. CC /\ P e. CC /\ B e. CC ) /\ ( C =/= P /\ C =/= B /\ P =/= B ) ) )
l2:a2c,l2s:syl  |- ( ph -> ( ( abs ` ( P - B ) ) x. ( sin ` ( ( B - P ) F ( C - P ) ) ) ) = ( ( abs ` ( C - B ) ) x. ( sin ` ( ( P - C ) F ( B - C ) ) ) ) )

$( rewrite both with the known angles $)
m1:15:fveq2d  |- ( ph -> ( sin ` ( ( C - B ) F ( P - B ) ) ) = ( sin ` Y ) )
m2:16:fveq2d  |- ( ph -> ( sin ` ( ( P - C ) F ( B - C ) ) ) = ( sin ` Z ) )
n1:m1:oveq2d  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` ( ( C - B ) F ( P - B ) ) ) ) = ( ( abs ` ( B - C ) ) x. ( sin ` Y ) ) )
n2:v5:oveq2d  |- ( ph -> ( ( abs ` ( P - C ) ) x. ( sin ` ( ( B - P ) F ( C - P ) ) ) ) = ( ( abs ` ( P - C ) ) x. ( sin ` ( ( _pi / 3 ) - X ) ) ) )
n3a:n1,l1:eqtr3d  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` Y ) ) = ( ( abs ` ( P - C ) ) x. ( sin ` ( ( B - P ) F ( C - P ) ) ) ) )
n3:n3a,n2:eqtrd  |- ( ph -> ( ( abs ` ( B - C ) ) x. ( sin ` Y ) ) = ( ( abs ` ( P - C ) ) x. ( sin ` ( ( _pi / 3 ) - X ) ) ) )
n4:v5:oveq2d  |- ( ph -> ( ( abs ` ( P - B ) ) x. ( sin ` ( ( B - P ) F ( C - P ) ) ) ) = ( ( abs ` ( P - B ) ) x. ( sin ` ( ( _pi / 3 ) - X ) ) ) )
n5:m2:oveq2d  |- ( ph -> ( ( abs ` ( C - B ) ) x. ( sin ` ( ( P - C ) F ( B - C ) ) ) ) = ( ( abs ` ( C - B ) ) x. ( sin ` Z ) ) )
n6a:n4,l2:eqtr3d  |- ( ph -> ( ( abs ` ( P - B ) ) x. ( sin ` ( ( _pi / 3 ) - X ) ) ) = ( ( abs ` ( C - B ) ) x. ( sin ` ( ( P - C ) F ( B - C ) ) ) ) )
n6:n6a,n5:eqtrd  |- ( ph -> ( ( abs ` ( P - B ) ) x. ( sin ` ( ( _pi / 3 ) - X ) ) ) = ( ( abs ` ( C - B ) ) x. ( sin ` Z ) ) )

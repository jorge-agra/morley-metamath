$( <MM> <PROOF_ASST> THEOREM=cnrfl2  LOC_AFTER=?

$d A x
$d A y
$d B x
$d B y
$d C x
$d C y
$d x y

h1::cnrfl2.1  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::cnrfl2.a  |- ( ph -> A e. CC )
h3::cnrfl2.b  |- ( ph -> B e. CC )
h4::cnrfl2.c  |- ( ph -> C e. CC )
h5::cnrfl2.z  |- ( ph -> Z e. CC )
h6::cnrfl2.bn  |- ( ph -> B =/= A )
h7::cnrfl2.cn  |- ( ph -> C =/= A )
h8::cnrfl2.d  |- D = ( ( B - A ) / ( * ` ( B - A ) ) )
h9::cnrfl2.e  |- E = ( ( C - A ) / ( * ` ( C - A ) ) )

cU:3,2:subcld  |- ( ph -> ( B - A ) e. CC )
nU:3,2,6:subne0d  |- ( ph -> ( B - A ) =/= 0 )
cCU:cU:cjcld  |- ( ph -> ( * ` ( B - A ) ) e. CC )
nCU:cU,nU:cjne0d  |- ( ph -> ( * ` ( B - A ) ) =/= 0 )

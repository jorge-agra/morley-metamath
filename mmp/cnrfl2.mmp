cX:cD,cCZA:mulcld  |- ( ph -> ( D x. ( * ` ( Z - A ) ) ) e. CC )

$( unwinding the two reflections into one coefficient $)
i1:2,cX:pncan2d  |- ( ph -> ( ( A + ( D x. ( * ` ( Z - A ) ) ) ) - A ) = ( D x. ( * ` ( Z - A ) ) ) )
i2:i1:fveq2d  |- ( ph -> ( * ` ( ( A + ( D x. ( * ` ( Z - A ) ) ) ) - A ) ) = ( * ` ( D x. ( * ` ( Z - A ) ) ) ) )
i3:cD,cCZA:cjmuld  |- ( ph -> ( * ` ( D x. ( * ` ( Z - A ) ) ) ) = ( ( * ` D ) x. ( * ` ( * ` ( Z - A ) ) ) ) )
i4:cZA:cjcjd  |- ( ph -> ( * ` ( * ` ( Z - A ) ) ) = ( Z - A ) )
i5:i4:oveq2d  |- ( ph -> ( ( * ` D ) x. ( * ` ( * ` ( Z - A ) ) ) ) = ( ( * ` D ) x. ( Z - A ) ) )
i6:i2,i3,i5:3eqtrd  |- ( ph -> ( * ` ( ( A + ( D x. ( * ` ( Z - A ) ) ) ) - A ) ) = ( ( * ` D ) x. ( Z - A ) ) )
i7:i6:oveq2d  |- ( ph -> ( E x. ( * ` ( ( A + ( D x. ( * ` ( Z - A ) ) ) ) - A ) ) ) = ( E x. ( ( * ` D ) x. ( Z - A ) ) ) )
i8:cE,cCD,cZA:mulassd  |- ( ph -> ( ( E x. ( * ` D ) ) x. ( Z - A ) ) = ( E x. ( ( * ` D ) x. ( Z - A ) ) ) )
i9:i8:eqcomd  |- ( ph -> ( E x. ( ( * ` D ) x. ( Z - A ) ) ) = ( ( E x. ( * ` D ) ) x. ( Z - A ) ) )
i10:i7,i9:eqtrd  |- ( ph -> ( E x. ( * ` ( ( A + ( D x. ( * ` ( Z - A ) ) ) ) - A ) ) ) = ( ( E x. ( * ` D ) ) x. ( Z - A ) ) )

$( the conjugate of the first coefficient $)
e1:cU,cCU,nCU:cjdivd  |- ( ph -> ( * ` ( ( B - A ) / ( * ` ( B - A ) ) ) ) = ( ( * ` ( B - A ) ) / ( * ` ( * ` ( B - A ) ) ) ) )
e2:cU:cjcjd  |- ( ph -> ( * ` ( * ` ( B - A ) ) ) = ( B - A ) )
e3:e2:oveq2d  |- ( ph -> ( ( * ` ( B - A ) ) / ( * ` ( * ` ( B - A ) ) ) ) = ( ( * ` ( B - A ) ) / ( B - A ) ) )
e4:dD0:fveq2d  |- ( ph -> ( * ` D ) = ( * ` ( ( B - A ) / ( * ` ( B - A ) ) ) ) )
e5:e4,e1,e3:3eqtrd  |- ( ph -> ( * ` D ) = ( ( * ` ( B - A ) ) / ( B - A ) ) )

$( the composite coefficient is the doubled-angle rotation $)
f1:dE0,e5:oveq12d  |- ( ph -> ( E x. ( * ` D ) ) = ( ( ( C - A ) / ( * ` ( C - A ) ) ) x. ( ( * ` ( B - A ) ) / ( B - A ) ) ) )
f2:cV,cCV,cCU,cU,nCV,nU:divmuldivd  |- ( ph -> ( ( ( C - A ) / ( * ` ( C - A ) ) ) x. ( ( * ` ( B - A ) ) / ( B - A ) ) ) = ( ( ( C - A ) x. ( * ` ( B - A ) ) ) / ( ( * ` ( C - A ) ) x. ( B - A ) ) ) )
f3:cCV,cU:mulcomd  |- ( ph -> ( ( * ` ( C - A ) ) x. ( B - A ) ) = ( ( B - A ) x. ( * ` ( C - A ) ) ) )
f4:f3:oveq2d  |- ( ph -> ( ( ( C - A ) x. ( * ` ( B - A ) ) ) / ( ( * ` ( C - A ) ) x. ( B - A ) ) ) = ( ( ( C - A ) x. ( * ` ( B - A ) ) ) / ( ( B - A ) x. ( * ` ( C - A ) ) ) ) )
f5:f1,f2,f4:3eqtrd  |- ( ph -> ( E x. ( * ` D ) ) = ( ( ( C - A ) x. ( * ` ( B - A ) ) ) / ( ( B - A ) x. ( * ` ( C - A ) ) ) ) )

g1:1,cU,nU,cV,nV:ang2exp  |- ( ph -> ( exp ` ( _i x. ( 2 x. ( ( B - A ) F ( C - A ) ) ) ) ) = ( ( ( C - A ) / ( B - A ) ) / ( * ` ( ( C - A ) / ( B - A ) ) ) ) )
g2:cV,cU,nU:cjdivd  |- ( ph -> ( * ` ( ( C - A ) / ( B - A ) ) ) = ( ( * ` ( C - A ) ) / ( * ` ( B - A ) ) ) )
g3:g2:oveq2d  |- ( ph -> ( ( ( C - A ) / ( B - A ) ) / ( * ` ( ( C - A ) / ( B - A ) ) ) ) = ( ( ( C - A ) / ( B - A ) ) / ( ( * ` ( C - A ) ) / ( * ` ( B - A ) ) ) ) )
g4:cV,cU,cCV,cCU,nU,nCU,nCV:divdivdivd  |- ( ph -> ( ( ( C - A ) / ( B - A ) ) / ( ( * ` ( C - A ) ) / ( * ` ( B - A ) ) ) ) = ( ( ( C - A ) x. ( * ` ( B - A ) ) ) / ( ( B - A ) x. ( * ` ( C - A ) ) ) ) )
g5:g1,g3,g4:3eqtrd  |- ( ph -> ( exp ` ( _i x. ( 2 x. ( ( B - A ) F ( C - A ) ) ) ) ) = ( ( ( C - A ) x. ( * ` ( B - A ) ) ) / ( ( B - A ) x. ( * ` ( C - A ) ) ) ) )
g6:g5:eqcomd  |- ( ph -> ( ( ( C - A ) x. ( * ` ( B - A ) ) ) / ( ( B - A ) x. ( * ` ( C - A ) ) ) ) = ( exp ` ( _i x. ( 2 x. ( ( B - A ) F ( C - A ) ) ) ) ) )
g7:f5,g6:eqtrd  |- ( ph -> ( E x. ( * ` D ) ) = ( exp ` ( _i x. ( 2 x. ( ( B - A ) F ( C - A ) ) ) ) ) )
g8:g7:oveq1d  |- ( ph -> ( ( E x. ( * ` D ) ) x. ( Z - A ) ) = ( ( exp ` ( _i x. ( 2 x. ( ( B - A ) F ( C - A ) ) ) ) ) x. ( Z - A ) ) )

k10:i10,g8:eqtrd  |- ( ph -> ( E x. ( * ` ( ( A + ( D x. ( * ` ( Z - A ) ) ) ) - A ) ) ) = ( ( exp ` ( _i x. ( 2 x. ( ( B - A ) F ( C - A ) ) ) ) ) x. ( Z - A ) ) )
qed:k10:oveq2d  |- ( ph -> ( A + ( E x. ( * ` ( ( A + ( D x. ( * ` ( Z - A ) ) ) ) - A ) ) ) ) = ( A + ( ( exp ` ( _i x. ( 2 x. ( ( B - A ) F ( C - A ) ) ) ) ) x. ( Z - A ) ) ) )


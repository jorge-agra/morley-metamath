nCV:cV,nV:cjne0d  |- ( ph -> ( * ` ( C - A ) ) =/= 0 )
dD0:8:a1i  |- ( ph -> D = ( ( B - A ) / ( * ` ( B - A ) ) ) )
dE0:9:a1i  |- ( ph -> E = ( ( C - A ) / ( * ` ( C - A ) ) ) )
cQD:cU,cCU,nCU:divcld  |- ( ph -> ( ( B - A ) / ( * ` ( B - A ) ) ) e. CC )
cQE:cV,cCV,nCV:divcld  |- ( ph -> ( ( C - A ) / ( * ` ( C - A ) ) ) e. CC )
cD:dD0,cQD:eqeltrd  |- ( ph -> D e. CC )
cE:dE0,cQE:eqeltrd  |- ( ph -> E e. CC )
cCD:cD:cjcld  |- ( ph -> ( * ` D ) e. CC )
cZA:5,2:subcld  |- ( ph -> ( Z - A ) e. CC )

$( <MM> <PROOF_ASST> THEOREM=morlemang  LOC_AFTER=?

$d U x
$d U y
$d V x
$d V y
$d W x
$d W y
$d T x
$d T y
$d x y

h1::morlemang.1  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::morlemang.u  |- ( ph -> U e. CC )
h3::morlemang.un  |- ( ph -> U =/= 0 )
h4::morlemang.v  |- ( ph -> V e. CC )
h5::morlemang.vn  |- ( ph -> V =/= 0 )
h6::morlemang.w  |- ( ph -> W e. CC )
h7::morlemang.wn  |- ( ph -> W =/= 0 )
h8::morlemang.t  |- ( ph -> T e. CC )
h9::morlemang.tn  |- ( ph -> T =/= 0 )
h10::morlemang.z  |- ( ph -> Z e. RR )
h11::morlemang.uv  |- ( ph -> ( U F V ) = Z )
h12::morlemang.wt  |- ( ph -> ( W F T ) = Z )
h13::morlemang.ut  |- ( ph -> ( U F T ) = ( 3 x. Z ) )
h14::morlemang.gt  |- ( ph -> 0 < Z )
h15::morlemang.lt  |- ( ph -> ( 3 x. Z ) < _pi )

$( closures $)
ci:ac21:a1i  |- ( ph -> _i e. CC )
ac21::ax-icn  |- _i e. CC
cz:10:recnd  |- ( ph -> Z e. CC )
c2::2cnd  |- ( ph -> 2 e. CC )
c3:ac22:a1i  |- ( ph -> 3 e. CC )
ac22::3cn  |- 3 e. CC
z2r:ac24,10:remulcld  |- ( ph -> ( 2 x. Z ) e. RR )
ac24:ac23:a1i  |- ( ph -> 2 e. RR )
ac23::2re  |- 2 e. RR
z3r:ac27,10:remulcld  |- ( ph -> ( 3 x. Z ) e. RR )
ac27:ac26:a1i  |- ( ph -> 3 e. RR )
ac26::3re  |- 3 e. RR
z2c:z2r:recnd  |- ( ph -> ( 2 x. Z ) e. CC )
z3c:z3r:recnd  |- ( ph -> ( 3 x. Z ) e. CC )
mz:ci,cz:mulcld  |- ( ph -> ( _i x. Z ) e. CC )
m2z:ci,z2c:mulcld  |- ( ph -> ( _i x. ( 2 x. Z ) ) e. CC )
pr:ac29:a1i  |- ( ph -> _pi e. RR )
ac29::pire  |- _pi e. RR

$( Z and 2 Z are both in the strip $)
o1t:cz:2timesd  |- ( ph -> ( 2 x. Z ) = ( Z + Z ) )
o1x::ltaddpos  |- ( ( Z e. RR /\ Z e. RR ) -> ( 0 < Z <-> Z < ( Z + Z ) ) )
o1y:10,10,o1x:syl2anc  |- ( ph -> ( 0 < Z <-> Z < ( Z + Z ) ) )
o1z:14,o1y:mpbid  |- ( ph -> Z < ( Z + Z ) )
o1:o1z,o1t:breqtrrd  |- ( ph -> Z < ( 2 x. Z ) )
o2x::ltaddpos  |- ( ( Z e. RR /\ ( 2 x. Z ) e. RR ) -> ( 0 < Z <-> ( 2 x. Z ) < ( ( 2 x. Z ) + Z ) ) )
o2y:10,z2r,o2x:syl2anc  |- ( ph -> ( 0 < Z <-> ( 2 x. Z ) < ( ( 2 x. Z ) + Z ) ) )
o2z:14,o2y:mpbid  |- ( ph -> ( 2 x. Z ) < ( ( 2 x. Z ) + Z ) )
o2:o2z,s1:breqtrd  |- ( ph -> ( 2 x. Z ) < ( 3 x. Z ) )
o3:z2r,z3r,pr,o2,15:lttrd  |- ( ph -> ( 2 x. Z ) < _pi )
o4:10,z2r,pr,o1,o3:lttrd  |- ( ph -> Z < _pi )
o5:10,pr,o4:ltled  |- ( ph -> Z <_ _pi )
o6:z2r,pr,o3:ltled  |- ( ph -> ( 2 x. Z ) <_ _pi )
o7:ac34:a1i  |- ( ph -> -u _pi < 0 )
ac34:ac30,ac33:mpbi  |- -u _pi < 0
ac30::pipos  |- 0 < _pi
ac33:ac29,ac32:ax-mp  |- ( 0 < _pi <-> -u _pi < 0 )
ac32::lt0neg2  |- ( _pi e. RR -> ( 0 < _pi <-> -u _pi < 0 ) )
npr:pr:renegcld  |- ( ph -> -u _pi e. RR )
zre::0red  |- ( ph -> 0 e. RR )
o8:npr,zre,10,o7,14:lttrd  |- ( ph -> -u _pi < Z )
o9a:zre,10,z2r,14,o1:lttrd  |- ( ph -> 0 < ( 2 x. Z ) )
o9:npr,zre,z2r,o7,o9a:lttrd  |- ( ph -> -u _pi < ( 2 x. Z ) )
nprx:npr:rexrd  |- ( ph -> -u _pi e. RR* )
memza::elioc2  |- ( ( -u _pi e. RR* /\ _pi e. RR ) -> ( Z e. ( -u _pi (,] _pi ) <-> ( Z e. RR /\ -u _pi < Z /\ Z <_ _pi ) ) )
memzb:nprx,pr,memza:syl2anc  |- ( ph -> ( Z e. ( -u _pi (,] _pi ) <-> ( Z e. RR /\ -u _pi < Z /\ Z <_ _pi ) ) )
memzc:10,o8,o5:3jca  |- ( ph -> ( Z e. RR /\ -u _pi < Z /\ Z <_ _pi ) )
memz:memzc,memzb:mpbird  |- ( ph -> Z e. ( -u _pi (,] _pi ) )
mem2za::elioc2  |- ( ( -u _pi e. RR* /\ _pi e. RR ) -> ( ( 2 x. Z ) e. ( -u _pi (,] _pi ) <-> ( ( 2 x. Z ) e. RR /\ -u _pi < ( 2 x. Z ) /\ ( 2 x. Z ) <_ _pi ) ) )
mem2zb:nprx,pr,mem2za:syl2anc  |- ( ph -> ( ( 2 x. Z ) e. ( -u _pi (,] _pi ) <-> ( ( 2 x. Z ) e. RR /\ -u _pi < ( 2 x. Z ) /\ ( 2 x. Z ) <_ _pi ) ) )
mem2zc:z2r,o9,o6:3jca  |- ( ph -> ( ( 2 x. Z ) e. RR /\ -u _pi < ( 2 x. Z ) /\ ( 2 x. Z ) <_ _pi ) )
mem2z:mem2zc,mem2zb:mpbird  |- ( ph -> ( 2 x. Z ) e. ( -u _pi (,] _pi ) )

$( exp ( i 3 Z ) = exp ( i 2 Z ) x. exp ( i Z ) $)
s1d:ac35:a1i  |- ( ph -> ( 2 + 1 ) = 3 )
ac35::2p1e3  |- ( 2 + 1 ) = 3
s1e:s1d:oveq1d  |- ( ph -> ( ( 2 + 1 ) x. Z ) = ( 3 x. Z ) )
s1:ac41,s1e:eqtr3d  |- ( ph -> ( ( 2 x. Z ) + Z ) = ( 3 x. Z ) )
ac41:ac38,cz:adddirp1d  |- ( ph -> ( ( 2 + 1 ) x. Z ) = ( ( 2 x. Z ) + Z ) )
ac38:ac24:recnd  |- ( ph -> 2 e. CC )
s2:ci,z2c,cz:adddid  |- ( ph -> ( _i x. ( ( 2 x. Z ) + Z ) ) = ( ( _i x. ( 2 x. Z ) ) + ( _i x. Z ) ) )
s3:s1:oveq2d  |- ( ph -> ( _i x. ( ( 2 x. Z ) + Z ) ) = ( _i x. ( 3 x. Z ) ) )
s4:s2,s3:eqtr3d  |- ( ph -> ( ( _i x. ( 2 x. Z ) ) + ( _i x. Z ) ) = ( _i x. ( 3 x. Z ) ) )
s5:s4:fveq2d  |- ( ph -> ( exp ` ( ( _i x. ( 2 x. Z ) ) + ( _i x. Z ) ) ) = ( exp ` ( _i x. ( 3 x. Z ) ) ) )
s6a::efadd  |- ( ( ( _i x. ( 2 x. Z ) ) e. CC /\ ( _i x. Z ) e. CC ) -> ( exp ` ( ( _i x. ( 2 x. Z ) ) + ( _i x. Z ) ) ) = ( ( exp ` ( _i x. ( 2 x. Z ) ) ) x. ( exp ` ( _i x. Z ) ) ) )
s6:m2z,mz,s6a:syl2anc  |- ( ph -> ( exp ` ( ( _i x. ( 2 x. Z ) ) + ( _i x. Z ) ) ) = ( ( exp ` ( _i x. ( 2 x. Z ) ) ) x. ( exp ` ( _i x. Z ) ) ) )
s7:s5,s6:eqtr3d  |- ( ph -> ( exp ` ( _i x. ( 3 x. Z ) ) ) = ( ( exp ` ( _i x. ( 2 x. Z ) ) ) x. ( exp ` ( _i x. Z ) ) ) )

$( exp ( i 2 Z ) = exp ( i Z ) x. exp ( i Z ) $)
t1:cz:2timesd  |- ( ph -> ( 2 x. Z ) = ( Z + Z ) )
t2:t1:oveq2d  |- ( ph -> ( _i x. ( 2 x. Z ) ) = ( _i x. ( Z + Z ) ) )
t3:ci,cz,cz:adddid  |- ( ph -> ( _i x. ( Z + Z ) ) = ( ( _i x. Z ) + ( _i x. Z ) ) )
t4:t2,t3:eqtrd  |- ( ph -> ( _i x. ( 2 x. Z ) ) = ( ( _i x. Z ) + ( _i x. Z ) ) )
t5:t4:fveq2d  |- ( ph -> ( exp ` ( _i x. ( 2 x. Z ) ) ) = ( exp ` ( ( _i x. Z ) + ( _i x. Z ) ) ) )
t6a::efadd  |- ( ( ( _i x. Z ) e. CC /\ ( _i x. Z ) e. CC ) -> ( exp ` ( ( _i x. Z ) + ( _i x. Z ) ) ) = ( ( exp ` ( _i x. Z ) ) x. ( exp ` ( _i x. Z ) ) ) )
t6:mz,mz,t6a:syl2anc  |- ( ph -> ( exp ` ( ( _i x. Z ) + ( _i x. Z ) ) ) = ( ( exp ` ( _i x. Z ) ) x. ( exp ` ( _i x. Z ) ) ) )
t7:t5,t6:eqtrd  |- ( ph -> ( exp ` ( _i x. ( 2 x. Z ) ) ) = ( ( exp ` ( _i x. Z ) ) x. ( exp ` ( _i x. Z ) ) ) )

$( exp ( i Z ) is a nonzero complex number $)
ez:mz:efcld  |- ( ph -> ( exp ` ( _i x. Z ) ) e. CC )
ezna::efne0  |- ( ( _i x. Z ) e. CC -> ( exp ` ( _i x. Z ) ) =/= 0 )
ezn:mz,ezna:syl  |- ( ph -> ( exp ` ( _i x. Z ) ) =/= 0 )
e2z:m2z:efcld  |- ( ph -> ( exp ` ( _i x. ( 2 x. Z ) ) ) e. CC )

$( first pass : the angle from U to W is 2 Z $)
e1:1,2,3,6,7,8,9:angexpadd  |- ( ph -> ( ( exp ` ( _i x. ( U F W ) ) ) x. ( exp ` ( _i x. ( W F T ) ) ) ) = ( exp ` ( _i x. ( U F T ) ) ) )
e2:12:oveq2d  |- ( ph -> ( _i x. ( W F T ) ) = ( _i x. Z ) )
e3:e2:fveq2d  |- ( ph -> ( exp ` ( _i x. ( W F T ) ) ) = ( exp ` ( _i x. Z ) ) )
e4:13:oveq2d  |- ( ph -> ( _i x. ( U F T ) ) = ( _i x. ( 3 x. Z ) ) )
e5:e4:fveq2d  |- ( ph -> ( exp ` ( _i x. ( U F T ) ) ) = ( exp ` ( _i x. ( 3 x. Z ) ) ) )
e6:e3:oveq2d  |- ( ph -> ( ( exp ` ( _i x. ( U F W ) ) ) x. ( exp ` ( _i x. ( W F T ) ) ) ) = ( ( exp ` ( _i x. ( U F W ) ) ) x. ( exp ` ( _i x. Z ) ) ) )
e7a:e6,e1:eqtr3d  |- ( ph -> ( ( exp ` ( _i x. ( U F W ) ) ) x. ( exp ` ( _i x. Z ) ) ) = ( exp ` ( _i x. ( U F T ) ) ) )
e7:e7a,e5:eqtrd  |- ( ph -> ( ( exp ` ( _i x. ( U F W ) ) ) x. ( exp ` ( _i x. Z ) ) ) = ( exp ` ( _i x. ( 3 x. Z ) ) ) )
e8:e7,s7:eqtrd  |- ( ph -> ( ( exp ` ( _i x. ( U F W ) ) ) x. ( exp ` ( _i x. Z ) ) ) = ( ( exp ` ( _i x. ( 2 x. Z ) ) ) x. ( exp ` ( _i x. Z ) ) ) )
ssre::negpitopissre  |- ( -u _pi (,] _pi ) C_ RR
ssrd:ssre:a1i  |- ( ph -> ( -u _pi (,] _pi ) C_ RR )
euwa:1,2,3,6,7:angcld  |- ( ph -> ( U F W ) e. ( -u _pi (,] _pi ) )
euwd:ssrd,euwa:sseldd  |- ( ph -> ( U F W ) e. RR )
euwe:euwd:recnd  |- ( ph -> ( U F W ) e. CC )
euwf:ci,euwe:mulcld  |- ( ph -> ( _i x. ( U F W ) ) e. CC )
euw:euwf:efcld  |- ( ph -> ( exp ` ( _i x. ( U F W ) ) ) e. CC )
e9:euw,e2z,ez,ezn,e8:mulcan2ad  |- ( ph -> ( exp ` ( _i x. ( U F W ) ) ) = ( exp ` ( _i x. ( 2 x. Z ) ) ) )
e10:1,2,3,6,7,z2r,mem2z,e9:angeqd  |- ( ph -> ( U F W ) = ( 2 x. Z ) )

$( second pass : the angle from V to W is Z $)
f1:1,2,3,4,5,6,7:angexpadd  |- ( ph -> ( ( exp ` ( _i x. ( U F V ) ) ) x. ( exp ` ( _i x. ( V F W ) ) ) ) = ( exp ` ( _i x. ( U F W ) ) ) )
f2:11:oveq2d  |- ( ph -> ( _i x. ( U F V ) ) = ( _i x. Z ) )
f3:f2:fveq2d  |- ( ph -> ( exp ` ( _i x. ( U F V ) ) ) = ( exp ` ( _i x. Z ) ) )
f4:f3:oveq1d  |- ( ph -> ( ( exp ` ( _i x. ( U F V ) ) ) x. ( exp ` ( _i x. ( V F W ) ) ) ) = ( ( exp ` ( _i x. Z ) ) x. ( exp ` ( _i x. ( V F W ) ) ) ) )
f5:e10:oveq2d  |- ( ph -> ( _i x. ( U F W ) ) = ( _i x. ( 2 x. Z ) ) )
f6:f5:fveq2d  |- ( ph -> ( exp ` ( _i x. ( U F W ) ) ) = ( exp ` ( _i x. ( 2 x. Z ) ) ) )
f7a:f4,f1:eqtr3d  |- ( ph -> ( ( exp ` ( _i x. Z ) ) x. ( exp ` ( _i x. ( V F W ) ) ) ) = ( exp ` ( _i x. ( U F W ) ) ) )
f7:f7a,f6:eqtrd  |- ( ph -> ( ( exp ` ( _i x. Z ) ) x. ( exp ` ( _i x. ( V F W ) ) ) ) = ( exp ` ( _i x. ( 2 x. Z ) ) ) )
f8:f7,t7:eqtrd  |- ( ph -> ( ( exp ` ( _i x. Z ) ) x. ( exp ` ( _i x. ( V F W ) ) ) ) = ( ( exp ` ( _i x. Z ) ) x. ( exp ` ( _i x. Z ) ) ) )
evwa:1,4,5,6,7:angcld  |- ( ph -> ( V F W ) e. ( -u _pi (,] _pi ) )
evwd:ssrd,evwa:sseldd  |- ( ph -> ( V F W ) e. RR )
evwe:evwd:recnd  |- ( ph -> ( V F W ) e. CC )
evwf:ci,evwe:mulcld  |- ( ph -> ( _i x. ( V F W ) ) e. CC )
evw:evwf:efcld  |- ( ph -> ( exp ` ( _i x. ( V F W ) ) ) e. CC )
f9:evw,ez,ez,ezn,f8:mulcanad  |- ( ph -> ( exp ` ( _i x. ( V F W ) ) ) = ( exp ` ( _i x. Z ) ) )

qed:1,4,5,6,7,10,memz,f9:angeqd  |- ( ph -> ( V F W ) = Z )

$)

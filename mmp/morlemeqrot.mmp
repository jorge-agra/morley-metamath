$( <MM> <PROOF_ASST> THEOREM=morlemeqrot  LOC_AFTER=?
$( For a cube root of unity ` J ` , the relation ` ( ( U + ( J x. V ) ) + ( ( J
   ^ 2 ) x. W ) ) = 0 ` is preserved when ` U ` , ` V ` , ` W ` are replaced by
   ` W ` , ` U ` , ` V ` . $)

h1::morlemeqrot.u  |- ( ph -> U e. CC )
h2::morlemeqrot.v  |- ( ph -> V e. CC )
h3::morlemeqrot.w  |- ( ph -> W e. CC )
h4::morlemeqrot.j  |- ( ph -> J e. CC )
h5::morlemeqrot.1  |- ( ph -> ( J ^ 3 ) = 1 )
h6::morlemeqrot.2  |- ( ph -> ( ( U + ( J x. V ) ) + ( ( J ^ 2 ) x. W ) ) = 0 )

$( closures $)
k1:4,2:mulcld  |- ( ph -> ( J x. V ) e. CC )
k2:4:sqcld  |- ( ph -> ( J ^ 2 ) e. CC )
k3:k2,3:mulcld  |- ( ph -> ( ( J ^ 2 ) x. W ) e. CC )
k4:1,k1:addcld  |- ( ph -> ( U + ( J x. V ) ) e. CC )
k5:4,1:mulcld  |- ( ph -> ( J x. U ) e. CC )
k6:k2,2:mulcld  |- ( ph -> ( ( J ^ 2 ) x. V ) e. CC )

$( multiply the relation by J $)
t1:6:oveq2d  |- ( ph -> ( J x. ( ( U + ( J x. V ) ) + ( ( J ^ 2 ) x. W ) ) ) = ( J x. 0 ) )
t2:4:mul01d  |- ( ph -> ( J x. 0 ) = 0 )
t3:t1,t2:eqtrd  |- ( ph -> ( J x. ( ( U + ( J x. V ) ) + ( ( J ^ 2 ) x. W ) ) ) = 0 )
t4:4,k4,k3:adddid  |- ( ph -> ( J x. ( ( U + ( J x. V ) ) + ( ( J ^ 2 ) x. W ) ) ) = ( ( J x. ( U + ( J x. V ) ) ) + ( J x. ( ( J ^ 2 ) x. W ) ) ) )

$( the first half: J x. ( J x. V ) is ( J ^ 2 ) x. V $)
t5:4,1,k1:adddid  |- ( ph -> ( J x. ( U + ( J x. V ) ) ) = ( ( J x. U ) + ( J x. ( J x. V ) ) ) )
t6:4,4,2:mulassd  |- ( ph -> ( ( J x. J ) x. V ) = ( J x. ( J x. V ) ) )
t7:4:sqvald  |- ( ph -> ( J ^ 2 ) = ( J x. J ) )
t8:t7:oveq1d  |- ( ph -> ( ( J ^ 2 ) x. V ) = ( ( J x. J ) x. V ) )
t9:t8,t6:eqtrd  |- ( ph -> ( ( J ^ 2 ) x. V ) = ( J x. ( J x. V ) ) )
t10:t9:eqcomd  |- ( ph -> ( J x. ( J x. V ) ) = ( ( J ^ 2 ) x. V ) )
t11:t10:oveq2d  |- ( ph -> ( ( J x. U ) + ( J x. ( J x. V ) ) ) = ( ( J x. U ) + ( ( J ^ 2 ) x. V ) ) )
t12:t5,t11:eqtrd  |- ( ph -> ( J x. ( U + ( J x. V ) ) ) = ( ( J x. U ) + ( ( J ^ 2 ) x. V ) ) )

$( the second half: J x. ( J ^ 2 ) is ( J ^ 3 ) , which is 1 $)
n2a::2nn0  |- 2 e. NN0
n2:n2a:a1i  |- ( ph -> 2 e. NN0 )
q1:4,n2:expp1d  |- ( ph -> ( J ^ ( 2 + 1 ) ) = ( ( J ^ 2 ) x. J ) )
q2a::2p1e3  |- ( 2 + 1 ) = 3
q2b:q2a:oveq2i  |- ( J ^ ( 2 + 1 ) ) = ( J ^ 3 )
q2:q2b:a1i  |- ( ph -> ( J ^ ( 2 + 1 ) ) = ( J ^ 3 ) )
q3:q2,q1:eqtr3d  |- ( ph -> ( J ^ 3 ) = ( ( J ^ 2 ) x. J ) )
u1:4,k2,3:mulassd  |- ( ph -> ( ( J x. ( J ^ 2 ) ) x. W ) = ( J x. ( ( J ^ 2 ) x. W ) ) )
u2a:4,k2:mulcomd  |- ( ph -> ( J x. ( J ^ 2 ) ) = ( ( J ^ 2 ) x. J ) )
u2:u2a,q3:eqtr4d  |- ( ph -> ( J x. ( J ^ 2 ) ) = ( J ^ 3 ) )
u3:u2,5:eqtrd  |- ( ph -> ( J x. ( J ^ 2 ) ) = 1 )
u4:u3:oveq1d  |- ( ph -> ( ( J x. ( J ^ 2 ) ) x. W ) = ( 1 x. W ) )
u5:3:mullidd  |- ( ph -> ( 1 x. W ) = W )
u6:u4,u5:eqtrd  |- ( ph -> ( ( J x. ( J ^ 2 ) ) x. W ) = W )
u7:u1,u6:eqtr3d  |- ( ph -> ( J x. ( ( J ^ 2 ) x. W ) ) = W )

$( collect, and rotate the sum $)
v1:t12,u7:oveq12d  |- ( ph -> ( ( J x. ( U + ( J x. V ) ) ) + ( J x. ( ( J ^ 2 ) x. W ) ) ) = ( ( ( J x. U ) + ( ( J ^ 2 ) x. V ) ) + W ) )
v2:t4,v1:eqtrd  |- ( ph -> ( J x. ( ( U + ( J x. V ) ) + ( ( J ^ 2 ) x. W ) ) ) = ( ( ( J x. U ) + ( ( J ^ 2 ) x. V ) ) + W ) )
v3:v2,t3:eqtr3d  |- ( ph -> ( ( ( J x. U ) + ( ( J ^ 2 ) x. V ) ) + W ) = 0 )
w1:k5,k6,3:add32d  |- ( ph -> ( ( ( J x. U ) + ( ( J ^ 2 ) x. V ) ) + W ) = ( ( ( J x. U ) + W ) + ( ( J ^ 2 ) x. V ) ) )
w2:k5,3:addcomd  |- ( ph -> ( ( J x. U ) + W ) = ( W + ( J x. U ) ) )
w3:w2:oveq1d  |- ( ph -> ( ( ( J x. U ) + W ) + ( ( J ^ 2 ) x. V ) ) = ( ( W + ( J x. U ) ) + ( ( J ^ 2 ) x. V ) ) )
w4:w1,w3:eqtrd  |- ( ph -> ( ( ( J x. U ) + ( ( J ^ 2 ) x. V ) ) + W ) = ( ( W + ( J x. U ) ) + ( ( J ^ 2 ) x. V ) ) )
qed:w4,v3:eqtr3d  |- ( ph -> ( ( W + ( J x. U ) ) + ( ( J ^ 2 ) x. V ) ) = 0 )

$)

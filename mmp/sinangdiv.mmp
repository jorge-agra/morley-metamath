$( <MM> <PROOF_ASST> THEOREM=sinangdiv  LOC_AFTER=?

$d A x
$d A y
$d B x
$d B y
$d x y

h1::sinang.1  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )

d1::simpll  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> A e. CC )
d2::simplr  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> A =/= 0 )
d3::simprl  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> B e. CC )
d4::simprr  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> B =/= 0 )
d5:1:sinang  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( sin ` ( A F B ) ) = ( Im ` ( ( B / A ) / ( abs ` ( B / A ) ) ) ) )
d6:d3,d1,d2:divcld  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B / A ) e. CC )
d7:d3,d1,d4,d2:divne0d  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( B / A ) =/= 0 )
d8:d6:abscld  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( B / A ) ) e. RR )
d9:d6,d7:absne0d  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( B / A ) ) =/= 0 )
d10:d8,d6,d9:imdivd  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( Im ` ( ( B / A ) / ( abs ` ( B / A ) ) ) ) = ( ( Im ` ( B / A ) ) / ( abs ` ( B / A ) ) ) )
qed:d5,d10:eqtrd  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( sin ` ( A F B ) ) = ( ( Im ` ( B / A ) ) / ( abs ` ( B / A ) ) ) )

$)

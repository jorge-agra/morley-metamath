$( <MM> <PROOF_ASST> THEOREM=angeqd  LOC_AFTER=?

$d A x
$d A y
$d B x
$d B y
$d x y

h1::angeqd.1  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::angeqd.a  |- ( ph -> A e. CC )
h3::angeqd.an  |- ( ph -> A =/= 0 )
h4::angeqd.b  |- ( ph -> B e. CC )
h5::angeqd.bn  |- ( ph -> B =/= 0 )
h6::angeqd.s  |- ( ph -> S e. RR )
h7::angeqd.2  |- ( ph -> S e. ( -u _pi (,] _pi ) )
h8::angeqd.3  |- ( ph -> ( exp ` ( _i x. ( A F B ) ) ) = ( exp ` ( _i x. S ) ) )

r1:1,2,3,4,5:angcld  |- ( ph -> ( A F B ) e. ( -u _pi (,] _pi ) )
r2a::negpitopissre  |- ( -u _pi (,] _pi ) C_ RR
r2:r2a:a1i  |- ( ph -> ( -u _pi (,] _pi ) C_ RR )
r3:r2,r1:sseldd  |- ( ph -> ( A F B ) e. RR )

qed:r3,6,r1,7,8:efi11d  |- ( ph -> ( A F B ) = S )

$= wph cA cB cF co cS wph cpi cneg cpi cioc co cr cA cB cF co cpi cneg cpi cioc co cr wss wph negpitopissre a1i wph vx vy cF cA cB angeqd.1 angeqd.a angeqd.an angeqd.b angeqd.bn angcld sseldd angeqd.s wph vx vy cF cA cB angeqd.1 angeqd.a angeqd.an angeqd.b angeqd.bn angcld angeqd.2 angeqd.3 efi11d $.
$)

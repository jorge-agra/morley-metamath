$( <MM> <PROOF_ASST> THEOREM=sinaddsub  LOC_AFTER=?

$( closures $)
c1::simpl  |- ( ( A e. CC /\ B e. CC ) -> A e. CC )
c2::simpr  |- ( ( A e. CC /\ B e. CC ) -> B e. CC )
ac1::sincl  |- ( A e. CC -> ( sin ` A ) e. CC )
s1:ac1:adantr  |- ( ( A e. CC /\ B e. CC ) -> ( sin ` A ) e. CC )
ac2::sincl  |- ( B e. CC -> ( sin ` B ) e. CC )
s2:ac2:adantl  |- ( ( A e. CC /\ B e. CC ) -> ( sin ` B ) e. CC )
ac3::coscl  |- ( A e. CC -> ( cos ` A ) e. CC )
k1:ac3:adantr  |- ( ( A e. CC /\ B e. CC ) -> ( cos ` A ) e. CC )
ac4::coscl  |- ( B e. CC -> ( cos ` B ) e. CC )
k2:ac4:adantl  |- ( ( A e. CC /\ B e. CC ) -> ( cos ` B ) e. CC )
m1:s1,k2:mulcld  |- ( ( A e. CC /\ B e. CC ) -> ( ( sin ` A ) x. ( cos ` B ) ) e. CC )
m2:k1,s2:mulcld  |- ( ( A e. CC /\ B e. CC ) -> ( ( cos ` A ) x. ( sin ` B ) ) e. CC )
n1:s1:sqcld  |- ( ( A e. CC /\ B e. CC ) -> ( ( sin ` A ) ^ 2 ) e. CC )
n2:s2:sqcld  |- ( ( A e. CC /\ B e. CC ) -> ( ( sin ` B ) ^ 2 ) e. CC )
nk1:k1:sqcld  |- ( ( A e. CC /\ B e. CC ) -> ( ( cos ` A ) ^ 2 ) e. CC )
nk2:k2:sqcld  |- ( ( A e. CC /\ B e. CC ) -> ( ( cos ` B ) ^ 2 ) e. CC )
n3:n1,n2:mulcld  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) e. CC )

$( the two sum formulas, multiplied out by the difference of squares $)
p1::sinadd  |- ( ( A e. CC /\ B e. CC ) -> ( sin ` ( A + B ) ) = ( ( ( sin ` A ) x. ( cos ` B ) ) + ( ( cos ` A ) x. ( sin ` B ) ) ) )
p2::sinsub  |- ( ( A e. CC /\ B e. CC ) -> ( sin ` ( A - B ) ) = ( ( ( sin ` A ) x. ( cos ` B ) ) - ( ( cos ` A ) x. ( sin ` B ) ) ) )
p3:p1,p2:oveq12d  |- ( ( A e. CC /\ B e. CC ) -> ( ( sin ` ( A + B ) ) x. ( sin ` ( A - B ) ) ) = ( ( ( ( sin ` A ) x. ( cos ` B ) ) + ( ( cos ` A ) x. ( sin ` B ) ) ) x. ( ( ( sin ` A ) x. ( cos ` B ) ) - ( ( cos ` A ) x. ( sin ` B ) ) ) ) )
p4a::subsq  |- ( ( ( ( sin ` A ) x. ( cos ` B ) ) e. CC /\ ( ( cos ` A ) x. ( sin ` B ) ) e. CC ) -> ( ( ( ( sin ` A ) x. ( cos ` B ) ) ^ 2 ) - ( ( ( cos ` A ) x. ( sin ` B ) ) ^ 2 ) ) = ( ( ( ( sin ` A ) x. ( cos ` B ) ) + ( ( cos ` A ) x. ( sin ` B ) ) ) x. ( ( ( sin ` A ) x. ( cos ` B ) ) - ( ( cos ` A ) x. ( sin ` B ) ) ) ) )
p4:m1,m2,p4a:syl2anc  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( ( sin ` A ) x. ( cos ` B ) ) ^ 2 ) - ( ( ( cos ` A ) x. ( sin ` B ) ) ^ 2 ) ) = ( ( ( ( sin ` A ) x. ( cos ` B ) ) + ( ( cos ` A ) x. ( sin ` B ) ) ) x. ( ( ( sin ` A ) x. ( cos ` B ) ) - ( ( cos ` A ) x. ( sin ` B ) ) ) ) )
p5:p3,p4:eqtr4d  |- ( ( A e. CC /\ B e. CC ) -> ( ( sin ` ( A + B ) ) x. ( sin ` ( A - B ) ) ) = ( ( ( ( sin ` A ) x. ( cos ` B ) ) ^ 2 ) - ( ( ( cos ` A ) x. ( sin ` B ) ) ^ 2 ) ) )

$( the squares split $)
p6:s1,k2:sqmuld  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` A ) x. ( cos ` B ) ) ^ 2 ) = ( ( ( sin ` A ) ^ 2 ) x. ( ( cos ` B ) ^ 2 ) ) )
p7:k1,s2:sqmuld  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( cos ` A ) x. ( sin ` B ) ) ^ 2 ) = ( ( ( cos ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) )

$( cos ^ 2 = 1 - sin ^ 2 at both arguments $)
q1a::sincossq  |- ( B e. CC -> ( ( ( sin ` B ) ^ 2 ) + ( ( cos ` B ) ^ 2 ) ) = 1 )
q1:c2,q1a:syl  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` B ) ^ 2 ) + ( ( cos ` B ) ^ 2 ) ) = 1 )
q2:n2,nk2,q1:mvlladdd  |- ( ( A e. CC /\ B e. CC ) -> ( ( cos ` B ) ^ 2 ) = ( 1 - ( ( sin ` B ) ^ 2 ) ) )
q3a::sincossq  |- ( A e. CC -> ( ( ( sin ` A ) ^ 2 ) + ( ( cos ` A ) ^ 2 ) ) = 1 )
q3:c1,q3a:syl  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` A ) ^ 2 ) + ( ( cos ` A ) ^ 2 ) ) = 1 )
q4:n1,nk1,q3:mvlladdd  |- ( ( A e. CC /\ B e. CC ) -> ( ( cos ` A ) ^ 2 ) = ( 1 - ( ( sin ` A ) ^ 2 ) ) )

$( substitute and collapse $)
r1:q2:oveq2d  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` A ) ^ 2 ) x. ( ( cos ` B ) ^ 2 ) ) = ( ( ( sin ` A ) ^ 2 ) x. ( 1 - ( ( sin ` B ) ^ 2 ) ) ) )
r2:q4:oveq1d  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( cos ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) = ( ( 1 - ( ( sin ` A ) ^ 2 ) ) x. ( ( sin ` B ) ^ 2 ) ) )
r3e:n1,n2:eqidd  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) = ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) )
r3:n1,n2,r3e:morlemone  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` A ) ^ 2 ) x. ( 1 - ( ( sin ` B ) ^ 2 ) ) ) = ( ( ( sin ` A ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) )
r4e:n2,n1:mulcomd  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` B ) ^ 2 ) x. ( ( sin ` A ) ^ 2 ) ) = ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) )
r4a:n2,n1,r4e:morlemone  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` B ) ^ 2 ) x. ( 1 - ( ( sin ` A ) ^ 2 ) ) ) = ( ( ( sin ` B ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) )
o1c::1cnd  |- ( ( A e. CC /\ B e. CC ) -> 1 e. CC )
o1:o1c,n1:subcld  |- ( ( A e. CC /\ B e. CC ) -> ( 1 - ( ( sin ` A ) ^ 2 ) ) e. CC )
r4b:o1,n2:mulcomd  |- ( ( A e. CC /\ B e. CC ) -> ( ( 1 - ( ( sin ` A ) ^ 2 ) ) x. ( ( sin ` B ) ^ 2 ) ) = ( ( ( sin ` B ) ^ 2 ) x. ( 1 - ( ( sin ` A ) ^ 2 ) ) ) )
r4:r4b,r4a:eqtrd  |- ( ( A e. CC /\ B e. CC ) -> ( ( 1 - ( ( sin ` A ) ^ 2 ) ) x. ( ( sin ` B ) ^ 2 ) ) = ( ( ( sin ` B ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) )
r5a::nnncan2  |- ( ( ( ( sin ` A ) ^ 2 ) e. CC /\ ( ( sin ` B ) ^ 2 ) e. CC /\ ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) e. CC ) -> ( ( ( ( sin ` A ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) - ( ( ( sin ` B ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) ) = ( ( ( sin ` A ) ^ 2 ) - ( ( sin ` B ) ^ 2 ) ) )
r5:n1,n2,n3,r5a:syl3anc  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( ( sin ` A ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) - ( ( ( sin ` B ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) ) = ( ( ( sin ` A ) ^ 2 ) - ( ( sin ` B ) ^ 2 ) ) )

t1:p6,r1,r3:3eqtrd  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( sin ` A ) x. ( cos ` B ) ) ^ 2 ) = ( ( ( sin ` A ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) )
t2:p7,r2,r4:3eqtrd  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( cos ` A ) x. ( sin ` B ) ) ^ 2 ) = ( ( ( sin ` B ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) )
t3:t1,t2:oveq12d  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( ( sin ` A ) x. ( cos ` B ) ) ^ 2 ) - ( ( ( cos ` A ) x. ( sin ` B ) ) ^ 2 ) ) = ( ( ( ( sin ` A ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) - ( ( ( sin ` B ) ^ 2 ) - ( ( ( sin ` A ) ^ 2 ) x. ( ( sin ` B ) ^ 2 ) ) ) ) )
t4:t3,r5:eqtrd  |- ( ( A e. CC /\ B e. CC ) -> ( ( ( ( sin ` A ) x. ( cos ` B ) ) ^ 2 ) - ( ( ( cos ` A ) x. ( sin ` B ) ) ^ 2 ) ) = ( ( ( sin ` A ) ^ 2 ) - ( ( sin ` B ) ^ 2 ) ) )

qed:p5,t4:eqtrd  |- ( ( A e. CC /\ B e. CC ) -> ( ( sin ` ( A + B ) ) x. ( sin ` ( A - B ) ) ) = ( ( ( sin ` A ) ^ 2 ) - ( ( sin ` B ) ^ 2 ) ) )

$)

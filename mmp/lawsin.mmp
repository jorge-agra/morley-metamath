$( <MM> <PROOF_ASST> THEOREM=lawsin  LOC_AFTER=?

$d A x
$d A y
$d B x
$d B y
$d C x
$d C y
$d x y

h1::lawsin.1  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::lawsin.2  |- X = ( abs ` ( B - C ) )
h3::lawsin.3  |- Y = ( abs ` ( A - C ) )
h4::lawsin.4  |- O = ( ( B - A ) F ( C - A ) )
h5::lawsin.5  |- P = ( ( C - B ) F ( A - B ) )

$( vertices $)
abc::simpl  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( A e. CC /\ B e. CC /\ C e. CC ) )
dA:abc:simp1d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> A e. CC )
dB:abc:simp2d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> B e. CC )
dC:abc:simp3d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> C e. CC )

$( side vectors: closure and nonzero $)
ls::lawsinside  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( ( ( B - A ) e. CC /\ ( B - A ) =/= 0 ) /\ ( ( C - A ) e. CC /\ ( C - A ) =/= 0 ) ) /\ ( ( ( C - B ) e. CC /\ ( C - B ) =/= 0 ) /\ ( ( A - B ) e. CC /\ ( A - B ) =/= 0 ) ) ) )
lsO:ls:simpld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( ( B - A ) e. CC /\ ( B - A ) =/= 0 ) /\ ( ( C - A ) e. CC /\ ( C - A ) =/= 0 ) ) )
lsP:ls:simprd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( ( C - B ) e. CC /\ ( C - B ) =/= 0 ) /\ ( ( A - B ) e. CC /\ ( A - B ) =/= 0 ) ) )
lsO1:lsO:simpld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( B - A ) e. CC /\ ( B - A ) =/= 0 ) )
lsO2:lsO:simprd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( C - A ) e. CC /\ ( C - A ) =/= 0 ) )
lsP1:lsP:simpld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( C - B ) e. CC /\ ( C - B ) =/= 0 ) )
lsP2:lsP:simprd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( A - B ) e. CC /\ ( A - B ) =/= 0 ) )
cBA:lsO1:simpld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( B - A ) e. CC )
nBA:lsO1:simprd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( B - A ) =/= 0 )
cCA:lsO2:simpld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( C - A ) e. CC )
nCA:lsO2:simprd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( C - A ) =/= 0 )
cCB:lsP1:simpld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( C - B ) e. CC )
nCB:lsP1:simprd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( C - B ) =/= 0 )
cAB:lsP2:simpld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( A - B ) e. CC )
nAB:lsP2:simprd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( A - B ) =/= 0 )

$( side lengths $)
aBA:cBA:abscld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( B - A ) ) e. RR )
qBA:aBA:recnd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( B - A ) ) e. CC )
zBA:cBA,nBA:absne0d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( B - A ) ) =/= 0 )
aCA:cCA:abscld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( C - A ) ) e. RR )
qCA:aCA:recnd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( C - A ) ) e. CC )
zCA:cCA,nCA:absne0d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( C - A ) ) =/= 0 )
aCB:cCB:abscld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( C - B ) ) e. RR )
qCB:aCB:recnd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( C - B ) ) e. CC )
zCB:cCB,nCB:absne0d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( C - B ) ) =/= 0 )
aAB:cAB:abscld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( A - B ) ) e. RR )
qAB:aAB:recnd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( A - B ) ) e. CC )
zAB:cAB,nAB:absne0d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( A - B ) ) =/= 0 )

$( twice the signed area, at each vertex $)
jO:cBA:cjcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( * ` ( B - A ) ) e. CC )
mO:jO,cCA:mulcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( * ` ( B - A ) ) x. ( C - A ) ) e. CC )
rO:mO:imcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) e. RR )
qO:rO:recnd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) e. CC )
jP:cCB:cjcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( * ` ( C - B ) ) e. CC )
mP:jP,cAB:mulcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( * ` ( C - B ) ) x. ( A - B ) ) e. CC )
rP:mP:imcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) e. RR )
qP:rP:recnd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) e. CC )

$( the two angle sines $)
saO0:1:sinangarea  |- ( ( ( ( B - A ) e. CC /\ ( B - A ) =/= 0 ) /\ ( ( C - A ) e. CC /\ ( C - A ) =/= 0 ) ) -> ( sin ` ( ( B - A ) F ( C - A ) ) ) = ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( B - A ) ) x. ( abs ` ( C - A ) ) ) ) )
saO:lsO,saO0:syl  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( sin ` ( ( B - A ) F ( C - A ) ) ) = ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( B - A ) ) x. ( abs ` ( C - A ) ) ) ) )
oO:4:fveq2i  |- ( sin ` O ) = ( sin ` ( ( B - A ) F ( C - A ) ) )
sinO:oO,saO:eqtrid  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( sin ` O ) = ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( B - A ) ) x. ( abs ` ( C - A ) ) ) ) )
saP0:1:sinangarea  |- ( ( ( ( C - B ) e. CC /\ ( C - B ) =/= 0 ) /\ ( ( A - B ) e. CC /\ ( A - B ) =/= 0 ) ) -> ( sin ` ( ( C - B ) F ( A - B ) ) ) = ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( ( abs ` ( C - B ) ) x. ( abs ` ( A - B ) ) ) ) )
saP:lsP,saP0:syl  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( sin ` ( ( C - B ) F ( A - B ) ) ) = ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( ( abs ` ( C - B ) ) x. ( abs ` ( A - B ) ) ) ) )
oP:5:fveq2i  |- ( sin ` P ) = ( sin ` ( ( C - B ) F ( A - B ) ) )
sinP:oP,saP:eqtrid  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( sin ` P ) = ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( ( abs ` ( C - B ) ) x. ( abs ` ( A - B ) ) ) ) )

$( the two side lengths, in cyclic orientation $)
xv:2:a1i  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> X = ( abs ` ( B - C ) ) )
xa:dB,dC:abssubd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( B - C ) ) = ( abs ` ( C - B ) ) )
xX:xv,xa:eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> X = ( abs ` ( C - B ) ) )
yv:3:a1i  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> Y = ( abs ` ( A - C ) ) )
ya:dA,dC:abssubd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( A - C ) ) = ( abs ` ( C - A ) ) )
yY:yv,ya:eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> Y = ( abs ` ( C - A ) ) )

$( left-hand side: cancel the shared side length $)
L1:xX,sinP:oveq12d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( X x. ( sin ` P ) ) = ( ( abs ` ( C - B ) ) x. ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( ( abs ` ( C - B ) ) x. ( abs ` ( A - B ) ) ) ) ) )
jl1:qCB,zCB:jca  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( abs ` ( C - B ) ) e. CC /\ ( abs ` ( C - B ) ) =/= 0 ) )
jl2:qAB,zAB:jca  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( abs ` ( A - B ) ) e. CC /\ ( abs ` ( A - B ) ) =/= 0 ) )
jl:qP,jl1,jl2:3jca  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) e. CC /\ ( ( abs ` ( C - B ) ) e. CC /\ ( abs ` ( C - B ) ) =/= 0 ) /\ ( ( abs ` ( A - B ) ) e. CC /\ ( abs ` ( A - B ) ) =/= 0 ) ) )
Lalg0::lawsinalg  |- ( ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) e. CC /\ ( ( abs ` ( C - B ) ) e. CC /\ ( abs ` ( C - B ) ) =/= 0 ) /\ ( ( abs ` ( A - B ) ) e. CC /\ ( abs ` ( A - B ) ) =/= 0 ) ) -> ( ( abs ` ( C - B ) ) x. ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( ( abs ` ( C - B ) ) x. ( abs ` ( A - B ) ) ) ) ) = ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( abs ` ( A - B ) ) ) )
Lalg:jl,Lalg0:syl  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( abs ` ( C - B ) ) x. ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( ( abs ` ( C - B ) ) x. ( abs ` ( A - B ) ) ) ) ) = ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( abs ` ( A - B ) ) ) )
L2:L1,Lalg:eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( X x. ( sin ` P ) ) = ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( abs ` ( A - B ) ) ) )

$( right-hand side: same cancellation after commuting the denominator $)
R1:yY,sinO:oveq12d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( Y x. ( sin ` O ) ) = ( ( abs ` ( C - A ) ) x. ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( B - A ) ) x. ( abs ` ( C - A ) ) ) ) ) )
Rc:qBA,qCA:mulcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( abs ` ( B - A ) ) x. ( abs ` ( C - A ) ) ) = ( ( abs ` ( C - A ) ) x. ( abs ` ( B - A ) ) ) )
Rd:Rc:oveq2d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( B - A ) ) x. ( abs ` ( C - A ) ) ) ) = ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( C - A ) ) x. ( abs ` ( B - A ) ) ) ) )
Re:Rd:oveq2d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( abs ` ( C - A ) ) x. ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( B - A ) ) x. ( abs ` ( C - A ) ) ) ) ) = ( ( abs ` ( C - A ) ) x. ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( C - A ) ) x. ( abs ` ( B - A ) ) ) ) ) )
jr1:qCA,zCA:jca  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( abs ` ( C - A ) ) e. CC /\ ( abs ` ( C - A ) ) =/= 0 ) )
jr2:qBA,zBA:jca  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( abs ` ( B - A ) ) e. CC /\ ( abs ` ( B - A ) ) =/= 0 ) )
jr:qO,jr1,jr2:3jca  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) e. CC /\ ( ( abs ` ( C - A ) ) e. CC /\ ( abs ` ( C - A ) ) =/= 0 ) /\ ( ( abs ` ( B - A ) ) e. CC /\ ( abs ` ( B - A ) ) =/= 0 ) ) )
Ralg0::lawsinalg  |- ( ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) e. CC /\ ( ( abs ` ( C - A ) ) e. CC /\ ( abs ` ( C - A ) ) =/= 0 ) /\ ( ( abs ` ( B - A ) ) e. CC /\ ( abs ` ( B - A ) ) =/= 0 ) ) -> ( ( abs ` ( C - A ) ) x. ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( C - A ) ) x. ( abs ` ( B - A ) ) ) ) ) = ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( abs ` ( B - A ) ) ) )
Ralg:jr,Ralg0:syl  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( abs ` ( C - A ) ) x. ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( ( abs ` ( C - A ) ) x. ( abs ` ( B - A ) ) ) ) ) = ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( abs ` ( B - A ) ) ) )
R2:R1,Re,Ralg:3eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( Y x. ( sin ` O ) ) = ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( abs ` ( B - A ) ) ) )

$( the two signed areas agree, and so do the two remaining side lengths $)
la0::lawsinarea  |- ( ( A e. CC /\ B e. CC /\ C e. CC ) -> ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) = ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) )
la:abc,la0:syl  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) = ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) )
lae:la:eqcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) = ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) )
ab:dA,dB:abssubd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( abs ` ( A - B ) ) = ( abs ` ( B - A ) ) )
E1:lae,ab:oveq12d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( Im ` ( ( * ` ( C - B ) ) x. ( A - B ) ) ) / ( abs ` ( A - B ) ) ) = ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( abs ` ( B - A ) ) ) )
R2e:R2:eqcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( ( Im ` ( ( * ` ( B - A ) ) x. ( C - A ) ) ) / ( abs ` ( B - A ) ) ) = ( Y x. ( sin ` O ) ) )
qed:L2,E1,R2e:3eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( A =/= B /\ A =/= C /\ B =/= C ) ) -> ( X x. ( sin ` P ) ) = ( Y x. ( sin ` O ) ) )

$)

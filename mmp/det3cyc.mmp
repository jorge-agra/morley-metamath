$( <MM> <PROOF_ASST> THEOREM=det3cyc  LOC_AFTER=?

d1::simpl1  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> A e. CC )
d2::simpl2  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> B e. CC )
d3::simpl3  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> C e. CC )
d4::simpr1  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> D e. CC )
d5::simpr2  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> E e. CC )
d6::simpr3  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> F e. CC )

cx:d3,d1:subcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( C - A ) e. CC )
cy:d4,d2:subcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( D - B ) e. CC )
cs:d5,d1:subcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( E - A ) e. CC )
ct:d6,d2:subcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( F - B ) e. CC )
cnx:cx:negcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> -u ( C - A ) e. CC )
cny:cy:negcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> -u ( D - B ) e. CC )
cxs:cnx,cs:addcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( C - A ) + ( E - A ) ) e. CC )
cyt:cny,ct:addcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( D - B ) + ( F - B ) ) e. CC )

$( E - C as a shifted side vector $)
r1a:d5,d3,d1:nnncan2d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( E - A ) - ( C - A ) ) = ( E - C ) )
r1b:cs,cx:negsubd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( E - A ) + -u ( C - A ) ) = ( ( E - A ) - ( C - A ) ) )
r1c:cnx,cs:addcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( C - A ) + ( E - A ) ) = ( ( E - A ) + -u ( C - A ) ) )
r1:r1c,r1b,r1a:3eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( C - A ) + ( E - A ) ) = ( E - C ) )
r1e:r1:eqcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( E - C ) = ( -u ( C - A ) + ( E - A ) ) )

$( B - D as the negated side vector $)
r2:d4,d2:negsubdi2d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> -u ( D - B ) = ( B - D ) )
r2e:r2:eqcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( B - D ) = -u ( D - B ) )

$( F - D as a shifted side vector $)
r3a:d6,d4,d2:nnncan2d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( F - B ) - ( D - B ) ) = ( F - D ) )
r3b:ct,cy:negsubd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( F - B ) + -u ( D - B ) ) = ( ( F - B ) - ( D - B ) ) )
r3c:cny,ct:addcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( D - B ) + ( F - B ) ) = ( ( F - B ) + -u ( D - B ) ) )
r3:r3c,r3b,r3a:3eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( D - B ) + ( F - B ) ) = ( F - D ) )
r3e:r3:eqcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( F - D ) = ( -u ( D - B ) + ( F - B ) ) )

$( A - C as the negated side vector $)
r4:d3,d1:negsubdi2d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> -u ( C - A ) = ( A - C ) )
r4e:r4:eqcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( A - C ) = -u ( C - A ) )

$( rewrite the cyclic side of the identity into detaddsub's shape $)
u1:r1e,r2e:oveq12d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( E - C ) x. ( B - D ) ) = ( ( -u ( C - A ) + ( E - A ) ) x. -u ( D - B ) ) )
u2:cxs,cny:mulcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( -u ( C - A ) + ( E - A ) ) x. -u ( D - B ) ) = ( -u ( D - B ) x. ( -u ( C - A ) + ( E - A ) ) ) )
u1t:u1,u2:eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( E - C ) x. ( B - D ) ) = ( -u ( D - B ) x. ( -u ( C - A ) + ( E - A ) ) ) )
u3:r3e,r4e:oveq12d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( F - D ) x. ( A - C ) ) = ( ( -u ( D - B ) + ( F - B ) ) x. -u ( C - A ) ) )
u4:cyt,cnx:mulcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( -u ( D - B ) + ( F - B ) ) x. -u ( C - A ) ) = ( -u ( C - A ) x. ( -u ( D - B ) + ( F - B ) ) ) )
u3t:u3,u4:eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( F - D ) x. ( A - C ) ) = ( -u ( C - A ) x. ( -u ( D - B ) + ( F - B ) ) ) )
u5:u1t,u3t:oveq12d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( ( E - C ) x. ( B - D ) ) - ( ( F - D ) x. ( A - C ) ) ) = ( ( -u ( D - B ) x. ( -u ( C - A ) + ( E - A ) ) ) - ( -u ( C - A ) x. ( -u ( D - B ) + ( F - B ) ) ) ) )

$( the cancellation itself $)
j1:cny,cnx:jca  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( D - B ) e. CC /\ -u ( C - A ) e. CC ) )
j2:ct,cs:jca  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( F - B ) e. CC /\ ( E - A ) e. CC ) )
j3:j1,j2:jca  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( -u ( D - B ) e. CC /\ -u ( C - A ) e. CC ) /\ ( ( F - B ) e. CC /\ ( E - A ) e. CC ) ) )
d0::detaddsub  |- ( ( ( -u ( D - B ) e. CC /\ -u ( C - A ) e. CC ) /\ ( ( F - B ) e. CC /\ ( E - A ) e. CC ) ) -> ( ( -u ( D - B ) x. ( -u ( C - A ) + ( E - A ) ) ) - ( -u ( C - A ) x. ( -u ( D - B ) + ( F - B ) ) ) ) = ( ( -u ( D - B ) x. ( E - A ) ) - ( -u ( C - A ) x. ( F - B ) ) ) )
u6:j3,d0:syl  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( -u ( D - B ) x. ( -u ( C - A ) + ( E - A ) ) ) - ( -u ( C - A ) x. ( -u ( D - B ) + ( F - B ) ) ) ) = ( ( -u ( D - B ) x. ( E - A ) ) - ( -u ( C - A ) x. ( F - B ) ) ) )

$( pull the two negations out and flip the difference $)
u7:cy,cs:mulneg1d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( D - B ) x. ( E - A ) ) = -u ( ( D - B ) x. ( E - A ) ) )
u8:cx,ct:mulneg1d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( C - A ) x. ( F - B ) ) = -u ( ( C - A ) x. ( F - B ) ) )
u9:u7,u8:oveq12d  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( -u ( D - B ) x. ( E - A ) ) - ( -u ( C - A ) x. ( F - B ) ) ) = ( -u ( ( D - B ) x. ( E - A ) ) - -u ( ( C - A ) x. ( F - B ) ) ) )
pys:cy,cs:mulcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( D - B ) x. ( E - A ) ) e. CC )
pxt:cx,ct:mulcld  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( C - A ) x. ( F - B ) ) e. CC )
u10:pys,pxt:neg2subd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( -u ( ( D - B ) x. ( E - A ) ) - -u ( ( C - A ) x. ( F - B ) ) ) = ( ( ( C - A ) x. ( F - B ) ) - ( ( D - B ) x. ( E - A ) ) ) )

uA:u5,u6:eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( ( E - C ) x. ( B - D ) ) - ( ( F - D ) x. ( A - C ) ) ) = ( ( -u ( D - B ) x. ( E - A ) ) - ( -u ( C - A ) x. ( F - B ) ) ) )
uB:uA,u9,u10:3eqtrd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( ( E - C ) x. ( B - D ) ) - ( ( F - D ) x. ( A - C ) ) ) = ( ( ( C - A ) x. ( F - B ) ) - ( ( D - B ) x. ( E - A ) ) ) )
qed:uB:eqcomd  |- ( ( ( A e. CC /\ B e. CC /\ C e. CC ) /\ ( D e. CC /\ E e. CC /\ F e. CC ) ) -> ( ( ( C - A ) x. ( F - B ) ) - ( ( D - B ) x. ( E - A ) ) ) = ( ( ( E - C ) x. ( B - D ) ) - ( ( F - D ) x. ( A - C ) ) ) )
$)

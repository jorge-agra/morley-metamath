$( <MM> <PROOF_ASST> THEOREM=cnaffco  LOC_AFTER=?

h1::cnaffco.a  |- ( ph -> A e. CC )
h2::cnaffco.b  |- ( ph -> B e. CC )
h3::cnaffco.c  |- ( ph -> C e. CC )
h4::cnaffco.d  |- ( ph -> D e. CC )
h5::cnaffco.z  |- ( ph -> Z e. CC )

cBZ:2,5:mulcld  |- ( ph -> ( B x. Z ) e. CC )
cAB:1,2:mulcld  |- ( ph -> ( A x. B ) e. CC )
cABZ:cAB,5:mulcld  |- ( ph -> ( ( A x. B ) x. Z ) e. CC )
cAC:1,3:mulcld  |- ( ph -> ( A x. C ) e. CC )

s1:1,cBZ,3:adddid  |- ( ph -> ( A x. ( ( B x. Z ) + C ) ) = ( ( A x. ( B x. Z ) ) + ( A x. C ) ) )
s2:1,2,5:mulassd  |- ( ph -> ( ( A x. B ) x. Z ) = ( A x. ( B x. Z ) ) )
s2e:s2:eqcomd  |- ( ph -> ( A x. ( B x. Z ) ) = ( ( A x. B ) x. Z ) )
s3:s2e:oveq1d  |- ( ph -> ( ( A x. ( B x. Z ) ) + ( A x. C ) ) = ( ( ( A x. B ) x. Z ) + ( A x. C ) ) )
s4:s1,s3:eqtrd  |- ( ph -> ( A x. ( ( B x. Z ) + C ) ) = ( ( ( A x. B ) x. Z ) + ( A x. C ) ) )
s5:s4:oveq1d  |- ( ph -> ( ( A x. ( ( B x. Z ) + C ) ) + D ) = ( ( ( ( A x. B ) x. Z ) + ( A x. C ) ) + D ) )
s6:cABZ,cAC,4:addassd  |- ( ph -> ( ( ( ( A x. B ) x. Z ) + ( A x. C ) ) + D ) = ( ( ( A x. B ) x. Z ) + ( ( A x. C ) + D ) ) )
qed:s5,s6:eqtrd  |- ( ph -> ( ( A x. ( ( B x. Z ) + C ) ) + D ) = ( ( ( A x. B ) x. Z ) + ( ( A x. C ) + D ) ) )

$)

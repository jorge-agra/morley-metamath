$( <MM> <PROOF_ASST> THEOREM=detaddsub  LOC_AFTER=?
$( Adding the first row of a two-by-two determinant to its second row leaves
   the determinant unchanged: with rows ` A ` , ` B ` and ` C ` , ` D ` , the
   determinant ` ( ( A x. D ) - ( B x. C ) ) ` equals the one with rows ` A ` ,
   ` B ` and ` ( A + C ) ` , ` ( B + D ) ` . $)

dA::simpll  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> A e. CC )
dB::simplr  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> B e. CC )
dC::simprl  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> C e. CC )
dD::simprr  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> D e. CC )

qABh:dA,dB:jca  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( A e. CC /\ B e. CC ) )
qAB0::mulcl  |- ( ( A e. CC /\ B e. CC ) -> ( A x. B ) e. CC )
qAB:qABh,qAB0:syl  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( A x. B ) e. CC )
pAD:dA,dD:mulcld  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( A x. D ) e. CC )
qBAh:dB,dA:jca  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( B e. CC /\ A e. CC ) )
qBA0::mulcl  |- ( ( B e. CC /\ A e. CC ) -> ( B x. A ) e. CC )
qBA:qBAh,qBA0:syl  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( B x. A ) e. CC )
pBC:dB,dC:mulcld  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( B x. C ) e. CC )
e1:dA,dB,dD:adddid  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( A x. ( B + D ) ) = ( ( A x. B ) + ( A x. D ) ) )
e2:dB,dA,dC:adddid  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( B x. ( A + C ) ) = ( ( B x. A ) + ( B x. C ) ) )
e3:e1,e2:oveq12d  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( A x. ( B + D ) ) - ( B x. ( A + C ) ) ) = ( ( ( A x. B ) + ( A x. D ) ) - ( ( B x. A ) + ( B x. C ) ) ) )
e4:qAB,pAD,qBA,pBC:addsub4d  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( ( A x. B ) + ( A x. D ) ) - ( ( B x. A ) + ( B x. C ) ) ) = ( ( ( A x. B ) - ( B x. A ) ) + ( ( A x. D ) - ( B x. C ) ) ) )
e5:dB,dA:mulcomd  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( B x. A ) = ( A x. B ) )
e6:e5:eqcomd  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( A x. B ) = ( B x. A ) )
e7a:e6:oveq1d  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( A x. B ) - ( B x. A ) ) = ( ( B x. A ) - ( B x. A ) ) )
e7b:qBA:subidd  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( B x. A ) - ( B x. A ) ) = 0 )
e7:e7a,e7b:eqtrd  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( A x. B ) - ( B x. A ) ) = 0 )
e8:e7:oveq1d  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( ( A x. B ) - ( B x. A ) ) + ( ( A x. D ) - ( B x. C ) ) ) = ( 0 + ( ( A x. D ) - ( B x. C ) ) ) )
pDIF:pAD,pBC:subcld  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( A x. D ) - ( B x. C ) ) e. CC )
e9:pDIF:addlidd  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( 0 + ( ( A x. D ) - ( B x. C ) ) ) = ( ( A x. D ) - ( B x. C ) ) )
e10:e3,e4,e8:3eqtrd  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( A x. ( B + D ) ) - ( B x. ( A + C ) ) ) = ( 0 + ( ( A x. D ) - ( B x. C ) ) ) )
qed:e10,e9:eqtrd  |- ( ( ( A e. CC /\ B e. CC ) /\ ( C e. CC /\ D e. CC ) ) -> ( ( A x. ( B + D ) ) - ( B x. ( A + C ) ) ) = ( ( A x. D ) - ( B x. C ) ) )

$)

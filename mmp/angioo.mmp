$( <MM> <PROOF_ASST> THEOREM=angioo  LOC_AFTER=?

$d A x
$d A y
$d B x
$d B y
$d x y

h1::angioo.1  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::angioo.a  |- ( ph -> A e. CC )
h3::angioo.an  |- ( ph -> A =/= 0 )
h4::angioo.b  |- ( ph -> B e. CC )
h5::angioo.bn  |- ( ph -> B =/= 0 )

cW:4,2,3:divcld  |- ( ph -> ( B / A ) e. CC )

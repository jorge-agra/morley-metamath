cAW:cW:abscld  |- ( ph -> ( abs ` ( B / A ) ) e. RR )
nAW:cW,nW:absne0d  |- ( ph -> ( abs ` ( B / A ) ) =/= 0 )
r0::absrpcl  |- ( ( ( B / A ) e. CC /\ ( B / A ) =/= 0 ) -> ( abs ` ( B / A ) ) e. RR+ )
r1:cW,nW,r0:syl2anc  |- ( ph -> ( abs ` ( B / A ) ) e. RR+ )
r2:r1:rpgt0d  |- ( ph -> 0 < ( abs ` ( B / A ) ) )
cIW:cW:imcld  |- ( ph -> ( Im ` ( B / A ) ) e. RR )

$( the frame value is the argument $)
a1:1,2,3,4,5:angvald  |- ( ph -> ( A F B ) = ( Im ` ( log ` ( B / A ) ) ) )
a2:a1:eleq1d  |- ( ph -> ( ( A F B ) e. ( 0 (,) _pi ) <-> ( Im ` ( log ` ( B / A ) ) ) e. ( 0 (,) _pi ) ) )

$( <- : set.mm's one-way argimgt0 $)

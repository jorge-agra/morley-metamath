dNW:nW:adantr  |- ( ( ph /\ ( Im ` ( log ` ( B / A ) ) ) e. ( 0 (,) _pi ) ) -> ( B / A ) =/= 0 )
dAW:cAW:adantr  |- ( ( ph /\ ( Im ` ( log ` ( B / A ) ) ) e. ( 0 (,) _pi ) ) -> ( abs ` ( B / A ) ) e. RR )
dNAW:nAW:adantr  |- ( ( ph /\ ( Im ` ( log ` ( B / A ) ) ) e. ( 0 (,) _pi ) ) -> ( abs ` ( B / A ) ) =/= 0 )
dR2:r2:adantr  |- ( ( ph /\ ( Im ` ( log ` ( B / A ) ) ) e. ( 0 (,) _pi ) ) -> 0 < ( abs ` ( B / A ) ) )
dIW:cIW:adantr  |- ( ( ph /\ ( Im ` ( log ` ( B / A ) ) ) e. ( 0 (,) _pi ) ) -> ( Im ` ( B / A ) ) e. RR )
u3a::sinarg  |- ( ( ( B / A ) e. CC /\ ( B / A ) =/= 0 ) -> ( sin ` ( Im ` ( log ` ( B / A ) ) ) ) = ( Im ` ( ( B / A ) / ( abs ` ( B / A ) ) ) ) )
u3:dW,dNW,u3a:syl2anc  |- ( ( ph /\ ( Im ` ( log ` ( B / A ) ) ) e. ( 0 (,) _pi ) ) -> ( sin ` ( Im ` ( log ` ( B / A ) ) ) ) = ( Im ` ( ( B / A ) / ( abs ` ( B / A ) ) ) ) )
u4:dAW,dW,dNAW:imdivd  |- ( ( ph /\ ( Im ` ( log ` ( B / A ) ) ) e. ( 0 (,) _pi ) ) -> ( Im ` ( ( B / A ) / ( abs ` ( B / A ) ) ) ) = ( ( Im ` ( B / A ) ) / ( abs ` ( B / A ) ) ) )
u5:u3,u4:eqtrd  |- ( ( ph /\ ( Im ` ( log ` ( B / A ) ) ) e. ( 0 (,) _pi ) ) -> ( sin ` ( Im ` ( log ` ( B / A ) ) ) ) = ( ( Im ` ( B / A ) ) / ( abs ` ( B / A ) ) ) )

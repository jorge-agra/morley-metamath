$( <MM> <PROOF_ASST> THEOREM=angexpadd  LOC_AFTER=?

$d U x
$d U y
$d V x
$d V y
$d W x
$d W y
$d x y

h1::angexpadd.1  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::angexpadd.u  |- ( ph -> U e. CC )
h3::angexpadd.un  |- ( ph -> U =/= 0 )
h4::angexpadd.v  |- ( ph -> V e. CC )
h5::angexpadd.vn  |- ( ph -> V =/= 0 )
h6::angexpadd.w  |- ( ph -> W e. CC )
h7::angexpadd.wn  |- ( ph -> W =/= 0 )

$( the three unit numbers $)
p1:1,2,3,4,5:angexp  |- ( ph -> ( exp ` ( _i x. ( U F V ) ) ) = ( ( V / U ) / ( abs ` ( V / U ) ) ) )
p2:1,4,5,6,7:angexp  |- ( ph -> ( exp ` ( _i x. ( V F W ) ) ) = ( ( W / V ) / ( abs ` ( W / V ) ) ) )
p3:1,2,3,6,7:angexp  |- ( ph -> ( exp ` ( _i x. ( U F W ) ) ) = ( ( W / U ) / ( abs ` ( W / U ) ) ) )

$( closures $)
c1:4,2,3:divcld  |- ( ph -> ( V / U ) e. CC )
n1:4,2,5,3:divne0d  |- ( ph -> ( V / U ) =/= 0 )
c2:6,4,5:divcld  |- ( ph -> ( W / V ) e. CC )
n2:6,4,7,5:divne0d  |- ( ph -> ( W / V ) =/= 0 )
c3:6,2,3:divcld  |- ( ph -> ( W / U ) e. CC )
n3:6,2,7,3:divne0d  |- ( ph -> ( W / U ) =/= 0 )
b1:c1:abscld  |- ( ph -> ( abs ` ( V / U ) ) e. RR )
b1c:b1:recnd  |- ( ph -> ( abs ` ( V / U ) ) e. CC )
b1n:c1,n1:absne0d  |- ( ph -> ( abs ` ( V / U ) ) =/= 0 )
b2:c2:abscld  |- ( ph -> ( abs ` ( W / V ) ) e. RR )
b2c:b2:recnd  |- ( ph -> ( abs ` ( W / V ) ) e. CC )
b2n:c2,n2:absne0d  |- ( ph -> ( abs ` ( W / V ) ) =/= 0 )

$( the two quotients multiply to the third $)
m1a:4,2,6,4,3,5:divmuldivd  |- ( ph -> ( ( V / U ) x. ( W / V ) ) = ( ( V x. W ) / ( U x. V ) ) )
m1b:2,4:mulcomd  |- ( ph -> ( U x. V ) = ( V x. U ) )
m1c:m1b:oveq2d  |- ( ph -> ( ( V x. W ) / ( U x. V ) ) = ( ( V x. W ) / ( V x. U ) ) )
m1d:6,2,4,3,5:divcan5d  |- ( ph -> ( ( V x. W ) / ( V x. U ) ) = ( W / U ) )
m1:m1a,m1c,m1d:3eqtrd  |- ( ph -> ( ( V / U ) x. ( W / V ) ) = ( W / U ) )
m2a:c1,c2:absmuld  |- ( ph -> ( abs ` ( ( V / U ) x. ( W / V ) ) ) = ( ( abs ` ( V / U ) ) x. ( abs ` ( W / V ) ) ) )
m2b:m1:fveq2d  |- ( ph -> ( abs ` ( ( V / U ) x. ( W / V ) ) ) = ( abs ` ( W / U ) ) )
m2:m2a,m2b:eqtr3d  |- ( ph -> ( ( abs ` ( V / U ) ) x. ( abs ` ( W / V ) ) ) = ( abs ` ( W / U ) ) )

$( so the unit numbers multiply $)
m3:c1,b1c,c2,b2c,b1n,b2n:divmuldivd  |- ( ph -> ( ( ( V / U ) / ( abs ` ( V / U ) ) ) x. ( ( W / V ) / ( abs ` ( W / V ) ) ) ) = ( ( ( V / U ) x. ( W / V ) ) / ( ( abs ` ( V / U ) ) x. ( abs ` ( W / V ) ) ) ) )
m4:m1,m2:oveq12d  |- ( ph -> ( ( ( V / U ) x. ( W / V ) ) / ( ( abs ` ( V / U ) ) x. ( abs ` ( W / V ) ) ) ) = ( ( W / U ) / ( abs ` ( W / U ) ) ) )
m5:m3,m4:eqtrd  |- ( ph -> ( ( ( V / U ) / ( abs ` ( V / U ) ) ) x. ( ( W / V ) / ( abs ` ( W / V ) ) ) ) = ( ( W / U ) / ( abs ` ( W / U ) ) ) )
m6:p1,p2:oveq12d  |- ( ph -> ( ( exp ` ( _i x. ( U F V ) ) ) x. ( exp ` ( _i x. ( V F W ) ) ) ) = ( ( ( V / U ) / ( abs ` ( V / U ) ) ) x. ( ( W / V ) / ( abs ` ( W / V ) ) ) ) )
m7:m6,m5:eqtrd  |- ( ph -> ( ( exp ` ( _i x. ( U F V ) ) ) x. ( exp ` ( _i x. ( V F W ) ) ) ) = ( ( W / U ) / ( abs ` ( W / U ) ) ) )

qed:m7,p3:eqtr4d  |- ( ph -> ( ( exp ` ( _i x. ( U F V ) ) ) x. ( exp ` ( _i x. ( V F W ) ) ) ) = ( exp ` ( _i x. ( U F W ) ) ) )

$)

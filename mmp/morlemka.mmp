$( <MM> <PROOF_ASST> THEOREM=morlemka  LOC_AFTER=?
$( An identity used by ~ morlemlinalg to collect the terms in ` A ` . Let ` E `
   , ` D ` , ` G ` be complex numbers whose product ` J ` is a cube root of
   unity other than ` 1 ` . Then a polynomial in ` E ` , ` D ` , ` G ` and ` J
   ` with the factor ` ( 1 - E ) ` equals ` ( ( E ^ 3 ) - 1 ) ` . $)

h1::morlemka.e  |- ( ph -> E e. CC )
h2::morlemka.d  |- ( ph -> D e. CC )
h3::morlemka.g  |- ( ph -> G e. CC )
h4::morlemka.j  |- ( ph -> J = ( ( E x. D ) x. G ) )
h5::morlemka.c  |- ( ph -> ( J ^ 3 ) = 1 )
h6::morlemka.n  |- ( ph -> J =/= 1 )

$( closures $)
c1:1:1cnd  |- ( ph -> 1 e. CC )
cED:1,2:mulcld  |- ( ph -> ( E x. D ) e. CC )
cDG:2,3:mulcld  |- ( ph -> ( D x. G ) e. CC )
cGE:3,1:mulcld  |- ( ph -> ( G x. E ) e. CC )
cJa:cED,3:mulcld  |- ( ph -> ( ( E x. D ) x. G ) e. CC )
cJ:4,cJa:eqeltrd  |- ( ph -> J e. CC )
cJ2:cJ:sqcld  |- ( ph -> ( J ^ 2 ) e. CC )
cE2:1:sqcld  |- ( ph -> ( E ^ 2 ) e. CC )
cm:cE2,2:mulcld  |- ( ph -> ( ( E ^ 2 ) x. D ) e. CC )
cd1:c1,cDG:subcld  |- ( ph -> ( 1 - ( D x. G ) ) e. CC )
cd2:c1,cGE:subcld  |- ( ph -> ( 1 - ( G x. E ) ) e. CC )
cd3:c1,cED:subcld  |- ( ph -> ( 1 - ( E x. D ) ) e. CC )
cJG:cJ,3:mulcld  |- ( ph -> ( J x. G ) e. CC )
cEJ:1,cJ:mulcld  |- ( ph -> ( E x. J ) e. CC )
cmd1:cm,cd1:mulcld  |- ( ph -> ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( D x. G ) ) ) e. CC )

$( the three products of the composite coefficient $)
a1:4:eqcomd  |- ( ph -> ( ( E x. D ) x. G ) = J )
a2:1,2,3:mulassd  |- ( ph -> ( ( E x. D ) x. G ) = ( E x. ( D x. G ) ) )
a3:a2:eqcomd  |- ( ph -> ( E x. ( D x. G ) ) = ( ( E x. D ) x. G ) )
pE:a3,a1:eqtrd  |- ( ph -> ( E x. ( D x. G ) ) = J )
a4:3,cED:mulcomd  |- ( ph -> ( G x. ( E x. D ) ) = ( ( E x. D ) x. G ) )
pG:a4,a1:eqtrd  |- ( ph -> ( G x. ( E x. D ) ) = J )

$( ( J x. G ) x. ( E x. D ) is ( J ^ 2 ) $)
b1:cJ,3,cED:mulassd  |- ( ph -> ( ( J x. G ) x. ( E x. D ) ) = ( J x. ( G x. ( E x. D ) ) ) )
b2:pG:oveq2d  |- ( ph -> ( J x. ( G x. ( E x. D ) ) ) = ( J x. J ) )
b3:cJ:sqvald  |- ( ph -> ( J ^ 2 ) = ( J x. J ) )
b4:b3:eqcomd  |- ( ph -> ( J x. J ) = ( J ^ 2 ) )
pJG:b1,b2,b4:3eqtrd  |- ( ph -> ( ( J x. G ) x. ( E x. D ) ) = ( J ^ 2 ) )

$( ( J ^ 2 ) x. ( E x. J ) is E $)
n2a::2nn0  |- 2 e. NN0
n2:n2a:a1i  |- ( ph -> 2 e. NN0 )
e1:cJ,n2:expp1d  |- ( ph -> ( J ^ ( 2 + 1 ) ) = ( ( J ^ 2 ) x. J ) )
e2a::2p1e3  |- ( 2 + 1 ) = 3
e2b:e2a:oveq2i  |- ( J ^ ( 2 + 1 ) ) = ( J ^ 3 )
e2:e2b:a1i  |- ( ph -> ( J ^ ( 2 + 1 ) ) = ( J ^ 3 ) )
e3:e2,e1:eqtr3d  |- ( ph -> ( J ^ 3 ) = ( ( J ^ 2 ) x. J ) )
e4:e3:eqcomd  |- ( ph -> ( ( J ^ 2 ) x. J ) = ( J ^ 3 ) )
e5:e4,5:eqtrd  |- ( ph -> ( ( J ^ 2 ) x. J ) = 1 )
f1:cJ2,1,cJ:mul12d  |- ( ph -> ( ( J ^ 2 ) x. ( E x. J ) ) = ( E x. ( ( J ^ 2 ) x. J ) ) )
f2:e5:oveq2d  |- ( ph -> ( E x. ( ( J ^ 2 ) x. J ) ) = ( E x. 1 ) )
f3:1:mulridd  |- ( ph -> ( E x. 1 ) = E )
pEJ:f1,f2,f3:3eqtrd  |- ( ph -> ( ( J ^ 2 ) x. ( E x. J ) ) = E )

$( THE COLLECTION IDENTITY for the A coefficient $)
k1:cJG,cED,pJG:mul1subeqd  |- ( ph -> ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) = ( ( J x. G ) - ( J ^ 2 ) ) )
k2i:cJ2,cGE:mulcld  |- ( ph -> ( ( J ^ 2 ) x. ( G x. E ) ) e. CC )
k2e:1:eqidd  |- ( ph -> ( ( J ^ 2 ) x. ( G x. E ) ) = ( ( J ^ 2 ) x. ( G x. E ) ) )
k2:cJ2,cGE,k2e:mul1subeqd  |- ( ph -> ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) = ( ( J ^ 2 ) - ( ( J ^ 2 ) x. ( G x. E ) ) ) )
k3:k1,k2:oveq12d  |- ( ph -> ( ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) + ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) ) = ( ( ( J x. G ) - ( J ^ 2 ) ) + ( ( J ^ 2 ) - ( ( J ^ 2 ) x. ( G x. E ) ) ) ) )
k4:cJG,cJ2,k2i:npncand  |- ( ph -> ( ( ( J x. G ) - ( J ^ 2 ) ) + ( ( J ^ 2 ) - ( ( J ^ 2 ) x. ( G x. E ) ) ) ) = ( ( J x. G ) - ( ( J ^ 2 ) x. ( G x. E ) ) ) )
k5:k3,k4:eqtrd  |- ( ph -> ( ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) + ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) ) = ( ( J x. G ) - ( ( J ^ 2 ) x. ( G x. E ) ) ) )

$( and the same difference read as ( J x. G ) x. ( 1 - ( E x. J ) ) $)
g1:b3:oveq1d  |- ( ph -> ( ( J ^ 2 ) x. ( G x. E ) ) = ( ( J x. J ) x. ( G x. E ) ) )
g2:cJ,cJ,3,1:mul4d  |- ( ph -> ( ( J x. J ) x. ( G x. E ) ) = ( ( J x. G ) x. ( J x. E ) ) )
g3:cJ,1:mulcomd  |- ( ph -> ( J x. E ) = ( E x. J ) )
g4:g3:oveq2d  |- ( ph -> ( ( J x. G ) x. ( J x. E ) ) = ( ( J x. G ) x. ( E x. J ) ) )
g5:g1,g2,g4:3eqtrd  |- ( ph -> ( ( J ^ 2 ) x. ( G x. E ) ) = ( ( J x. G ) x. ( E x. J ) ) )
g6:g5:oveq2d  |- ( ph -> ( ( J x. G ) - ( ( J ^ 2 ) x. ( G x. E ) ) ) = ( ( J x. G ) - ( ( J x. G ) x. ( E x. J ) ) ) )
g7e:1:eqidd  |- ( ph -> ( ( J x. G ) x. ( E x. J ) ) = ( ( J x. G ) x. ( E x. J ) ) )
g7:cJG,cEJ,g7e:mul1subeqd  |- ( ph -> ( ( J x. G ) x. ( 1 - ( E x. J ) ) ) = ( ( J x. G ) - ( ( J x. G ) x. ( E x. J ) ) ) )
g8:k5,g6:eqtrd  |- ( ph -> ( ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) + ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) ) = ( ( J x. G ) - ( ( J x. G ) x. ( E x. J ) ) ) )
KK:g8,g7:eqtr4d  |- ( ph -> ( ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) + ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) ) = ( ( J x. G ) x. ( 1 - ( E x. J ) ) ) )

$( ( ( E ^ 2 ) x. D ) x. ( J x. G ) is E x. ( J ^ 2 ) $)
w1a:1:sqvald  |- ( ph -> ( E ^ 2 ) = ( E x. E ) )
w1b:w1a:oveq1d  |- ( ph -> ( ( E ^ 2 ) x. D ) = ( ( E x. E ) x. D ) )
w1c:1,1,2:mulassd  |- ( ph -> ( ( E x. E ) x. D ) = ( E x. ( E x. D ) ) )
w1d:w1b,w1c:eqtrd  |- ( ph -> ( ( E ^ 2 ) x. D ) = ( E x. ( E x. D ) ) )
w1e:w1d:oveq1d  |- ( ph -> ( ( ( E ^ 2 ) x. D ) x. ( J x. G ) ) = ( ( E x. ( E x. D ) ) x. ( J x. G ) ) )
w1f:1,cED,cJG:mulassd  |- ( ph -> ( ( E x. ( E x. D ) ) x. ( J x. G ) ) = ( E x. ( ( E x. D ) x. ( J x. G ) ) ) )
w1g:cED,cJ,3:mul12d  |- ( ph -> ( ( E x. D ) x. ( J x. G ) ) = ( J x. ( ( E x. D ) x. G ) ) )
w1h:a1:oveq2d  |- ( ph -> ( J x. ( ( E x. D ) x. G ) ) = ( J x. J ) )
w1i:w1g,w1h,b4:3eqtrd  |- ( ph -> ( ( E x. D ) x. ( J x. G ) ) = ( J ^ 2 ) )
w1j:w1i:oveq2d  |- ( ph -> ( E x. ( ( E x. D ) x. ( J x. G ) ) ) = ( E x. ( J ^ 2 ) ) )
pM:w1e,w1f,w1j:3eqtrd  |- ( ph -> ( ( ( E ^ 2 ) x. D ) x. ( J x. G ) ) = ( E x. ( J ^ 2 ) ) )

$( put it together $)
c1EJ:c1,cEJ:subcld  |- ( ph -> ( 1 - ( E x. J ) ) e. CC )
m1:KK:oveq2d  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( D x. G ) ) ) x. ( ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) + ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) ) ) = ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( D x. G ) ) ) x. ( ( J x. G ) x. ( 1 - ( E x. J ) ) ) ) )
m2:cm,cd1,cJG,c1EJ:mul4d  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( D x. G ) ) ) x. ( ( J x. G ) x. ( 1 - ( E x. J ) ) ) ) = ( ( ( ( E ^ 2 ) x. D ) x. ( J x. G ) ) x. ( ( 1 - ( D x. G ) ) x. ( 1 - ( E x. J ) ) ) ) )
m3:pM:oveq1d  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( J x. G ) ) x. ( ( 1 - ( D x. G ) ) x. ( 1 - ( E x. J ) ) ) ) = ( ( E x. ( J ^ 2 ) ) x. ( ( 1 - ( D x. G ) ) x. ( 1 - ( E x. J ) ) ) ) )
m4:1,cJ2,cd1,c1EJ:mul4d  |- ( ph -> ( ( E x. ( J ^ 2 ) ) x. ( ( 1 - ( D x. G ) ) x. ( 1 - ( E x. J ) ) ) ) = ( ( E x. ( 1 - ( D x. G ) ) ) x. ( ( J ^ 2 ) x. ( 1 - ( E x. J ) ) ) ) )
m5:1,cDG,pE:mul1subeqd  |- ( ph -> ( E x. ( 1 - ( D x. G ) ) ) = ( E - J ) )
m6:cJ2,cEJ,pEJ:mul1subeqd  |- ( ph -> ( ( J ^ 2 ) x. ( 1 - ( E x. J ) ) ) = ( ( J ^ 2 ) - E ) )
m7:m5,m6:oveq12d  |- ( ph -> ( ( E x. ( 1 - ( D x. G ) ) ) x. ( ( J ^ 2 ) x. ( 1 - ( E x. J ) ) ) ) = ( ( E - J ) x. ( ( J ^ 2 ) - E ) ) )
m8:m1,m2,m3:3eqtrd  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( D x. G ) ) ) x. ( ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) + ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) ) ) = ( ( E x. ( J ^ 2 ) ) x. ( ( 1 - ( D x. G ) ) x. ( 1 - ( E x. J ) ) ) ) )
m9:m8,m4,m7:3eqtrd  |- ( ph -> ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( D x. G ) ) ) x. ( ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) + ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) ) ) = ( ( E - J ) x. ( ( J ^ 2 ) - E ) ) )
m10:m9:oveq1d  |- ( ph -> ( ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( D x. G ) ) ) x. ( ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) + ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) ) ) x. ( 1 - E ) ) = ( ( ( E - J ) x. ( ( J ^ 2 ) - E ) ) x. ( 1 - E ) ) )
cEmJ:1,cJ:subcld  |- ( ph -> ( E - J ) e. CC )
cJ2mE:cJ2,1:subcld  |- ( ph -> ( ( J ^ 2 ) - E ) e. CC )
cprod:cEmJ,cJ2mE:mulcld  |- ( ph -> ( ( E - J ) x. ( ( J ^ 2 ) - E ) ) e. CC )
c1E:c1,1:subcld  |- ( ph -> ( 1 - E ) e. CC )
m11:cprod,c1E:mulcomd  |- ( ph -> ( ( ( E - J ) x. ( ( J ^ 2 ) - E ) ) x. ( 1 - E ) ) = ( ( 1 - E ) x. ( ( E - J ) x. ( ( J ^ 2 ) - E ) ) ) )
m12:cJ,5,6,1:morlemcyc  |- ( ph -> ( ( 1 - E ) x. ( ( E - J ) x. ( ( J ^ 2 ) - E ) ) ) = ( ( E ^ 3 ) - 1 ) )
qed:m10,m11,m12:3eqtrd  |- ( ph -> ( ( ( ( ( E ^ 2 ) x. D ) x. ( 1 - ( D x. G ) ) ) x. ( ( ( J x. G ) x. ( 1 - ( E x. D ) ) ) + ( ( J ^ 2 ) x. ( 1 - ( G x. E ) ) ) ) ) x. ( 1 - E ) ) = ( ( E ^ 3 ) - 1 ) )

$)

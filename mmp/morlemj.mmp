$( <MM> <PROOF_ASST> THEOREM=morlemj  LOC_AFTER=?
$( Let ` X ` , ` Y ` , ` Z ` be one third of the angles of a positively
   oriented triangle with vertices ` A ` , ` B ` , ` C ` . The product ` J ` of
   the rotation coefficients for twice these angles is the rotation by ` ( 2 x.
   ( _pi / 3 ) ) ` , so it is a cube root of unity other than ` 1 ` . $)

$d A x
$d A y
$d B x
$d B y
$d C x
$d C y
$d x y

h1::morlemj.f  |- F = ( x e. ( CC \ { 0 } ) , y e. ( CC \ { 0 } ) |-> ( Im ` ( log ` ( y / x ) ) ) )
h2::morlemj.x  |- X = ( ( ( B - A ) F ( C - A ) ) / 3 )
h3::morlemj.y  |- Y = ( ( ( C - B ) F ( A - B ) ) / 3 )
h4::morlemj.z  |- Z = ( ( ( A - C ) F ( B - C ) ) / 3 )
h5::morlemj.a  |- ( ph -> A e. CC )
h6::morlemj.b  |- ( ph -> B e. CC )
h7::morlemj.c  |- ( ph -> C e. CC )
h8::morlemj.ab  |- ( ph -> A =/= B )
h9::morlemj.bc  |- ( ph -> B =/= C )
h10::morlemj.ca  |- ( ph -> C =/= A )
h11::morlemj.o  |- ( ph -> ( ( B - A ) F ( C - A ) ) e. ( 0 (,) _pi ) )
h12::morlemj.j  |- J = ( ( ( exp ` ( _i x. ( 2 x. X ) ) ) x. ( exp ` ( _i x. ( 2 x. Y ) ) ) ) x. ( exp ` ( _i x. ( 2 x. Z ) ) ) )

$( THE ANGLE SUM AND ITS SIGN, taken from ang180pos and not re-derived $)
p1:1,5,6,7,8,9,10,11:ang180pos  |- ( ph -> ( ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) /\ ( ( A - C ) F ( B - C ) ) e. ( 0 (,) _pi ) /\ ( ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) + ( ( B - A ) F ( C - A ) ) ) = _pi ) )
pB:p1:simp1d  |- ( ph -> ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) )
pC:p1:simp2d  |- ( ph -> ( ( A - C ) F ( B - C ) ) e. ( 0 (,) _pi ) )
pS:p1:simp3d  |- ( ph -> ( ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) + ( ( B - A ) F ( C - A ) ) ) = _pi )

$( the three angles are complex numbers $)
eA0::elioore  |- ( ( ( B - A ) F ( C - A ) ) e. ( 0 (,) _pi ) -> ( ( B - A ) F ( C - A ) ) e. RR )
rA:11,eA0:syl  |- ( ph -> ( ( B - A ) F ( C - A ) ) e. RR )
cA:rA:recnd  |- ( ph -> ( ( B - A ) F ( C - A ) ) e. CC )
eB0::elioore  |- ( ( ( C - B ) F ( A - B ) ) e. ( 0 (,) _pi ) -> ( ( C - B ) F ( A - B ) ) e. RR )
rB:pB,eB0:syl  |- ( ph -> ( ( C - B ) F ( A - B ) ) e. RR )
cB:rB:recnd  |- ( ph -> ( ( C - B ) F ( A - B ) ) e. CC )
eC0::elioore  |- ( ( ( A - C ) F ( B - C ) ) e. ( 0 (,) _pi ) -> ( ( A - C ) F ( B - C ) ) e. RR )
rC:pC,eC0:syl  |- ( ph -> ( ( A - C ) F ( B - C ) ) e. RR )
cC:rC:recnd  |- ( ph -> ( ( A - C ) F ( B - C ) ) e. CC )

$( ... hence so are the trisected angles $)
c3a::3cn  |- 3 e. CC
c3:c3a:a1i  |- ( ph -> 3 e. CC )
n3a::3ne0  |- 3 =/= 0
n3:n3a:a1i  |- ( ph -> 3 =/= 0 )
dX:2:a1i  |- ( ph -> X = ( ( ( B - A ) F ( C - A ) ) / 3 ) )
dY:3:a1i  |- ( ph -> Y = ( ( ( C - B ) F ( A - B ) ) / 3 ) )
dZ:4:a1i  |- ( ph -> Z = ( ( ( A - C ) F ( B - C ) ) / 3 ) )
qX:cA,c3,n3:divcld  |- ( ph -> ( ( ( B - A ) F ( C - A ) ) / 3 ) e. CC )
qY:cB,c3,n3:divcld  |- ( ph -> ( ( ( C - B ) F ( A - B ) ) / 3 ) e. CC )
qZ:cC,c3,n3:divcld  |- ( ph -> ( ( ( A - C ) F ( B - C ) ) / 3 ) e. CC )
cX:dX,qX:eqeltrd  |- ( ph -> X e. CC )
cY:dY,qY:eqeltrd  |- ( ph -> Y e. CC )
cZ:dZ,qZ:eqeltrd  |- ( ph -> Z e. CC )

$( X + Y + Z = _pi / 3 $)
s1:cA,cB,cC:addassd  |- ( ph -> ( ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) + ( ( A - C ) F ( B - C ) ) ) = ( ( ( B - A ) F ( C - A ) ) + ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) ) )
sAd:cB,cC:addcld  |- ( ph -> ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) e. CC )
s2:cA,sAd:addcomd  |- ( ph -> ( ( ( B - A ) F ( C - A ) ) + ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) ) = ( ( ( ( C - B ) F ( A - B ) ) + ( ( A - C ) F ( B - C ) ) ) + ( ( B - A ) F ( C - A ) ) ) )
s3:s1,s2,pS:3eqtrd  |- ( ph -> ( ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) + ( ( A - C ) F ( B - C ) ) ) = _pi )
s4:s3:oveq1d  |- ( ph -> ( ( ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) + ( ( A - C ) F ( B - C ) ) ) / 3 ) = ( _pi / 3 ) )
s5:cA,cB,c3,n3:divdird  |- ( ph -> ( ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) / 3 ) = ( ( ( ( B - A ) F ( C - A ) ) / 3 ) + ( ( ( C - B ) F ( A - B ) ) / 3 ) ) )
cAB2:cA,cB:addcld  |- ( ph -> ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) e. CC )
s6:cAB2,cC,c3,n3:divdird  |- ( ph -> ( ( ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) + ( ( A - C ) F ( B - C ) ) ) / 3 ) = ( ( ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) / 3 ) + ( ( ( A - C ) F ( B - C ) ) / 3 ) ) )
s7:s5:oveq1d  |- ( ph -> ( ( ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) / 3 ) + ( ( ( A - C ) F ( B - C ) ) / 3 ) ) = ( ( ( ( ( B - A ) F ( C - A ) ) / 3 ) + ( ( ( C - B ) F ( A - B ) ) / 3 ) ) + ( ( ( A - C ) F ( B - C ) ) / 3 ) ) )
s8:dX,dY:oveq12d  |- ( ph -> ( X + Y ) = ( ( ( ( B - A ) F ( C - A ) ) / 3 ) + ( ( ( C - B ) F ( A - B ) ) / 3 ) ) )
s9:s8,dZ:oveq12d  |- ( ph -> ( ( X + Y ) + Z ) = ( ( ( ( ( B - A ) F ( C - A ) ) / 3 ) + ( ( ( C - B ) F ( A - B ) ) / 3 ) ) + ( ( ( A - C ) F ( B - C ) ) / 3 ) ) )
s10:s6,s7:eqtrd  |- ( ph -> ( ( ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) + ( ( A - C ) F ( B - C ) ) ) / 3 ) = ( ( ( ( ( B - A ) F ( C - A ) ) / 3 ) + ( ( ( C - B ) F ( A - B ) ) / 3 ) ) + ( ( ( A - C ) F ( B - C ) ) / 3 ) ) )
s11:s10:eqcomd  |- ( ph -> ( ( ( ( ( B - A ) F ( C - A ) ) / 3 ) + ( ( ( C - B ) F ( A - B ) ) / 3 ) ) + ( ( ( A - C ) F ( B - C ) ) / 3 ) ) = ( ( ( ( ( B - A ) F ( C - A ) ) + ( ( C - B ) F ( A - B ) ) ) + ( ( A - C ) F ( B - C ) ) ) / 3 ) )
sum:s9,s11,s4:3eqtrd  |- ( ph -> ( ( X + Y ) + Z ) = ( _pi / 3 ) )

$( collecting the three exponentials $)
ci0::ax-icn  |- _i e. CC
ci:ci0:a1i  |- ( ph -> _i e. CC )
c2a::2cn  |- 2 e. CC
c2:c2a:a1i  |- ( ph -> 2 e. CC )
c2X:c2,cX:mulcld  |- ( ph -> ( 2 x. X ) e. CC )
c2Y:c2,cY:mulcld  |- ( ph -> ( 2 x. Y ) e. CC )
c2Z:c2,cZ:mulcld  |- ( ph -> ( 2 x. Z ) e. CC )
ciX:ci,c2X:mulcld  |- ( ph -> ( _i x. ( 2 x. X ) ) e. CC )
ciY:ci,c2Y:mulcld  |- ( ph -> ( _i x. ( 2 x. Y ) ) e. CC )
ciZ:ci,c2Z:mulcld  |- ( ph -> ( _i x. ( 2 x. Z ) ) e. CC )
cXY:ciX,ciY:addcld  |- ( ph -> ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) e. CC )
a1::efadd  |- ( ( ( _i x. ( 2 x. X ) ) e. CC /\ ( _i x. ( 2 x. Y ) ) e. CC ) -> ( exp ` ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) ) = ( ( exp ` ( _i x. ( 2 x. X ) ) ) x. ( exp ` ( _i x. ( 2 x. Y ) ) ) ) )
a2:ciX,ciY,a1:syl2anc  |- ( ph -> ( exp ` ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) ) = ( ( exp ` ( _i x. ( 2 x. X ) ) ) x. ( exp ` ( _i x. ( 2 x. Y ) ) ) ) )
a3::efadd  |- ( ( ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) e. CC /\ ( _i x. ( 2 x. Z ) ) e. CC ) -> ( exp ` ( ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) + ( _i x. ( 2 x. Z ) ) ) ) = ( ( exp ` ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) ) x. ( exp ` ( _i x. ( 2 x. Z ) ) ) ) )
a4:cXY,ciZ,a3:syl2anc  |- ( ph -> ( exp ` ( ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) + ( _i x. ( 2 x. Z ) ) ) ) = ( ( exp ` ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) ) x. ( exp ` ( _i x. ( 2 x. Z ) ) ) ) )
a5:a2:oveq1d  |- ( ph -> ( ( exp ` ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) ) x. ( exp ` ( _i x. ( 2 x. Z ) ) ) ) = ( ( ( exp ` ( _i x. ( 2 x. X ) ) ) x. ( exp ` ( _i x. ( 2 x. Y ) ) ) ) x. ( exp ` ( _i x. ( 2 x. Z ) ) ) ) )
a6:a4,a5:eqtrd  |- ( ph -> ( exp ` ( ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) + ( _i x. ( 2 x. Z ) ) ) ) = ( ( ( exp ` ( _i x. ( 2 x. X ) ) ) x. ( exp ` ( _i x. ( 2 x. Y ) ) ) ) x. ( exp ` ( _i x. ( 2 x. Z ) ) ) ) )

$( and rewriting their argument as _i x. ( 2 x. ( _pi / 3 ) ) $)
b1:ci,c2X,c2Y:adddid  |- ( ph -> ( _i x. ( ( 2 x. X ) + ( 2 x. Y ) ) ) = ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) )
cXYs:c2X,c2Y:addcld  |- ( ph -> ( ( 2 x. X ) + ( 2 x. Y ) ) e. CC )
b2:ci,cXYs,c2Z:adddid  |- ( ph -> ( _i x. ( ( ( 2 x. X ) + ( 2 x. Y ) ) + ( 2 x. Z ) ) ) = ( ( _i x. ( ( 2 x. X ) + ( 2 x. Y ) ) ) + ( _i x. ( 2 x. Z ) ) ) )
b3:b1:oveq1d  |- ( ph -> ( ( _i x. ( ( 2 x. X ) + ( 2 x. Y ) ) ) + ( _i x. ( 2 x. Z ) ) ) = ( ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) + ( _i x. ( 2 x. Z ) ) ) )
b4:b2,b3:eqtrd  |- ( ph -> ( _i x. ( ( ( 2 x. X ) + ( 2 x. Y ) ) + ( 2 x. Z ) ) ) = ( ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) + ( _i x. ( 2 x. Z ) ) ) )
b5:c2,cX,cY:adddid  |- ( ph -> ( 2 x. ( X + Y ) ) = ( ( 2 x. X ) + ( 2 x. Y ) ) )
cXYp:cX,cY:addcld  |- ( ph -> ( X + Y ) e. CC )
b6:c2,cXYp,cZ:adddid  |- ( ph -> ( 2 x. ( ( X + Y ) + Z ) ) = ( ( 2 x. ( X + Y ) ) + ( 2 x. Z ) ) )
b7:b5:oveq1d  |- ( ph -> ( ( 2 x. ( X + Y ) ) + ( 2 x. Z ) ) = ( ( ( 2 x. X ) + ( 2 x. Y ) ) + ( 2 x. Z ) ) )
b8:b6,b7:eqtrd  |- ( ph -> ( 2 x. ( ( X + Y ) + Z ) ) = ( ( ( 2 x. X ) + ( 2 x. Y ) ) + ( 2 x. Z ) ) )
b9:sum:oveq2d  |- ( ph -> ( 2 x. ( ( X + Y ) + Z ) ) = ( 2 x. ( _pi / 3 ) ) )
b10:b9:eqcomd  |- ( ph -> ( 2 x. ( _pi / 3 ) ) = ( 2 x. ( ( X + Y ) + Z ) ) )
b11:b10,b8:eqtrd  |- ( ph -> ( 2 x. ( _pi / 3 ) ) = ( ( ( 2 x. X ) + ( 2 x. Y ) ) + ( 2 x. Z ) ) )
b12:b11:oveq2d  |- ( ph -> ( _i x. ( 2 x. ( _pi / 3 ) ) ) = ( _i x. ( ( ( 2 x. X ) + ( 2 x. Y ) ) + ( 2 x. Z ) ) ) )
b13:b12,b4:eqtrd  |- ( ph -> ( _i x. ( 2 x. ( _pi / 3 ) ) ) = ( ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) + ( _i x. ( 2 x. Z ) ) ) )
b14:b13:fveq2d  |- ( ph -> ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) = ( exp ` ( ( ( _i x. ( 2 x. X ) ) + ( _i x. ( 2 x. Y ) ) ) + ( _i x. ( 2 x. Z ) ) ) ) )
dJ:12:a1i  |- ( ph -> J = ( ( ( exp ` ( _i x. ( 2 x. X ) ) ) x. ( exp ` ( _i x. ( 2 x. Y ) ) ) ) x. ( exp ` ( _i x. ( 2 x. Z ) ) ) ) )
b15:b14,a6:eqtrd  |- ( ph -> ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) = ( ( ( exp ` ( _i x. ( 2 x. X ) ) ) x. ( exp ` ( _i x. ( 2 x. Y ) ) ) ) x. ( exp ` ( _i x. ( 2 x. Z ) ) ) ) )
b16:b15:eqcomd  |- ( ph -> ( ( ( exp ` ( _i x. ( 2 x. X ) ) ) x. ( exp ` ( _i x. ( 2 x. Y ) ) ) ) x. ( exp ` ( _i x. ( 2 x. Z ) ) ) ) = ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) )
cj1:dJ,b16:eqtrd  |- ( ph -> J = ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) )

$( J is a cube root of 1 $)
rpi0::pire  |- _pi e. RR
rpi:rpi0:a1i  |- ( ph -> _pi e. RR )
cpi:rpi:recnd  |- ( ph -> _pi e. CC )
cT3:cpi,c3,n3:divcld  |- ( ph -> ( _pi / 3 ) e. CC )
cT:c2,cT3:mulcld  |- ( ph -> ( 2 x. ( _pi / 3 ) ) e. CC )
ciT:ci,cT:mulcld  |- ( ph -> ( _i x. ( 2 x. ( _pi / 3 ) ) ) e. CC )
z3a::3z  |- 3 e. ZZ
z3:z3a:a1i  |- ( ph -> 3 e. ZZ )
k1::efexp  |- ( ( ( _i x. ( 2 x. ( _pi / 3 ) ) ) e. CC /\ 3 e. ZZ ) -> ( exp ` ( 3 x. ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) ) = ( ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) ^ 3 ) )
k2:ciT,z3,k1:syl2anc  |- ( ph -> ( exp ` ( 3 x. ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) ) = ( ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) ^ 3 ) )
k3:c3,ci,cT:mul12d  |- ( ph -> ( 3 x. ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) = ( _i x. ( 3 x. ( 2 x. ( _pi / 3 ) ) ) ) )
k4:c3,c2,cT3:mul12d  |- ( ph -> ( 3 x. ( 2 x. ( _pi / 3 ) ) ) = ( 2 x. ( 3 x. ( _pi / 3 ) ) ) )
k5:cpi,c3,n3:divcan2d  |- ( ph -> ( 3 x. ( _pi / 3 ) ) = _pi )
k6:k5:oveq2d  |- ( ph -> ( 2 x. ( 3 x. ( _pi / 3 ) ) ) = ( 2 x. _pi ) )
k7:k4,k6:eqtrd  |- ( ph -> ( 3 x. ( 2 x. ( _pi / 3 ) ) ) = ( 2 x. _pi ) )
k8:k7:oveq2d  |- ( ph -> ( _i x. ( 3 x. ( 2 x. ( _pi / 3 ) ) ) ) = ( _i x. ( 2 x. _pi ) ) )
k9:k3,k8:eqtrd  |- ( ph -> ( 3 x. ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) = ( _i x. ( 2 x. _pi ) ) )
k10:k9:fveq2d  |- ( ph -> ( exp ` ( 3 x. ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) ) = ( exp ` ( _i x. ( 2 x. _pi ) ) ) )
k11a::ef2pi  |- ( exp ` ( _i x. ( 2 x. _pi ) ) ) = 1
k11:k11a:a1i  |- ( ph -> ( exp ` ( _i x. ( 2 x. _pi ) ) ) = 1 )
k12:k2:eqcomd  |- ( ph -> ( ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) ^ 3 ) = ( exp ` ( 3 x. ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) ) )
k13:k12,k10,k11:3eqtrd  |- ( ph -> ( ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) ^ 3 ) = 1 )
k14:cj1:oveq1d  |- ( ph -> ( J ^ 3 ) = ( ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) ^ 3 ) )
cube:k14,k13:eqtrd  |- ( ph -> ( J ^ 3 ) = 1 )

$( ... and it is a PRIMITIVE one: its real part is -u ( 1 / 2 ) , not 1 $)
r3a::3re  |- 3 e. RR
r3:r3a:a1i  |- ( ph -> 3 e. RR )
rT3:rpi,r3,n3:redivcld  |- ( ph -> ( _pi / 3 ) e. RR )
m1::cos2t  |- ( ( _pi / 3 ) e. CC -> ( cos ` ( 2 x. ( _pi / 3 ) ) ) = ( ( 2 x. ( ( cos ` ( _pi / 3 ) ) ^ 2 ) ) - 1 ) )
m2:cT3,m1:syl  |- ( ph -> ( cos ` ( 2 x. ( _pi / 3 ) ) ) = ( ( 2 x. ( ( cos ` ( _pi / 3 ) ) ^ 2 ) ) - 1 ) )
m3a::sincos3rdpi  |- ( ( sin ` ( _pi / 3 ) ) = ( ( sqrt ` 3 ) / 2 ) /\ ( cos ` ( _pi / 3 ) ) = ( 1 / 2 ) )
m3b:m3a:simpri  |- ( cos ` ( _pi / 3 ) ) = ( 1 / 2 )
m3:m3b:a1i  |- ( ph -> ( cos ` ( _pi / 3 ) ) = ( 1 / 2 ) )
m4:m3:oveq1d  |- ( ph -> ( ( cos ` ( _pi / 3 ) ) ^ 2 ) = ( ( 1 / 2 ) ^ 2 ) )
m5:m4:oveq2d  |- ( ph -> ( 2 x. ( ( cos ` ( _pi / 3 ) ) ^ 2 ) ) = ( 2 x. ( ( 1 / 2 ) ^ 2 ) ) )
m6:m5:oveq1d  |- ( ph -> ( ( 2 x. ( ( cos ` ( _pi / 3 ) ) ^ 2 ) ) - 1 ) = ( ( 2 x. ( ( 1 / 2 ) ^ 2 ) ) - 1 ) )
m8:m2,m6:eqtrd  |- ( ph -> ( cos ` ( 2 x. ( _pi / 3 ) ) ) = ( ( 2 x. ( ( 1 / 2 ) ^ 2 ) ) - 1 ) )

$( the real and imaginary parts of J $)
rcos:rT3:recoscld  |- ( ph -> ( cos ` ( _pi / 3 ) ) e. RR )
r2::2re  |- 2 e. RR
r2d:r2:a1i  |- ( ph -> 2 e. RR )
rT2:r2d,rT3:remulcld  |- ( ph -> ( 2 x. ( _pi / 3 ) ) e. RR )
rcosT:rT2:recoscld  |- ( ph -> ( cos ` ( 2 x. ( _pi / 3 ) ) ) e. RR )
rsinT:rT2:resincld  |- ( ph -> ( sin ` ( 2 x. ( _pi / 3 ) ) ) e. RR )
ev0::efival  |- ( ( 2 x. ( _pi / 3 ) ) e. CC -> ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) = ( ( cos ` ( 2 x. ( _pi / 3 ) ) ) + ( _i x. ( sin ` ( 2 x. ( _pi / 3 ) ) ) ) ) )
ev:cT,ev0:syl  |- ( ph -> ( exp ` ( _i x. ( 2 x. ( _pi / 3 ) ) ) ) = ( ( cos ` ( 2 x. ( _pi / 3 ) ) ) + ( _i x. ( sin ` ( 2 x. ( _pi / 3 ) ) ) ) ) )
evJ:cj1,ev:eqtrd  |- ( ph -> J = ( ( cos ` ( 2 x. ( _pi / 3 ) ) ) + ( _i x. ( sin ` ( 2 x. ( _pi / 3 ) ) ) ) ) )
re0::crre  |- ( ( ( cos ` ( 2 x. ( _pi / 3 ) ) ) e. RR /\ ( sin ` ( 2 x. ( _pi / 3 ) ) ) e. RR ) -> ( Re ` ( ( cos ` ( 2 x. ( _pi / 3 ) ) ) + ( _i x. ( sin ` ( 2 x. ( _pi / 3 ) ) ) ) ) ) = ( cos ` ( 2 x. ( _pi / 3 ) ) ) )
re1s:rcosT,rsinT,re0:syl2anc  |- ( ph -> ( Re ` ( ( cos ` ( 2 x. ( _pi / 3 ) ) ) + ( _i x. ( sin ` ( 2 x. ( _pi / 3 ) ) ) ) ) ) = ( cos ` ( 2 x. ( _pi / 3 ) ) ) )
re2:evJ:fveq2d  |- ( ph -> ( Re ` J ) = ( Re ` ( ( cos ` ( 2 x. ( _pi / 3 ) ) ) + ( _i x. ( sin ` ( 2 x. ( _pi / 3 ) ) ) ) ) ) )
re3:re2,re1s:eqtrd  |- ( ph -> ( Re ` J ) = ( cos ` ( 2 x. ( _pi / 3 ) ) ) )
re4:re3,m8:eqtrd  |- ( ph -> ( Re ` J ) = ( ( 2 x. ( ( 1 / 2 ) ^ 2 ) ) - 1 ) )

$( -u ( 1 / 2 ) is not 1 , so J is not 1 $)
c1d:5:1cnd  |- ( ph -> 1 e. CC )
n2a::2ne0  |- 2 =/= 0
n2:n2a:a1i  |- ( ph -> 2 =/= 0 )
rha::halfre  |- ( 1 / 2 ) e. RR
rh:rha:a1i  |- ( ph -> ( 1 / 2 ) e. RR )
ch:rh:recnd  |- ( ph -> ( 1 / 2 ) e. CC )
x1:ch:sqvald  |- ( ph -> ( ( 1 / 2 ) ^ 2 ) = ( ( 1 / 2 ) x. ( 1 / 2 ) ) )
x2:x1:oveq2d  |- ( ph -> ( 2 x. ( ( 1 / 2 ) ^ 2 ) ) = ( 2 x. ( ( 1 / 2 ) x. ( 1 / 2 ) ) ) )
x3:c2,ch,ch:mulassd  |- ( ph -> ( ( 2 x. ( 1 / 2 ) ) x. ( 1 / 2 ) ) = ( 2 x. ( ( 1 / 2 ) x. ( 1 / 2 ) ) ) )
x4:x3:eqcomd  |- ( ph -> ( 2 x. ( ( 1 / 2 ) x. ( 1 / 2 ) ) ) = ( ( 2 x. ( 1 / 2 ) ) x. ( 1 / 2 ) ) )
x5:c1d,c2,n2:divcan2d  |- ( ph -> ( 2 x. ( 1 / 2 ) ) = 1 )

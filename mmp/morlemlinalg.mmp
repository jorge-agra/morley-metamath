$( <MM> <PROOF_ASST> THEOREM=morlemlinalg  LOC_AFTER=?
$( The algebraic step of the rotation proof of Morley's theorem, using field
   operations only. Let ` E ` , ` D ` , ` G ` be nonzero complex numbers whose
   product ` J ` is a cube root of unity other than ` 1 ` , and no product of
   two of them equal to ` 1 ` . Let ` R ` , ` P ` , ` Q ` be fixed by the
   composite similarities about ` A ` and ` B ` , about ` B ` and ` C ` , and
   about ` C ` and ` A ` , with factors ` E ` , ` D ` and ` G ` about ` A ` , `
   B ` and ` C ` . If the similarities about ` C ` , ` B ` and ` A ` with the
   cubes of these factors compose to a map fixing ` 0 ` , then ` ( ( P + ( J x.
   Q ) ) + ( ( J ^ 2 ) x. R ) ) = 0 ` . $)

h1::morlemlinalg.a  |- ( ph -> A e. CC )
h2::morlemlinalg.b  |- ( ph -> B e. CC )
h3::morlemlinalg.c  |- ( ph -> C e. CC )
h4::morlemlinalg.p  |- ( ph -> P e. CC )
h5::morlemlinalg.q  |- ( ph -> Q e. CC )
h6::morlemlinalg.r  |- ( ph -> R e. CC )
h7::morlemlinalg.e  |- ( ph -> E e. CC )
h8::morlemlinalg.d  |- ( ph -> D e. CC )
h9::morlemlinalg.g  |- ( ph -> G e. CC )
h10::morlemlinalg.en  |- ( ph -> E =/= 0 )
h11::morlemlinalg.dn  |- ( ph -> D =/= 0 )
h12::morlemlinalg.gn  |- ( ph -> G =/= 0 )
h13::morlemlinalg.j  |- ( ph -> J = ( ( E x. D ) x. G ) )
h14::morlemlinalg.cu  |- ( ph -> ( J ^ 3 ) = 1 )
h15::morlemlinalg.n  |- ( ph -> J =/= 1 )
h16::morlemlinalg.n1  |- ( ph -> ( 1 - ( D x. G ) ) =/= 0 )
h17::morlemlinalg.n2  |- ( ph -> ( 1 - ( G x. E ) ) =/= 0 )
h18::morlemlinalg.n3  |- ( ph -> ( 1 - ( E x. D ) ) =/= 0 )
h19::morlemlinalg.1  |- ( ph -> ( A + ( E x. ( ( B + ( D x. ( R - B ) ) ) - A ) ) ) = R )
h20::morlemlinalg.2  |- ( ph -> ( B + ( D x. ( ( C + ( G x. ( P - C ) ) ) - B ) ) ) = P )
h21::morlemlinalg.3  |- ( ph -> ( C + ( G x. ( ( A + ( E x. ( Q - A ) ) ) - C ) ) ) = Q )
h22::morlemlinalg.4  |- ( ph -> ( A + ( ( E ^ 3 ) x. ( ( B + ( ( D ^ 3 ) x. ( ( C + ( ( G ^ 3 ) x. ( 0 - C ) ) ) - B ) ) ) - A ) ) ) = 0 )



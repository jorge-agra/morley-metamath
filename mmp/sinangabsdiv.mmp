d4:1:sinangdiv  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( sin ` ( A F B ) ) = ( ( Im ` ( B / A ) ) / ( abs ` ( B / A ) ) ) )
d5:d3,d1,d2:absdivd  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( abs ` ( B / A ) ) = ( ( abs ` B ) / ( abs ` A ) ) )
d6:d5:oveq2d  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( ( Im ` ( B / A ) ) / ( abs ` ( B / A ) ) ) = ( ( Im ` ( B / A ) ) / ( ( abs ` B ) / ( abs ` A ) ) ) )
qed:d4,d6:eqtrd  |- ( ( ( A e. CC /\ A =/= 0 ) /\ ( B e. CC /\ B =/= 0 ) ) -> ( sin ` ( A F B ) ) = ( ( Im ` ( B / A ) ) / ( ( abs ` B ) / ( abs ` A ) ) ) )

